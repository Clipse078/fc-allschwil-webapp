{
  "name": "fc-allschwil-webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "next dev --turbopack",
    "build": "prisma generate && npm run db:migrate:deploy-if-enabled && next build --turbopack",
    "db:migrate:deploy-if-enabled": "node -e \"if(process.env.APPLY_DATABASE_MIGRATIONS==='true'){const{execSync}=require('child_process');console.log('[migrate] Running prisma migrate deploy...');execSync('npx prisma migrate deploy',{stdio:'inherit'})}else{console.log('[migrate] Skipped: APPLY_DATABASE_MIGRATIONS not set (set to \\\"true\\\" for STAGE/prod deployments)')}\"",
    "start": "next start",
    "lint": "eslint . --ignore-pattern baseline-backups/**",
    "postinstall": "[ -n \"$DATABASE_URL\" ] && prisma generate || true",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-demo": "tsx prisma/seed-demo.ts",
    "db:bootstrap-admin": "tsx prisma/bootstrap-admin.ts",
    "sync-workspace-permissions": "tsx scripts/sync-workspace-permissions.ts",
    "sync-training-permissions": "tsx scripts/sync-training-permissions.ts",
    "sync-teams-delete-permission": "tsx scripts/sync-teams-delete-permission.ts",
    "check-user-permissions": "tsx scripts/check-user-permissions.ts",
    "stage-cleanup-01:inventory": "tsx scripts/stage-cleanup-01-fca-canonical-data.ts --inventory",
    "stage-cleanup-01:dry-run": "tsx scripts/stage-cleanup-01-fca-canonical-data.ts --dry-run",
    "team-sfv-mapping-01:inventory": "tsx scripts/team-sfv-mapping-01-fca-reconciliation.ts --inventory",
    "team-sfv-mapping-01:dry-run": "tsx scripts/team-sfv-mapping-01-fca-reconciliation.ts --dry-run",
    "team-sfv-mapping-04:dry-run": "tsx scripts/team-sfv-mapping-04-stale-match-reconciliation.ts --dry-run",
    "club-directory-02c:inventory": "tsx scripts/club-directory-02c-sfv-consolidation.ts --inventory",
    "club-directory-02c:dry-run": "tsx scripts/club-directory-02c-sfv-consolidation.ts --dry-run",
    "deploy:check": "npm run db:generate && npm run lint && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@testing-library/dom": "^10.4.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@vercel/blob": "^2.4.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "file-type": "^22.0.1",
    "lucide-react": "^0.542.0",
    "next": "16.0.10",
    "next-auth": "^5.0.0-beta.29",
    "next-intl": "^4.13.2",
    "nodemailer": "^9.0.5",
    "papaparse": "^5.5.3",
    "pg": "^8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.62.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "jsdom": "^29.1.1",
    "prisma": "^7.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
