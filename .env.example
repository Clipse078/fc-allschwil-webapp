# SFV / ClubCorner Integration (Slice 1)
# Server-only — never use NEXT_PUBLIC_ prefix.
# Add actual values to .env.local only. Never commit values.
SFV_TOKEN_URL=
SFV_APPLICATION_KEY=
SFV_APPLICATION_PASS=
SFV_CLUB_ID=

# Infoboard Screen 2 — Weather (INFOBOARD-05)
# Provider: Open-Meteo (https://open-meteo.com) — no API key required.
# Default coordinates: Sportanlage Im Brüel, Allschwil, BL, Switzerland.
# Override only if the facility location changes. Never commit real secrets here.
# WEATHER_LAT=47.5519
# WEATHER_LON=7.5351