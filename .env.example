# Local
APP_ENV=local
APP_BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Auth.js v5 uses AUTH_SECRET (preferred). NEXTAUTH_SECRET is accepted for backwards compat.
AUTH_SECRET=replace-with-a-long-random-secret
# NEXTAUTH_SECRET=replace-with-a-long-random-secret  # legacy alias — use AUTH_SECRET instead
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DIRECT_URL=

# STAGE
# APP_ENV=stage
# APP_BASE_URL=https://your-stage-domain.vercel.app
# NEXTAUTH_URL=https://your-stage-domain.vercel.app
# AUTH_SECRET=replace-with-a-long-random-secret
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# DIRECT_URL=

