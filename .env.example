# Local
APP_ENV=local
APP_BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DIRECT_URL=

# STAGE
# APP_ENV=stage
# APP_BASE_URL=https://your-stage-domain.vercel.app
# NEXTAUTH_URL=https://your-stage-domain.vercel.app
# NEXTAUTH_SECRET=replace-with-a-long-random-secret
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# DIRECT_URL=

# PROD
# APP_ENV=prod
# APP_BASE_URL=https://clubmanager.fcallschwil.ch
# NEXTAUTH_URL=https://clubmanager.fcallschwil.ch
# NEXTAUTH_SECRET=replace-with-a-long-random-secret
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# DIRECT_URL=

# SFV / ClubCorner Integration (Slice 1)
# Server-only — never use NEXT_PUBLIC_ prefix.
# Add actual values to .env.local only. Never commit values.
SFV_TOKEN_URL=
SFV_APPLICATION_KEY=
SFV_APPLICATION_PASS=
SFV_CLUB_ID=

# SFV automatic sync (SFV-MATCH-SYNC-HOTFIX-01, Phase B)
# Required for /api/cron/sfv-sync (Vercel Cron, see vercel.json "crons").
# Vercel automatically sends this value as `Authorization: Bearer <CRON_SECRET>`
# on scheduled invocations when this env var is set on the project. The route
# rejects every request when CRON_SECRET is not configured (fail closed).
# Server-only — never use NEXT_PUBLIC_ prefix.
CRON_SECRET=

# Infoboard Screen 2 — Weather (WEATHER-01)
# Active provider: MeteoSwiss Open Data (SwissMetNet VQHA80)
#
# MeteoSwiss Open Data is used without restriction under the Swiss OGD licence.
# Attribution "Quelle: MeteoSwiss" is rendered in the UI when data is shown.
# No API key or paid subscription is required for the active MeteoSwiss provider.
# Data is fetched from the official FSDI endpoint (data.geo.admin.ch).
# Station: BAS (Basel/Binningen), ≈3.8 km from Sportanlage Im Brüel, Allschwil.
# Source documentation: https://opendatadocs.meteoswiss.ch/
#
# No weather-specific environment variables are required for the MeteoSwiss provider.
# The endpoint URL and station code are hardcoded in the server-side provider.
#
# ── DORMANT: Open-Meteo legacy provider ──────────────────────────────────────
# Open-Meteo is preserved as a dormant fallback implementation.
# It cannot activate without WEATHER_API_KEY AND an explicit change to
# ACTIVE_PROVIDER in lib/weather/weather-service.ts.
# Do NOT set WEATHER_API_KEY for FC Allschwil (MeteoSwiss is active).
#
# To switch to Open-Meteo (future):
#   1. Subscribe at https://open-meteo.com/en/pricing (API Standard or higher).
#   2. Set WEATHER_API_KEY to the issued API key (server-side only, never commit).
#   3. Change ACTIVE_PROVIDER in lib/weather/weather-service.ts to "open-meteo".
#   4. Update the attribution in InfoboardScreen2.tsx to "Wetterdaten: Open-Meteo.com".
#
# WEATHER_API_KEY=
# USER-ADMIN-01 — Outbound email (SMTP) for password reset
# Required for the "Passwort vergessen?" flow to deliver reset links.
# When SMTP_HOST is absent the mailer logs to stdout (dev / CI mode).
#
# Compatible with any standard SMTP relay (Resend, SendGrid, Postmark,
# AWS SES, or a self-hosted Postfix/Exim relay).
#
# Resend (recommended for new setups):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # Resend API key
#
# SendGrid:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASS=SG.xxxxxxx
#
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address shown in the From field of outbound emails.
EMAIL_FROM="SportClubEvo <noreply@yourdomain.com>"
