# Local
APP_ENV=local
APP_BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Either AUTH_SECRET or NEXTAUTH_SECRET is accepted (NextAuth v5).
NEXTAUTH_SECRET=replace-with-a-long-random-secret
# AUTH_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DIRECT_URL=

# STAGE
# Canonical Vercel project: sportclubevo-webapp-stage
# Production Branch = STAGE
# Enable each of these for Production AND Preview AND Development.
# APP_ENV=stage
# APP_BASE_URL=https://your-stage-domain.vercel.app
# NEXTAUTH_URL=https://your-stage-domain.vercel.app
# NEXTAUTH_SECRET=replace-with-a-long-random-secret
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# DIRECT_URL=

