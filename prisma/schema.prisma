generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PermissionModule {
  USERS
  SEASONS
  TEAMS
  PEOPLE
  EVENTS
  FIXTURES
  WOCHENPLAN
  NEWS
  WEBSITE
  INFOBOARD
  FUNCTIONS
  MEETINGS
  INITIATIVES
  TARGETS
}

enum TeamCategory {
  KINDERFUSSBALL
  JUNIOREN
  AKTIVE
  FRAUEN
  SENIOREN
  TRAININGSGRUPPE
}

enum TeamSeasonStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PlayerSquadStatus {
  ACTIVE
  INACTIVE
  INJURED
  ABSENT
  ARCHIVED
}

enum TrainerTeamStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum EventType {
  MATCH
  TOURNAMENT
  TRAINING
  OTHER
  VACATION_PERIOD
}

enum EventSource {
  CLUBCORNER_FVNWS
  MANUAL
  CSV_EXCEL_IMPORT
  MUNICIPALITY_API
}

enum EventStatus {
  DRAFT
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
  POSTPONED
  ARCHIVED
}

enum EventImportRunStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum ReviewWorkflowStage {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PUBLISHED
}

enum WorkflowDomain {
  EVENTS
  SEASONS
  TEAMS
  PEOPLE
  USERS
  IMPORTS
  WEBSITE
  NEWS
  INFOBOARD
  WOCHENPLAN
  FIXTURES
  FUNCTIONS
  SESSION_SECURITY
}

enum WorkflowAction {
  CREATE
  UPDATE
  DELETE
  REVIEW
  APPROVE
  REJECT
  PUBLISH
  IMPORT
}

// ─── Meetings Module ──────────────────────────────────────────────────────────

enum MeetingStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MeetingParticipantRole {
  CHAIR // Sitzungsleitung / Vorsitz
  SECRETARY // Protokollführung
  MEMBER // Regulärer Teilnehmer
  GUEST // Gast
  OBSERVER // Beobachter (ohne Stimmrecht)
}

enum MeetingActionStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

// ─── Initiatives Module ───────────────────────────────────────────────────────

enum InitiativeStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum InitiativePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InitiativeTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

// ─── Targets Module ───────────────────────────────────────────────────────────

enum TargetStatus {
  DRAFT
  ACTIVE
  PAUSED
  ACHIEVED
  MISSED
  CANCELLED
}

enum TargetMetricType {
  NUMBER // absolute count    e.g. "3 women's teams"
  PERCENTAGE // 0–100 %           e.g. "50% technique training time"
  CURRENCY // monetary value    e.g. "CHF 25k sponsoring growth"
  BOOLEAN // achieved or not   e.g. "Launch new website"
  RATIO // rate per period   e.g. "2 news posts/month"
  SCORE // qualitative 1–10  e.g. "Coach satisfaction score"
}

enum TargetPeriodType {
  ONCE // single milestone (no recurrence)
  WEEKLY
  MONTHLY
  QUARTERLY
  SEASONAL // aligned to sports season
  ANNUAL
  MULTI_YEAR // e.g. "3 more women's teams in 4 years"
}

enum TargetDirection {
  INCREASE // higher is better  e.g. attendance, members
  DECREASE // lower is better   e.g. dropout rate
  MAINTAIN // stay within range e.g. budget within 5%
  ACHIEVE // binary: hit or miss (used with BOOLEAN metrics)
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  userRoles           UserRole[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  meetingParticipants MeetingParticipant[]

  @@index([isActive])
}

model Role {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?

  // TODO(decoupling — Organisation Builder):
  // These two fields hardcode "Vereinsleitung" as a fixed permission concept.
  // Target architecture: access and participation flags should reference org units
  // dynamically (e.g. via a RoleOrgUnitAccess join table), not be baked into Role.
  //
  // Proposed future model:
  //   canAccessVereinsleitung        → removed; replaced by OrgUnitAccess(orgUnitId, roleId)
  //   canAttendVereinsleitungMeetings → removed; replaced by MeetingParticipantRule(orgUnitId, roleId)
  //
  // Migration required (DO NOT rename until Organisation Builder sprint):
  //   prisma migrate dev --name decouple_vereinsleitung_from_role
  canAccessVereinsleitung         Boolean @default(false)
  canAttendVereinsleitungMeetings Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles                 UserRole[]
  rolePermissions           RolePermission[]
  workflowRules             RoleWorkflowRule[]
  workflowReviewAssignments RoleWorkflowReviewAssignment[] @relation("WorkflowReviewerRole")

  @@index([name])
  @@index([canAccessVereinsleitung])
  @@index([canAttendVereinsleitungMeetings])
}

model Permission {
  id        String           @id @default(cuid())
  key       String           @unique
  name      String
  module    PermissionModule
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  rolePermissions RolePermission[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model RoleWorkflowRule {
  id                 String         @id @default(cuid())
  roleId             String
  domain             WorkflowDomain
  action             WorkflowAction
  requiresReview     Boolean        @default(true)
  allowsDirectManage Boolean        @default(false)
  allowsReview       Boolean        @default(false)
  allowsApprove      Boolean        @default(false)
  allowsPublish      Boolean        @default(false)
  allowsSeriesReview Boolean        @default(false)
  isActive           Boolean        @default(true)
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  role              Role                           @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reviewAssignments RoleWorkflowReviewAssignment[]

  @@unique([roleId, domain, action])
  @@index([domain, action])
  @@index([isActive])
}

model RoleWorkflowReviewAssignment {
  id             String   @id @default(cuid())
  workflowRuleId String
  reviewerRoleId String
  isRequired     Boolean  @default(true)
  sortOrder      Int      @default(0)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workflowRule RoleWorkflowRule @relation(fields: [workflowRuleId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "RoleWorkflowReviewAssignment_workflowRuleId_fkey")
  reviewerRole Role             @relation("WorkflowReviewerRole", fields: [reviewerRoleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([workflowRuleId, reviewerRoleId])
  @@index([reviewerRoleId])
  @@index([sortOrder])
}

model Season {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamSeasons     TeamSeason[]
  events          Event[]
  eventImportRuns EventImportRun[]
  meetings        Meeting[]
  initiatives     Initiative[]
  targets         Target[]

  @@index([isActive])
}

model Person {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  displayName String?
  email       String?
  phone       String?
  dateOfBirth DateTime?
  notes       String?
  isActive    Boolean   @default(true)
  isPlayer    Boolean   @default(false)
  isTrainer   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  playerSquadMembers  PlayerSquadMember[]
  trainerTeamMembers  TrainerTeamMember[]
  meetingParticipants MeetingParticipant[]

  @@index([lastName, firstName])
  @@index([email])
  @@index([isActive])
  @@index([isPlayer])
  @@index([isTrainer])
}

model Team {
  id               String       @id @default(cuid())
  name             String
  slug             String       @unique
  category         TeamCategory
  genderGroup      String?
  ageGroup         String?
  sortOrder        Int          @default(0)
  isActive         Boolean      @default(true)
  websiteVisible   Boolean      @default(true)
  infoboardVisible Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  teamSeasons     TeamSeason[]
  events          Event[]
  eventImportRuns EventImportRun[]
  meetings        Meeting[]
  initiatives     Initiative[]
  targets         Target[]

  @@index([category, sortOrder])
  @@index([isActive])
}

model TeamSeason {
  id                        String           @id @default(cuid())
  teamId                    String
  seasonId                  String
  displayName               String
  shortName                 String?
  status                    TeamSeasonStatus @default(ACTIVE)
  websiteVisible            Boolean          @default(true)
  infoboardVisible          Boolean          @default(true)
  squadWebsiteVisible       Boolean          @default(true)
  trainerTeamWebsiteVisible Boolean          @default(true)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  team               Team                @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  season             Season              @relation(fields: [seasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  playerSquadMembers PlayerSquadMember[]
  trainerTeamMembers TrainerTeamMember[]

  @@unique([teamId, seasonId])
  @@index([seasonId])
  @@index([status])
  @@index([squadWebsiteVisible])
  @@index([trainerTeamWebsiteVisible])
}

model PlayerSquadMember {
  id               String            @id @default(cuid())
  teamSeasonId     String
  personId         String
  status           PlayerSquadStatus @default(ACTIVE)
  shirtNumber      Int?
  positionLabel    String?
  isCaptain        Boolean           @default(false)
  isViceCaptain    Boolean           @default(false)
  isWebsiteVisible Boolean           @default(true)
  sortOrder        Int               @default(0)
  remarks          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  teamSeason TeamSeason @relation(fields: [teamSeasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  person     Person     @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([teamSeasonId, personId])
  @@index([personId])
  @@index([teamSeasonId, status])
  @@index([teamSeasonId, isWebsiteVisible])
  @@index([teamSeasonId, sortOrder])
}

model TrainerTeamMember {
  id               String            @id @default(cuid())
  teamSeasonId     String
  personId         String
  status           TrainerTeamStatus @default(ACTIVE)
  roleLabel        String?
  isWebsiteVisible Boolean           @default(true)
  sortOrder        Int               @default(0)
  remarks          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  teamSeason TeamSeason @relation(fields: [teamSeasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  person     Person     @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([teamSeasonId, personId])
  @@index([personId])
  @@index([teamSeasonId, status])
  @@index([teamSeasonId, isWebsiteVisible])
  @@index([teamSeasonId, sortOrder])
}

model Event {
  id       String      @id @default(cuid())
  seasonId String
  teamId   String?
  type     EventType
  source   EventSource
  status   EventStatus @default(SCHEDULED)

  reviewStage       ReviewWorkflowStage @default(DRAFT)
  reviewRequestedAt DateTime?
  reviewedAt        DateTime?
  publishedAt       DateTime?
  reviewNotes       String?
  createdByUserId   String?
  reviewedByUserId  String?
  approvedByUserId  String?
  rejectedByUserId  String?
  publishedByUserId String?

  title       String
  description String?
  location    String?

  startAt DateTime
  endAt   DateTime?

  externalSource   String?
  externalSourceId String?
  importBatchKey   String?
  lastSyncedAt     DateTime?

  opponentName     String?
  organizerName    String?
  competitionLabel String?
  homeAway         String?
  resultLabel      String?
  meetingTime      DateTime?

  websiteVisible       Boolean @default(true)
  infoboardVisible     Boolean @default(false)
  homepageVisible      Boolean @default(false)
  wochenplanVisible    Boolean @default(false)
  trainingsplanVisible Boolean @default(false)
  teamPageVisible      Boolean @default(false)

  sortOrder Int     @default(0)
  remarks   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  team   Team?  @relation(fields: [teamId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([seasonId, type])
  @@index([teamId, type])
  @@index([startAt])
  @@index([status])
  @@index([source])
  @@index([reviewStage])
  @@index([reviewRequestedAt])
  @@index([publishedAt])
  @@index([websiteVisible])
  @@index([infoboardVisible])
  @@index([wochenplanVisible])
  @@index([trainingsplanVisible])
  @@index([teamPageVisible])
  @@index([externalSource, externalSourceId])
  @@index([importBatchKey])
}

model EventImportRun {
  id       String               @id @default(cuid())
  source   EventSource
  status   EventImportRunStatus @default(PENDING)
  type     EventType?
  seasonId String?
  teamId   String?

  importBatchKey String    @unique
  fileName       String?
  startedAt      DateTime?
  finishedAt     DateTime?

  rowsDetected Int @default(0)
  rowsCreated  Int @default(0)
  rowsUpdated  Int @default(0)
  rowsSkipped  Int @default(0)
  rowsFailed   Int @default(0)

  summary      String?
  errorMessage String?
  metadataJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([source, status])
  @@index([type])
  @@index([seasonId])
  @@index([teamId])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  moduleKey    String
  entityType   String
  entityId     String
  action       String
  beforeJson   Json?
  afterJson    Json?
  metadataJson Json?
  createdAt    DateTime @default(now())

  actorUser User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([moduleKey])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Meetings Module
//
// Standalone, org-unit-agnostic meeting management.
//
// A Meeting can belong to a Season, a Team, or an OrgUnit (described via
// orgUnitLabel until the Organisation Builder adds a real OrgUnit model).
// None of these ownership fields are required — meetings are self-contained.
//
// tenantSlug is a single-tenant placeholder. When multi-tenancy is added via
// the Organisation Builder, this will become a proper FK to a Tenant model.
//
// TODO(decoupling): When OrgUnit model exists, add:
//   orgUnitId String?
//   orgUnit   OrgUnit? @relation(...)
// and migrate orgUnitLabel values to orgUnitId references.
//
// TODO(governance — Module Admin Config sprint):
// The following governance capabilities are planned but not yet implemented.
// They will be added when the Organisation Builder provides supporting models.
//
//   1. REVIEW / FOUR-EYE WORKFLOW:
//      reviewStage         ReviewWorkflowStage @default(DRAFT)   -- reuse existing enum
//      reviewNotes         String?
//      reviewedByUserId    String?
//      approvedByUserId    String?
//      requiresFourEyeReview Boolean @default(false)            -- admin-configurable
//
//   2. ACCESS CONTROL:
//      isPublicToTenant  Boolean @default(false)                 -- all roles can view
//      accessPolicyId    String?                                 -- FK to AccessPolicy
//      restrictToOrgUnitId String?                              -- per-org-unit gate
//
//   3. MODULE NUDGES:
//      Computed in the UI layer (e.g. "Meeting has no agenda items").
//      No schema fields needed — derived from _count of related records.
//
//   Pattern ref: RoleWorkflowRule model + lib/workflow/review-policy.ts
// ─────────────────────────────────────────────────────────────────────────────

model Meeting {
  id String @id @default(cuid())

  /// Single-tenant placeholder. Becomes a FK to Tenant when multi-tenancy is added.
  tenantSlug String @default("fc-allschwil")

  // Flexible ownership — all optional. A meeting exists independently of any
  // season, team, or org unit.
  seasonId     String?
  teamId       String?
  /// Free-text org unit label (e.g. "Vereinsleitung", "Vorstand") until
  /// the Organisation Builder provides a real OrgUnit FK.
  orgUnitLabel String?

  title            String
  description      String?
  location         String?
  onlineMeetingUrl String?

  status      MeetingStatus @default(DRAFT)
  scheduledAt DateTime
  startedAt   DateTime?
  endedAt     DateTime?

  /// Free-text meeting minutes / protocol. Rich text support can be added later.
  minutesBody String?

  // Audit — string references (no FK) consistent with Event model pattern.
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  season Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  agendaItems  MeetingAgendaItem[]
  participants MeetingParticipant[]
  decisions    MeetingDecision[]
  actions      MeetingAction[]

  @@index([tenantSlug, scheduledAt])
  @@index([tenantSlug, status])
  @@index([seasonId])
  @@index([teamId])
  @@index([orgUnitLabel])
  @@index([status])
  @@index([scheduledAt])
}

model MeetingAgendaItem {
  id          String   @id @default(cuid())
  meetingId   String
  sortOrder   Int      @default(0)
  title       String
  body        String?
  /// Estimated duration in minutes.
  durationMin Int?
  /// Free-text presenter name.
  presenter   String?
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([meetingId, sortOrder])
}

model MeetingParticipant {
  id        String @id @default(cuid())
  meetingId String

  // At least one of userId, personId, or displayName identifies the participant.
  // userId and personId are optional — a participant may be an external guest with
  // no platform account or Person profile.
  userId      String?
  personId    String?
  /// Always populated (denormalized) so the meeting can be displayed without joins.
  displayName String

  role        MeetingParticipantRole @default(MEMBER)
  /// null = attendance not recorded; true = attended; false = absent/excused.
  attended    Boolean?
  apologyNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  person  Person? @relation(fields: [personId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([meetingId, role])
  @@index([meetingId, attended])
  @@index([userId])
  @@index([personId])
}

model MeetingDecision {
  id        String    @id @default(cuid())
  meetingId String
  sortOrder Int       @default(0)
  title     String
  body      String?
  decidedAt DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([meetingId, sortOrder])
}

model MeetingAction {
  id          String  @id @default(cuid())
  meetingId   String
  sortOrder   Int     @default(0)
  title       String
  description String?

  // Assignee — free text or optional FK references.
  // assignedUserId and assignedPersonId are intentionally NOT declared as @relation
  // to avoid adding back-relations to User/Person for this secondary reference.
  // They can be promoted to proper FK relations in a future migration if needed.
  assignedTo       String?
  assignedUserId   String?
  assignedPersonId String?

  dueDate     DateTime?
  status      MeetingActionStatus @default(OPEN)
  completedAt DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([meetingId, sortOrder])
  @@index([meetingId, status])
  @@index([assignedUserId])
  @@index([dueDate, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Initiatives Module
//
// Standalone, org-unit-agnostic initiative / project tracking.
//
// Mirrors the Meetings module ownership pattern: tenantSlug placeholder,
// optional Season/Team/OrgUnit references, no Vereinsleitung coupling.
//
// TODO(decoupling): When OrgUnit model exists, add orgUnitId String? + @relation.
// TODO(governance — Module Admin Config sprint):
//   Same governance capabilities as Meetings (review workflow, access control,
//   module nudges) — see Meetings module TODO block above for the full roadmap.
//   Planned additions:
//     reviewStage           ReviewWorkflowStage @default(DRAFT)
//     requiresFourEyeReview Boolean @default(false)
//     reviewedByUserId      String?
//     approvedByUserId      String?
//     accessPolicyId        String?
//     isPublicToTenant      Boolean @default(false)
// ─────────────────────────────────────────────────────────────────────────────

model Initiative {
  id String @id @default(cuid())

  /// Single-tenant placeholder. Becomes a FK to Tenant when multi-tenancy is added.
  tenantSlug String @default("fc-allschwil")

  // Flexible ownership — all optional. An initiative exists independently of
  // any season, team, or org unit.
  seasonId     String?
  teamId       String?
  /// Free-text org unit label until Organisation Builder provides a real OrgUnit FK.
  orgUnitLabel String?

  title       String
  /// One-liner for list views and cards.
  summary     String?
  description String?

  status   InitiativeStatus   @default(DRAFT)
  priority InitiativePriority @default(MEDIUM)

  startsAt    DateTime?
  dueDate     DateTime?
  completedAt DateTime?

  // Owner — free-text + optional FK references (same pattern as MeetingAction assignee).
  // ownerUserId / ownerPersonId are intentionally NOT declared as @relation to avoid
  // adding back-relations to User/Person. Promote to FK in a future migration if needed.
  ownerName     String?
  ownerUserId   String?
  ownerPersonId String?

  // Audit — string references (no FK) consistent with Event + Meeting pattern.
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  season Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  tasks      InitiativeTask[]
  milestones InitiativeMilestone[]

  @@index([tenantSlug, status])
  @@index([tenantSlug, priority])
  @@index([tenantSlug, dueDate])
  @@index([tenantSlug, status, priority])
  @@index([seasonId])
  @@index([teamId])
  @@index([orgUnitLabel])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
}

model InitiativeTask {
  id           String  @id @default(cuid())
  initiativeId String
  sortOrder    Int     @default(0)
  title        String
  description  String?

  // Assignee — free text or optional FK references (same pattern as MeetingAction).
  assignedTo       String?
  assignedUserId   String?
  assignedPersonId String?

  dueDate     DateTime?
  status      InitiativeTaskStatus @default(OPEN)
  completedAt DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  initiative Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([initiativeId, sortOrder])
  @@index([initiativeId, status])
  @@index([dueDate, status])
  @@index([assignedUserId])
}

model InitiativeMilestone {
  id           String    @id @default(cuid())
  initiativeId String
  sortOrder    Int       @default(0)
  title        String
  description  String?
  dueDate      DateTime?
  completedAt  DateTime?
  isCompleted  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  initiative Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([initiativeId, sortOrder])
  @@index([dueDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// Targets Module
//
// Standalone, reusable strategic target / goal tracking for any org unit.
// Replaces the legacy static KPI page at /vereinsleitung/kpis.
//
// A Target describes a measurable goal. It may have multiple TargetMetrics
// (the actual measurements) and each metric accumulates TargetDataPoints
// (the time-series readings).
//
// Ownership follows the same pattern as Meetings + Initiatives:
//   tenantSlug placeholder, optional Season/Team/OrgUnit.
//
// ─── STRATEGY NUDGING ARCHITECTURE ──────────────────────────────────────────
//
// The Targets module is designed to become SportClubEvo's intelligent
// "guidance engine" — helping clubs set meaningful, realistic goals based on
// sport category, age group, module context, and platform benchmarks.
//
// Nudging system components (to be built in future sprints):
//
//   1. TARGET TEMPLATE CATALOG (TargetTemplate model, future sprint):
//      Predefined target blueprints curated by SportClubEvo:
//        - "E-Junioren: 40–60% technique training time per season"
//        - "Media team: ≥ 2 news posts/month"
//        - "Women's football: +1 team per 3-year cycle"
//        - "Sponsor revenue: +5–15% YoY"
//        - "Match attendance: +20% vs previous season"
//        - "Volunteer roles: ≤ 3 open positions at any time"
//        - "Trainer education: all A-licence within 2 seasons"
//        Templates filtered by: sportCategory, ageGroupHint, targetCategory, moduleKey.
//
//   2. RANGE RECOMMENDATIONS:
//      recommendedRangeMin / recommendedRangeMax on Target — system-suggested
//      achievable range. Admin or AI sets these; shown in the UI as a guide.
//      Example: "Swiss football avg attendance growth is 8–22% per season."
//
//   3. CONFIDENCE SCORING (recommendationConfidence 0.0–1.0):
//      How confident the system is in its suggestion, based on:
//        - historical data for similar clubs
//        - benchmark source quality
//        - amount of available club data
//      Shown as an indicator: "High confidence" / "Estimate" / "Exploratory".
//
//   4. MODULE LINKAGE (moduleKey):
//      Targets can be linked to platform modules:
//        training_planner → technique %, drill frequency, session length
//        events           → match count, attendance %, postponements
//        media            → news posts, social reach, video content
//        sponsoring       → CHF revenue, sponsor retention, new sponsors
//        attendance       → match attendance, training attendance
//        finance          → budget variance, cost per member
//        volunteers       → open roles, average tenure
//        facilities       → pitch utilisation %, room booking rate
//      The moduleKey enables cross-module nudges:
//        "Training attendance is below target → suggest reviewing event schedule"
//
//   5. ADMIN-CONTROLLED ENABLE/DISABLE:
//      A future ModuleNudgeConfig model will let admins:
//        - enable/disable nudge categories per tenant
//        - override suggested ranges with club-specific values
//        - mark certain templates as "irrelevant for our club"
//
//   6. COUNTRY / TENANT DIFFERENCES:
//      benchmarkSource and future TenantConfig fields will allow:
//        - Swiss football federation benchmarks
//        - Regional league averages
//        - Peer club comparisons (opt-in)
//
//   7. FUTURE AI INTEGRATION PATH:
//      suggestedBySystem = true + recommendationConfidence set by an external
//      inference service. The schema is AI-ready without requiring AI today.
//      The platform starts with curated templates and static benchmarks,
//      then progressively upgrades to ML-based suggestions.
//
//   Sport-category-specific nudge examples (not exhaustive):
//     football / Kinderfussball:
//       - Fun > results: match ratio ≤ 50%, emphasis on development
//       - Minimum 2 trainers per team
//     football / Junioren:
//       - B-licence trainer within 1 season
//       - 60%+ attendance at regional league games
//     football / Frauen:
//       - Growth targets tied to women's football expansion roadmap
//       - Minimum 2 training sessions/week
//     football / Aktive:
//       - League promotion/maintenance goals
//       - Average attendance benchmarks vs division averages
//     football / Senioren:
//       - Participation over performance; social KPIs important
//
// ─── GOVERNANCE TODO BLOCK ───────────────────────────────────────────────────
//
// TODO(governance — Module Admin Config sprint):
//   reviewStage           ReviewWorkflowStage @default(DRAFT)
//   reviewNotes           String?
//   reviewedByUserId      String?
//   approvedByUserId      String?
//   requiresFourEyeReview Boolean @default(false)
//   accessPolicyId        String?
//   isPublicToTenant      Boolean @default(false)
//   restrictToOrgUnitId   String?
//   nudgeConfigId         String?  — FK to future TargetNudgeConfig
//
// TODO(decoupling): When OrgUnit model exists, add orgUnitId String? + @relation.
// ─────────────────────────────────────────────────────────────────────────────

model Target {
  id String @id @default(cuid())

  /// Single-tenant placeholder. Becomes a FK to Tenant when multi-tenancy is added.
  tenantSlug String @default("fc-allschwil")

  // Flexible ownership — all optional.
  seasonId     String?
  teamId       String?
  /// Free-text org unit label until Organisation Builder provides a real OrgUnit FK.
  orgUnitLabel String?

  /// Links to a platform module (e.g. "training_planner", "media", "sponsoring").
  /// Enables module-specific nudges and cross-module correlation.
  moduleKey String?

  title       String
  description String?

  status TargetStatus @default(DRAFT)

  // What is being measured
  metricType  TargetMetricType?
  direction   TargetDirection?
  /// The goal value (interpreted per metricType: count / % / CHF / score).
  targetValue Float?
  /// Human-readable unit label. Examples: "teams", "%", "CHF", "posts/month", "pts".
  unit        String?

  // Time frame
  periodType TargetPeriodType?
  startsAt   DateTime?
  endsAt     DateTime?

  // ── Category hints (for nudging engine) ───────────────────────────────────
  // These fields enable the platform to filter template suggestions and
  // apply sport/age-specific benchmarks without requiring a taxonomy model.

  /// Broad goal category — drives template filtering and nudge routing.
  /// Examples: "youth_development", "women_football", "media", "sponsoring",
  ///   "attendance", "finance", "trainer_education", "volunteer_participation",
  ///   "facility_usage", "operational_efficiency"
  targetCategory String?

  /// Sport type hint. Primarily "football" for FC Allschwil; future: "futsal", "general".
  sportCategory String?

  /// Age / team group hint for sport-specific benchmarks.
  /// Mirrors TeamCategory values: "Kinderfussball" | "Junioren" | "Frauen" |
  /// "Aktive" | "Senioren" | "Trainingsgruppe"
  ageGroupHint String?

  // ── Strategy nudging system fields ────────────────────────────────────────
  // These lightweight fields make the Target schema AI/nudge-ready from day one.
  // The recommendation engine can be wired in later without a schema migration.

  /// Key of the TargetTemplate this was created from (future TargetTemplate catalog).
  suggestedTemplateKey String?

  /// true when this target was suggested by the system (template or AI), not manually created.
  suggestedBySystem Boolean @default(false)

  /// Lower bound of the system-suggested achievement range for this metric + context.
  recommendedRangeMin Float?

  /// Upper bound of the system-suggested achievement range.
  recommendedRangeMax Float?

  /// System confidence in the recommendation (0.0 = exploratory, 1.0 = high confidence).
  /// Shown in UI as: "High confidence" / "Estimate" / "Exploratory".
  recommendationConfidence Float?

  /// Source of the benchmark behind the range suggestion.
  /// Examples: "swiss_football_avg", "regional_league_b", "internal_historical", "peer_clubs"
  benchmarkSource String?

  // Audit — consistent with Meeting + Initiative pattern.
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  season Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  metrics TargetMetric[]

  @@index([tenantSlug, status])
  @@index([tenantSlug, moduleKey])
  @@index([tenantSlug, endsAt])
  @@index([tenantSlug, targetCategory])
  @@index([seasonId])
  @@index([teamId])
  @@index([orgUnitLabel])
  @@index([status])
  @@index([moduleKey])
  @@index([suggestedBySystem])
}

model TargetMetric {
  id        String @id @default(cuid())
  targetId  String
  sortOrder Int    @default(0)

  /// Human-readable measurement label.
  /// Examples: "Number of women's teams", "Technique training %", "YoY CHF growth"
  label String

  metricType TargetMetricType
  direction  TargetDirection  @default(INCREASE)

  /// Goal value for this specific metric.
  targetValue Float?

  /// Most recent reading — denormalized for fast list rendering.
  /// Updated whenever a new TargetDataPoint is recorded.
  currentValue Float?

  /// Human-readable unit (e.g. "teams", "%", "CHF", "posts/month").
  unit String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  target     Target            @relation(fields: [targetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  dataPoints TargetDataPoint[]

  @@index([targetId, sortOrder])
  @@index([targetId, metricType])
}

model TargetDataPoint {
  id             String @id @default(cuid())
  targetMetricId String

  value      Float
  measuredAt DateTime

  notes String?

  /// Who recorded this reading — string (no FK) consistent with Event/Meeting pattern.
  recordedByUserId String?

  createdAt DateTime @default(now())

  targetMetric TargetMetric @relation(fields: [targetMetricId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([targetMetricId, measuredAt])
  @@index([measuredAt])
}
