// ---------------------------------------------------------------------------
// Initiative — Visibility / Governance
//
// Visibility is implemented: VisibilityScope (ORGANISATION / RESTRICTED / PRIVATE)
// enforced by canSeeEntity() in lib/visibility/visibility-filter.ts.
// ActorContext is hydrated with orgUnitIds via getActorContext().
//
// Roadmap:
//   - visibleTeamRefs / visiblePersonRefs: requires teamIds / personId on ActorContext
//   - PRIVATE non-creator allowlist: DB WHERE needs JSONB @> (Phase 2)
//   - Reviewer role validation via RoleWorkflowReviewAssignment (Phase 2)
// ---------------------------------------------------------------------------
model Initiative {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  summary     String?
  description String?
  status      InitiativeStatus @default(PLANNED)
  owner       String?
  progress    Int?
  dueDate     DateTime?

  // Governance — consistent with Meeting and Target governance pattern
  reviewStage           ReviewWorkflowStage @default(DRAFT)
  requiresFourEyeReview Boolean             @default(false)
  reviewedByUserId      String?
  reviewedAt            DateTime?

  // Visibility / access control
  visibilityScope        VisibilityScope @default(ORGANISATION)
  createdByUserId        String?
  visibleRoleRefs        Json?
  visibleUserRefs        Json?
  visibleTeamRefs        Json?
  visibleOrgUnitRefs     Json?
  visiblePersonRefs      Json?
  // Phase D — TargetGroup visibility: resolved target group members can see this entity.
  visibleTargetGroupRefs Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([reviewStage])
  @@index([dueDate])
  @@index([visibilityScope])
}

// ---------------------------------------------------------------------------
// Meeting — Visibility / Governance
//
// Visibility is implemented: VisibilityScope (ORGANISATION / RESTRICTED / PRIVATE)
// enforced by canSeeEntity() in lib/visibility/visibility-filter.ts.
// RESTRICTED allowlist includes org units, roles, and users.
//
// Roadmap:
//   - visibleTeamRefs / visiblePersonRefs: requires teamIds / personId on ActorContext
//   - PRIVATE non-creator allowlist: DB WHERE needs JSONB @> (Phase 2)
//   - Reviewer role validation via RoleWorkflowReviewAssignment (Phase 2)
// ---------------------------------------------------------------------------
model Meeting {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  description   String?
  meetingDate   DateTime
  location      String?
  attendeeCount Int?
  status        MeetingStatus @default(PLANNED)

  // Governance — consistent with Target governance pattern
  reviewStage           ReviewWorkflowStage @default(DRAFT)
  requiresFourEyeReview Boolean             @default(false)
  reviewedByUserId      String?
  reviewedAt            DateTime?

  // Visibility / access control
  visibilityScope        VisibilityScope @default(ORGANISATION)
  createdByUserId        String?
  // String[] stored as JSON — role keys, user IDs, team IDs, org unit IDs, person IDs, target group IDs
  visibleRoleRefs        Json?
  visibleUserRefs        Json?
  visibleTeamRefs        Json?
  visibleOrgUnitRefs     Json?
  visiblePersonRefs      Json?
  // Phase D — TargetGroup visibility: resolved target group members can see this entity.
  visibleTargetGroupRefs Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agendaItems  MeetingAgendaItem[]
  decisions    MeetingDecision[]
  actions      MeetingAction[]
  participants MeetingParticipant[]

  @@index([meetingDate])
  @@index([status])
  @@index([reviewStage])
  @@index([visibilityScope])
}

model OrgUnit {
  id          String        @id @default(cuid())
  tenantId    String?
  parentId    String?
  type        OrgUnitType   @default(DEPARTMENT)
