  reviewStage           ReviewWorkflowStage @default(DRAFT)
  requiresFourEyeReview Boolean             @default(false)
  reviewedByUserId      String?
  reviewedAt            DateTime?

  // Visibility / access control
  visibilityScope        VisibilityScope @default(ORGANISATION)
  createdByUserId        String?
  // String[] stored as JSON — role keys, user IDs, team IDs, org unit IDs, person IDs, target group IDs
  visibleRoleRefs        Json?
  visibleUserRefs        Json?
  visibleTeamRefs        Json?
  visibleOrgUnitRefs     Json?
  visiblePersonRefs      Json?
  // Phase D — TargetGroup visibility: resolved target group members can see this entity.
