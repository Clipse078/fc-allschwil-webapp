// ---------------------------------------------------------------------------
// MediaAsset — Shared Media Library (News CMS V2)
//
// Tenant-scoped media assets (images and videos) managed via the
// admin media library. Assets are stored on Vercel Blob and referenced
// by news articles as hero images or embedded content.
//
// Provider-agnostic: url stores the CDN-served public URL regardless
// of the underlying storage backend (Vercel Blob today; S3-compatible later).
// ---------------------------------------------------------------------------

model MediaAsset {
  id              String           @id @default(cuid())
  tenantId        String
  type            MediaAssetType   @default(IMAGE)
  status          MediaAssetStatus @default(ACTIVE)
  filename        String
  mimeType        String
  sizeBytes       Int
  url             String
  altText         String?
  caption         String?
  width           Int?
  height          Int?
  durationSec     Int?
  createdByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // DAM V1 extensions — additive, all nullable for backward compatibility
  description  String?   // Long description / notes
  copyright    String?   // © copyright / rights information
  photographer String?   // Photographer / creator name
  folderId     String?   // Optional folder placement
  archivedAt   DateTime? // Set when status → ARCHIVED; null when active
  storageKey   String?   // Blob storage key for lifecycle management

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  folder           MediaFolder?       @relation(fields: [folderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  newsArticles     NewsArticle[]      @relation("NewsArticleHeroMedia")
  newsArticleMedia NewsArticleMedia[]
  tags             MediaAssetTag[]
  usages           MediaAssetUsage[]

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, folderId])
}

// ---------------------------------------------------------------------------
// NewsArticle — Public website news feed (News CMS V2)
//
// Tenant-scoped news articles surfaced via the public website API.
// Only PUBLISHED articles are returned by the public endpoints.
//
// V2 extensions (additive, backward-compatible):
//   heroMediaId — FK to MediaAsset for the article hero image.
//     imageUrl is kept for public-API backward-compat and populated
//     automatically from heroMedia.url when heroMediaId is set.
//   channels   — JSON string[] of publication channel keys
//                (e.g. ["website", "newsletter"]).
//   scheduledAt — UTC timestamp for deferred publication (SCHEDULED status).
//   authorName  — display name of the article author.
//   tags        — JSON string[] of tag labels for filtering/search.
//
// Public list endpoint omits content. Detail endpoint includes content.
// Internal fields (tenantId, status, etc.) are never exposed publicly.
// ---------------------------------------------------------------------------

model NewsArticle {
  id           String            @id @default(cuid())
  tenantId     String
  slug         String
  title        String
  excerpt      String?
  content      String
  imageUrl     String?
  status       NewsArticleStatus @default(DRAFT)
  publishedAt  DateTime?

  // V2 extensions
  heroMediaId    String?
  channels       Json?
  scheduledAt    DateTime?
  authorName     String?
  tags           Json?

  // V2.1 extensions
  authorPersonId String?
  reviewNotes    String?

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  heroMedia      MediaAsset?        @relation("NewsArticleHeroMedia", fields: [heroMediaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  authorPerson   Person?            @relation("NewsArticleAuthorPerson", fields: [authorPersonId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  additionalMedia NewsArticleMedia[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, status, publishedAt])
  @@index([tenantId, status, scheduledAt])
  @@index([tenantId, heroMediaId])
  @@index([tenantId, authorPersonId])
  @@index([slug])
}

// ---------------------------------------------------------------------------
// NewsArticleMedia — Additional media attached to a news article (V2.1)
//
// Separate from heroMediaId which is the dedicated header/hero image.
// Supports ordering (sortOrder), optional captions, and optional placement
// hints (e.g. "inline", "gallery") for rendering engines.
// ---------------------------------------------------------------------------

model NewsArticleMedia {
  id           String    @id @default(cuid())
  tenantId     String
  articleId    String
  mediaAssetId String
  sortOrder    Int       @default(0)
  caption      String?
  placement    String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  article    NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  mediaAsset MediaAsset  @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([articleId, mediaAssetId])
  @@index([articleId])
  @@index([tenantId])
  @@index([articleId, sortOrder])
}

// ---------------------------------------------------------------------------
// WebsitePage — Tenant-managed static/semi-static website pages (Slice 1)
//
// Supports the same editorial workflow as NewsArticle:
//   - approvedDataOnly = false → direct publish/unpublish
//   - approvedDataOnly = true  → DRAFT → IN_REVIEW → PUBLISHED (via reviewer)
//
// Public endpoint: GET /api/public/v1/website/pages/[slug]
//   Only PUBLISHED pages are returned. Internal fields are never exposed.
//
// body: raw Markdown or plain-text content. Full page builder comes in later slices.
// seoTitle / seoDescription: optional SEO overrides.
// scheduledAt: UTC timestamp for deferred publication (SCHEDULED status).
// authorPersonId: optional link to a Person record (FK, nullable).
// reviewNotes: reviewer feedback surfaced when status returns to DRAFT.
// ---------------------------------------------------------------------------

model WebsitePage {
  id             String            @id @default(cuid())
  tenantId       String
  slug           String
  title          String
  body           String            @default("")
  status         WebsitePageStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  scheduledAt    DateTime?
  publishedAt    DateTime?
  authorPersonId String?
  reviewNotes    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  authorPerson Person?              @relation("WebsitePageAuthorPerson", fields: [authorPersonId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sections     WebsitePageSection[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, status, publishedAt])
  @@index([tenantId, status, scheduledAt])
  @@index([tenantId, authorPersonId])
  @@index([slug])
}

// ---------------------------------------------------------------------------
// WebsitePageSection — Block-based page layout sections (CMS V2 Slice 8)
//
// Each WebsitePage can have an ordered set of typed content sections that
// define its block-based layout. This mirrors the HomepageSection model but
// is scoped to a specific page via pageId.
//
// Design invariants:
//   - One WebsitePageSection row per logical page block.
//   - sortOrder controls display order (ascending, 0-based).
//   - isEnabled gates public visibility: only enabled sections appear in the
//     public layout API when the parent page is PUBLISHED.
//   - config is free-form JSON; validated by the shared block registry helpers.
//   - type must match a key in the shared block registry (lib/homepage/block-registry.ts).
//
// Publishing strategy (CMS V2 Slice 8 — foundation):
//   Section visibility on the public API requires BOTH:
//     1. isEnabled = true (section gate)
//     2. parent WebsitePage.status = "PUBLISHED" AND publishedAt <= now() (page gate)
//   Full section-level publish/approval workflow is deferred to a future slice.
//   Sections do not carry their own publishStatus; they inherit the page's status.
//
// CMS V2 Slice 9 — Section Lifecycle:
//   Full section-level publish/approval workflow implemented.
//   Mirrors HomepageSection workflow pattern for architectural consistency.
//   Reusable publishing engine in lib/cms/section-publishing.ts.
// ---------------------------------------------------------------------------

model WebsitePageSection {
  id        String   @id @default(cuid())
  tenantId  String
  pageId    String
  /// Section type key — must match a key in the shared block registry.
  type      String
  /// Human-readable admin label (editable by the tenant admin).
  label     String
  /// Display order (ascending). Lower values render first.
  sortOrder Int      @default(0)
  /// When false the section is hidden from the public layout API.
  isEnabled Boolean  @default(true)
  /// Type-specific configuration stored as a JSON object.
  /// Validated at the application layer via the shared block registry helpers.
  config    Json     @default("{}")
  // ── Publishing workflow fields (CMS V2 Slice 9) ──────────────────────────
  /// Publish status gate — "DRAFT" | "PUBLISHED".
  /// Default "PUBLISHED" preserves backwards compatibility for all pre-Slice-9 rows.
  publishStatus      String    @default("PUBLISHED")
  /// Timestamp of the most recent publish action.
  publishedAt        DateTime?
  /// Timestamp of the most recent unpublish action.
  unpublishedAt      DateTime?
  /// Retained after unpublish for audit trail.
  lastPublishedAt    DateTime?
  /// Optional future publish date. If set and <= now(), treated as published.
  scheduledPublishAt DateTime?
  /// Optional expiry date. If set and <= now(), section is hidden from public API.
  publishUntil       DateTime?
  // ── Approval workflow fields (CMS V2 Slice 9) ──────────────────────────
  /// Approval status — "NOT_REQUIRED" | "DRAFT" | "IN_REVIEW" | "APPROVED" | "CHANGES_REQUESTED".
  /// Default "NOT_REQUIRED" preserves backwards compatibility for all pre-Slice-9 rows.
  approvalStatus     String    @default("NOT_REQUIRED")
  reviewerUserId     String?
  reviewRequestedAt  DateTime?
  reviewedAt         DateTime?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  approvalNote       String?
  approvedByUserId   String?
  rejectedByUserId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  page             WebsitePage @relation(fields: [pageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reviewerUser     User?       @relation("PageSectionReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approvedByUser   User?       @relation("PageSectionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  rejectedByUser   User?       @relation("PageSectionRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([tenantId])
  @@index([tenantId, pageId])
  @@index([tenantId, pageId, sortOrder])
  @@index([tenantId, pageId, isEnabled])
  @@index([tenantId, publishStatus])
  @@index([tenantId, approvalStatus])
  @@index([scheduledPublishAt])
}

// ---------------------------------------------------------------------------
// HomepageSection — Configurable homepage layout sections (CMS V2 Slices 2–6)
//
// Each tenant has an ordered set of named sections that define the layout of
// their public homepage. Sections are typed (see HomepageSectionType enum-like
// registry in lib/homepage/section-types.ts) and carry a JSON config blob for
// type-specific parameters (e.g. item count, label overrides).
//
// Design invariants:
//   - One HomepageSection row per logical homepage block.
//   - sortOrder controls display order (ascending, 0-based).
//   - isEnabled gates visibility gate 1: only enabled sections appear in public API.
//   - publishStatus gates visibility gate 2: only PUBLISHED sections appear in public API.
//   - scheduledPublishAt: if set and <= now(), the section is treated as published.
//   - config is free-form JSON; validated by section-type-specific helpers.
//
// Publishing workflow (CMS V2 Slice 5):
//   - publishStatus: "DRAFT" | "PUBLISHED"
//     Default "PUBLISHED" ensures all sections created before Slice 5 remain public.
//   - publishedAt: when the section was last published (nullable).
//   - unpublishedAt: when the section was last unpublished (nullable).
//   - lastPublishedAt: most recent publish timestamp for audit trail (nullable).
//   - scheduledPublishAt: if not null and <= now(), treated as published (nullable).
//
// Editorial approval workflow (CMS V2 Slice 6):
//   - approvalStatus: NOT_REQUIRED | DRAFT | IN_REVIEW | APPROVED | CHANGES_REQUESTED
//     Default "NOT_REQUIRED" preserves backwards compatibility for all pre-Slice-6 rows.
//     Sections with NOT_REQUIRED or APPROVED may be published/scheduled.
//     Sections with DRAFT, IN_REVIEW, or CHANGES_REQUESTED are blocked from publishing.
//   - reviewerUserId: nullable FK to User assigned as reviewer (foundation-level).
//   - reviewRequestedAt: when review was last requested.
//   - reviewedAt: when the most recent review action was taken (approve or reject).
//   - approvedAt: when the section was most recently approved.
//   - rejectedAt: when the section was most recently rejected.
//   - approvalNote: reviewer's note from the most recent approve/reject action.
//   - approvedByUserId: nullable FK to User who approved.
//   - rejectedByUserId: nullable FK to User who rejected.
//   Audit trail: all approval state transitions are recorded in AuditLog
//   (moduleKey="homepage", entityType="HomepageSection") via logAction().
//
// Public endpoint: GET /api/public/[tenant]/website/homepage
//   Returns only sections where isEnabled=true AND publishStatus=PUBLISHED AND
//   (scheduledPublishAt IS NULL OR scheduledPublishAt <= now()).
//   Internal admin fields (createdAt, updatedAt, tenantId) are never exposed.
//   Approval fields are NEVER exposed on the public endpoint.
//
// Future deferred work (document-only):
//   - Full four-eyes policy engine
//   - Email/push notification system
//   - Full reviewer assignment workflow (role-based)
//   - Drag-and-drop reordering
//   - Sponsor section backed by a real Sponsor model
//   - Background scheduler worker for scheduled publishing
// ---------------------------------------------------------------------------

model HomepageSection {
  id        String   @id @default(cuid())
  tenantId  String
  /// Section type key — must match a key in HOMEPAGE_SECTION_TYPES registry.
  type      String
  /// Human-readable admin label (editable by the tenant admin).
  label     String
  /// Display order (ascending). Lower values render first.
  sortOrder Int      @default(0)
  /// When false the section is hidden from the public API (gate 1).
  isEnabled Boolean  @default(true)
  /// Type-specific configuration stored as a JSON object.
  /// Validated at the application layer via section-type helpers.
  config    Json     @default("{}")
  // ── Publishing workflow fields (CMS V2 Slice 5) ──────────────────────────
  /// Publish status gate 2 — "DRAFT" | "PUBLISHED".
  /// Default "PUBLISHED" preserves backwards compatibility for all pre-Slice-5 rows.
  publishStatus      String   @default("PUBLISHED")
  /// Timestamp of the most recent publish action.
  publishedAt        DateTime?
  /// Timestamp of the most recent unpublish action.
  unpublishedAt      DateTime?
  /// Timestamp of the most recent publish action (audit trail duplicate of publishedAt,
  /// retained so unpublish does not erase the last-known publish time).
  lastPublishedAt    DateTime?
  /// Optional future publish date. If set and <= now(), section is treated as published.
  /// Null means no scheduled publication.
  scheduledPublishAt DateTime?
  // ── Editorial approval workflow fields (CMS V2 Slice 6) ──────────────────
  /// Approval status — "NOT_REQUIRED" | "DRAFT" | "IN_REVIEW" | "APPROVED" | "CHANGES_REQUESTED".
  /// Default "NOT_REQUIRED" preserves backwards compatibility for all pre-Slice-6 rows.
  /// Only APPROVED and NOT_REQUIRED sections may be published or scheduled.
  approvalStatus     String    @default("NOT_REQUIRED")
  /// Nullable FK to the User assigned as reviewer (foundation-level assignment).
  reviewerUserId     String?
  /// When review was most recently requested (set by request-review action).
  reviewRequestedAt  DateTime?
  /// When the most recent review action was taken (approve or reject).
  reviewedAt         DateTime?
  /// When the section was most recently approved.
  approvedAt         DateTime?
  /// When the section was most recently rejected.
  rejectedAt         DateTime?
  /// Note left by the reviewer during approve or reject (most recent action).
  approvalNote       String?
  /// Nullable FK to the User who most recently approved this section.
  approvedByUserId   String?
  /// Nullable FK to the User who most recently rejected this section.
  rejectedByUserId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reviewerUser     User?   @relation("HomepageSectionReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approvedByUser   User?   @relation("HomepageSectionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  rejectedByUser   User?   @relation("HomepageSectionRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([tenantId])
  @@index([tenantId, isEnabled])
  @@index([tenantId, sortOrder])
  @@index([tenantId, isEnabled, sortOrder])
  @@index([tenantId, publishStatus])
  @@index([tenantId, isEnabled, publishStatus])
  @@index([scheduledPublishAt])
  @@index([tenantId, approvalStatus])
}

// ---------------------------------------------------------------------------
// WebsiteNavItem — Tenant-managed website navigation items (CMS V2 Slice 7)
//
// Each tenant owns an ordered set of navigation items that define the structure
// of their website menus. Items are organised by:
//   - area:     HEADER | FOOTER | UTILITY — which menu area the item belongs to
//   - parentId: nullable self-reference for multi-level hierarchy
//   - sortOrder: display position within the same parent/area
//
// Link types:
//   - INTERNAL  — WebApp-relative path (e.g. /news)
//   - EXTERNAL  — Fully-qualified URL (https://...)
//   - CUSTOM    — Arbitrary string (anchor, fragment, etc.)
//
// Visibility:
//   - isVisible: primary gate — false means hidden from public API
//   - visibilityMode: ALWAYS | AUTHENTICATED | ANONYMOUS
//     Default ALWAYS. AUTHENTICATED/ANONYMOUS modes are foundation-level;
//     the public API currently respects only isVisible=true.
//
// Circular reference prevention and cross-tenant parent checks are enforced
// at the application layer (admin-queries.ts), not the DB layer.
//
// Public endpoint: GET /api/public/[tenant]/website/navigation
//   Returns only items where isVisible=true, ordered by area + parent + sortOrder.
//   Admin fields (createdAt, updatedAt, tenantId, visibilityMode) are never exposed.
//
// Future deferred work:
//   - ROLE_BASED visibility with requiredPermission
//   - pageId FK to WebsitePage
//   - Drag-and-drop reordering
//   - Mega menu / visual menu builder
// ---------------------------------------------------------------------------

model WebsiteNavItem {
  id             String    @id @default(cuid())
  tenantId       String
  /// Nullable self-reference: null = top-level item in its area.
  parentId       String?
  /// Menu area. One of: "HEADER" | "FOOTER" | "UTILITY"
  area           String
  /// Display label for this navigation item.
  label          String
  /// Link type. One of: "INTERNAL" | "EXTERNAL" | "CUSTOM"
  linkType       String    @default("INTERNAL")
  /// URL or path for this item. Null for non-linking parent items.
  href           String?
  /// Link target. One of: "SELF" | "BLANK". Default SELF.
  target         String    @default("SELF")
  /// Display order within the same parent/area (ascending, 0-based).
  sortOrder      Int       @default(0)
  /// Primary visibility gate. false = hidden from public API.
  isVisible      Boolean   @default(true)
  /// Visibility mode. One of: "ALWAYS" | "AUTHENTICATED" | "ANONYMOUS".
  /// Foundation-level: public API currently only filters by isVisible.
  visibilityMode String    @default("ALWAYS")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parent   WebsiteNavItem?  @relation("NavItemChildren", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children WebsiteNavItem[] @relation("NavItemChildren")

  @@index([tenantId])
  @@index([tenantId, area])
  @@index([tenantId, area, parentId])
  @@index([tenantId, area, parentId, sortOrder])
  @@index([tenantId, isVisible])
  @@index([parentId])
}

// ---------------------------------------------------------------------------
// ContentRevision — Append-only version history for CMS content (CMS V2 Slice 9)
//
// Every significant edit to a CMS entity (WebsitePageSection, WebsitePage,
// HomepageSection) creates an immutable revision record capturing the full
// entity state at that point in time.
//
// Design invariants:
//   - Append-only: revisions are never updated or deleted.
//   - versionNumber: auto-incremented per (entityType, entityId) pair.
//   - snapshot: full JSON representation of the entity at save time.
//   - Restoring a revision creates a NEW revision (never overwrites history).
//
// Audit trail: every revision records who made the change (createdByUserId)
// and optionally what changed (changeNote). Future compliance features
// can query this table for a complete history of any CMS entity.
// ---------------------------------------------------------------------------

model ContentRevision {
  id              String   @id @default(cuid())
  tenantId        String
  /// Entity type key: "WebsitePageSection" | "WebsitePage" | "HomepageSection"
  /// Future: "NewsArticle" | "Event" | "LandingPage" — no schema change needed.
  entityType      String
  /// ID of the entity this revision belongs to.
  entityId        String
  /// Monotonically increasing version number per (entityType, entityId).
  versionNumber   Int
  /// User who created this revision (nullable for system-generated revisions).
  createdByUserId String?
  /// Optional human-readable note describing what changed.
  changeNote      String?
  /// Full JSON snapshot of the entity at this revision.
  snapshot        Json
  /// When true, this revision was created by a restore action.
  /// Makes restored revisions easy to identify for diffing and rollback chains.
  isRestore       Boolean  @default(false)
  /// FK to the source revision this was restored from (nullable).
  /// Enables: visual diffing, rollback chains, branching, merge history.
  /// Set when isRestore = true; null for normal edits.
  parentRevisionId String?
  createdAt       DateTime @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdByUser   User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  parentRevision  ContentRevision? @relation("RevisionParent", fields: [parentRevisionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  childRevisions  ContentRevision[] @relation("RevisionParent")

  @@unique([entityType, entityId, versionNumber])
  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([tenantId, entityType])
  @@index([createdAt])
  @@index([isRestore])
}

// ---------------------------------------------------------------------------
// MediaFolder — DAM folder hierarchy (CMS V2 Slice 11)
//
// Tenant-scoped folder tree for organising MediaAssets.
// Nested folders are supported via self-referencing parentId.
// Folder names are unique within the same parent scope (enforced at app layer).
//
// Deletion policy: prefer archive via archivedAt; hard-delete only when
// the folder has no children and no assigned assets.
// ---------------------------------------------------------------------------

model MediaFolder {
  id         String    @id @default(cuid())
  tenantId   String
  parentId   String?
  name       String
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parent   MediaFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children MediaFolder[] @relation("FolderHierarchy")
  assets   MediaAsset[]

  @@index([tenantId])
  @@index([tenantId, parentId])
  @@index([tenantId, sortOrder])
}

// ---------------------------------------------------------------------------
// MediaTag — Reusable DAM tags (CMS V2 Slice 11)
//
// Tenant-scoped controlled tag vocabulary. Tag names are unique per tenant.
// Tags can be attached to any number of MediaAssets via MediaAssetTag.
// ---------------------------------------------------------------------------

model MediaTag {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assets MediaAssetTag[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// MediaAssetTag — Asset ↔ Tag join (CMS V2 Slice 11)
// ---------------------------------------------------------------------------

model MediaAssetTag {
  id           String   @id @default(cuid())
  tenantId     String
  mediaAssetId String
  tagId        String
  createdAt    DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tag        MediaTag   @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([mediaAssetId, tagId])
  @@index([tagId])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// MediaAssetUsage — Generic cross-module usage tracking (CMS V2 Slice 11)
//
// Tracks where each MediaAsset is referenced, across any entity type.
// Records are upserted when an entity is saved and removed when the
// reference is removed.
//
// entityType: "NewsArticle" | "HomepageSection" | "WebsitePageSection" | …
// fieldPath:  dot-path to the field holding the asset ID, e.g. "heroMediaId"
//             or "config.imageUrl". Null for join-table relationships.
//
// Future entity types can plug in without schema changes.
// ---------------------------------------------------------------------------

model MediaAssetUsage {
  id           String   @id @default(cuid())
  tenantId     String
  mediaAssetId String
  entityType   String
  entityId     String
  fieldPath    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([mediaAssetId, entityType, entityId, fieldPath])
  @@index([tenantId])
  @@index([mediaAssetId])
  @@index([entityType, entityId])
}
