// ---------------------------------------------------------------------------
// Meeting — Visibility / Governance
//
// Visibility is implemented: VisibilityScope (ORGANISATION / RESTRICTED / PRIVATE)
// enforced by canSeeEntity() in lib/visibility/visibility-filter.ts.
// RESTRICTED allowlist includes org units, roles, and users.
//
// Roadmap:
//   - visibleTeamRefs / visiblePersonRefs: requires teamIds / personId on ActorContext
//   - PRIVATE non-creator allowlist: DB WHERE needs JSONB @> (Phase 2)
//   - Reviewer role validation via RoleWorkflowReviewAssignment (Phase 2)
// ---------------------------------------------------------------------------
model Meeting {
  id            String        @id @default(cuid())
