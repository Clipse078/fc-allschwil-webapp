// ---------------------------------------------------------------------------
// Competition — canonical competition metadata entity.
//
// Represents league / cup / tournament series metadata imported from an
// external provider (e.g. SFV) or entered manually. This is NOT a standings,
// results, or scheduling entity — it holds only the descriptive metadata.
//
// Sync invariants:
//   - Idempotent: (tenantId, provider, externalCompetitionId, externalSeasonId)
//     is unique, preventing duplicate rows across sync runs.
//   - When externalCompetitionId or externalSeasonId is null (manual entry),
//     uniqueness is on (tenantId, provider, officialName).
//   - Sync service sets isArchived = false when a competition reappears after
//     being absent, and lastSyncedAt on every sync touch.
//
// Usage:
//   - TeamSeasonCompetition links a TeamSeason to one or more Competitions.
//   - getEligibleCompetitions(seasonId) returns non-archived competitions for
//     team registration workflows.
//   - resolveCompetition(provider, externalCompetitionId, externalSeasonId)
//     returns the canonical Competition for matchcenter use.
// ---------------------------------------------------------------------------

model Competition {
  id                    String             @id @default(cuid())
  /// Owning tenant. All queries must scope by tenantId.
  tenantId              String
  /// External provider identifier, e.g. "SFV" or "MANUAL".
  provider              String
  /// Provider-assigned competition/league/cup identifier. Null for manual entries.
  externalCompetitionId Int?
  /// Provider-assigned season identifier. Null for manual entries or seasonless competitions.
  externalSeasonId      Int?
  /// Full official name as reported by the provider or entered manually.
  officialName          String
  /// Short display name (local override; not overwritten by sync).
  shortName             String?
  /// Group/division name within the competition (e.g. "Gruppe A").
  groupName             String?
  /// Structural classification of the competition.
  competitionType       CompetitionType    @default(LEAGUE)
  /// Gender category as reported by the provider.
  gender                CompetitionGender?
  /// Age category label (e.g. "U15", "Junioren", "Frauen").
  ageCategory           String?
  /// When true, the competition is hidden from active team registration and
  /// display surfaces. Retained for historical references.
  isArchived            Boolean            @default(false)
  /// Timestamp of the last successful sync that touched this competition.
  lastSyncedAt          DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  teamSeasonCompetitions TeamSeasonCompetition[]
  /// Back-relation for TeamExternalMapping.mappingCompetitionId (TEAM-PROVIDER-01).
  teamExternalMappings   TeamExternalMapping[]   @relation("TeamExternalMappingCompetition")

  /// Prevents duplicate provider competitions per tenant per season.
  @@unique([tenantId, provider, externalCompetitionId, externalSeasonId])
  @@index([tenantId])
  @@index([tenantId, provider])
  @@index([tenantId, isArchived])
  @@index([tenantId, provider, externalSeasonId])
}

// ---------------------------------------------------------------------------
// TeamSeasonCompetition — join between TeamSeason and Competition.
//
// A TeamSeason may have 0, 1, or multiple competitions (e.g. League + Cup).
// Competition is OPTIONAL for TeamSeason; training teams and non-competitive
// groups have no competition entry.
//
// Architecture invariants:
//   - Duplicate (teamSeasonId, competitionId) is prevented at DB level.
//   - isPrimary = true indicates the primary competition for display purposes.
//     Service layer enforces at most one isPrimary per TeamSeason.
//   - displayOrder controls ordering when multiple competitions exist.
//   - onDelete: Cascade on teamSeason — deleting a TeamSeason removes all links.
//   - onDelete: Restrict on competition — prevents silent deletion of
//     referenced competitions. Archive competitions instead of deleting.
// ---------------------------------------------------------------------------

model TeamSeasonCompetition {
  id            String   @id @default(cuid())
  teamSeasonId  String
  competitionId String
  /// When true, this is the primary competition for this TeamSeason.
  /// At most one row per TeamSeason should have isPrimary = true.
  isPrimary     Boolean  @default(false)
  /// Controls display order when a TeamSeason belongs to multiple competitions.
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teamSeason  TeamSeason  @relation(fields: [teamSeasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([teamSeasonId, competitionId])
  @@index([teamSeasonId])
  @@index([competitionId])
  @@index([teamSeasonId, isPrimary])
}

model Person {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  displayName String?
  email       String?
  phone       String?
  dateOfBirth DateTime?
  notes       String?
  isActive    Boolean   @default(true)
  isPlayer    Boolean   @default(false)
  isTrainer   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // REGISTRATION-01F — Goal 3: fields copied verbatim from a registration
  // when a Person is created through the "Create Person" workflow action.
  // These are plain, non-derived data — never invented, never guessed.
  street      String?
  houseNumber String?
  postalCode  String?
  city        String?
  country     String?

  guardianFirstName String?
  guardianLastName  String?
  guardianEmail     String?
  guardianPhone     String?

  /// Football-specific fields copied from the registration's `football`
  /// payload where relevant (requestedTeam, requestedAgeGroup,
  /// preferredTraining, playingExperience, currentClub, previousClub,
  /// position). Null for persons not created from a football registration.
  footballJson Json?

  /// True when this Person was created via the registration "Create
  /// Person" workflow action, as opposed to manual entry elsewhere in
  /// People admin. Never set automatically outside that explicit action.
  createdFromRegistration Boolean @default(false)
  /// The specific registration whose "Create Person" action produced this
  /// Person record (Goal 3). Distinct from any Registration.personId link,
  /// which may later point elsewhere (e.g. a subsequent registration is
  /// manually linked to this same, already-existing Person).
  createdRegistrationId   String?

  createdRegistration Registration? @relation("PersonCreatedFromRegistration", fields: [createdRegistrationId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  playerSquadMembers   PlayerSquadMember[]
  trainerTeamMembers   TrainerTeamMember[]
  orgUnitMemberships   OrgUnitMembership[]
  authoredNewsArticles NewsArticle[]       @relation("NewsArticleAuthorPerson")
  authoredWebsitePages WebsitePage[]       @relation("WebsitePageAuthorPerson")
  // Registrations currently linked to this Person (Goal 2/3 — may include
  // registrations linked via manual "existing person" match, not only the
  // one that created this Person; see createdRegistrationId above).
  linkedRegistrations  Registration[]      @relation("RegistrationPerson")

  @@index([lastName, firstName])
  @@index([email])
  @@index([isActive])
  @@index([isPlayer])
  @@index([isTrainer])
  @@index([createdRegistrationId])
}

model Team {
  id               String       @id @default(cuid())
  // ── TEAM-IDENTITY-01: canonical tenant-owned naming ───────────────────────
  // Team.name is the canonical LONG NAME (e.g. "FC Allschwil Junioren B2").
  // Kept as `name` for backward compatibility — NOT renamed to `longName`.
  // Tenant-managed: set on Team creation (including first SFV import) and
  // then owned exclusively by the tenant. Provider sync never overwrites it
  // on subsequent syncs (see lib/integrations/sfv/sync/team-mapper.ts).
  name             String
  /// SHORT NAME (e.g. "B2") — tenant-owned, optional. Used for compact
  /// contexts. Never written by provider sync. Distinct from
  /// TeamSeason.shortName, which is a seasonal presentation override.
  shortName        String?
  /// ALTERNATIVE NAME (e.g. "Junioren B2") — tenant-owned, optional.
  /// Used as a naming fallback before providerTeamName. Never written by
  /// provider sync. Never auto-derived from string parsing of other names.
  alternativeName  String?
  // slug is unique per tenant (tenant-scoped) since TEAM-CORE-02.
  // Legacy global @unique dropped; replaced by @@unique([tenantId, slug]) below.
  // Queries must always scope by tenantId when resolving by slug.
  slug             String
  // @deprecated TeamCategory — legacy compatibility field retained for existing APIs,
  //   website fallbacks, and admin UI. New business logic must use TeamSeasonOrgUnit.
  //   Do not add new rules based on TeamCategory. Removal planned for TEAM-CORE-03+.
  category         TeamCategory
  genderGroup      String?
  ageGroup         String?
  sortOrder        Int          @default(0)
  isActive         Boolean      @default(true)
  // websiteVisible / infoboardVisible — transitional fallback fields.
  // Canonical seasonal visibility lives on TeamSeason. These fields are read
  // when a TeamSeason record is absent or as legacy fallback.
  // Removal planned once all reads use the getEffectiveTeamSeasonVisibility() helper.
  websiteVisible   Boolean      @default(true)
  infoboardVisible Boolean      @default(true)
  // @deprecated orgUnitId — legacy single OrgUnit link. Retained for backward
  //   compatibility. New canonical relationship is TeamSeasonOrgUnit (many-to-many).
  //   Do not use for new business logic. Removal planned after full migration.
  orgUnitId        String?

  // Tenant isolation (nullable: backward-compat; backfill in 20260626000000_team_tenant_isolation)
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamSeasons              TeamSeason[]
  events                   Event[]
  eventImportRuns          EventImportRun[]
  orgUnit                  OrgUnit?                @relation(fields: [orgUnitId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  externalMappings         TeamExternalMapping[]
  homeMatchMappings        MatchExternalMapping[]  @relation("MatchHomeTeam")
  awayMatchMappings        MatchExternalMapping[]  @relation("MatchAwayTeam")
  // TOURNAMENTCENTER-01B: canonical multi-team tournament participation —
  // a Team may participate in many tournaments, and a tournament may have
  // many Team participants (see TournamentParticipant below).
  tournamentParticipations TournamentParticipant[]

  @@unique([tenantId, slug])
  @@index([category, sortOrder])
  @@index([isActive])
  @@index([orgUnitId])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// TeamExternalMapping — external-provider identity for a Team.
//
// Holds the mapping between a canonical SportClubEvo Team and a record in an
// external provider (e.g. SFV / ClubCorner). One mapping row per provider +
// external team + season + tenant combination.
//
// Team remains the canonical entity owned by Organisation Builder.
// SFV is an external provider. This model links the two without coupling Team
// to any provider-specific column.
//
// Future providers (e.g. Fussball.ch, licencing systems) add their own rows
// without schema changes to Team.
// ---------------------------------------------------------------------------

model TeamExternalMapping {
  id                     String   @id @default(cuid())
  /// Owning tenant. Scopes all lookups and mutations to a single tenant.
  tenantId               String
  /// The canonical Team this mapping belongs to.
  teamId                 String
  /// External provider identifier, e.g. "SFV".
  provider               String
  /// Provider-assigned team identifier (e.g. SFV teamId integer).
  externalTeamId         Int
  /// Provider-assigned season identifier used at time of sync (e.g. SFV seasonId integer).
  externalSeasonId       Int
  /// Provider-reported team name at time of last sync.
  providerTeamName       String?
  /// Provider-reported league identifier at time of last sync.
  providerLeagueId       Int?
  /// Provider-reported league name at time of last sync.
  providerLeagueName     String?
  /// Provider-reported organisation identifier at time of last sync.
  providerOrganisationId Int?
  /// Whether the provider reports this team as active.
  providerIsActive       Boolean  @default(true)
  /// Timestamp of the last successful sync that touched this mapping.
  lastSyncedAt           DateTime
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  /// Preferred seasonal link (TEAM-CORE-02). Nullable during transition.
  /// When set, teamSeason.teamId MUST equal teamId and externalSeasonId MUST
  /// correspond to the TeamSeason's season. Null for historical rows or when
  /// resolution is ambiguous (multiple matching TeamSeasons).
  teamSeasonId String?

  // ── TEAM-PROVIDER-01: canonical provider mapping workflow ─────────────────
  /// How this mapping was created.
  /// "SYNC" = created automatically by provider sync.
  /// "MANUAL" = created explicitly by an administrator through the mapping workflow.
  mappingSource        String  @default("SYNC")
  /// Suggestion-engine confidence level at the time of creation or last suggestion.
  /// "HIGH" | "MEDIUM" | "LOW" — null for SYNC-created rows and for confirmed
  /// manual mappings where confidence is not applicable.
  confidenceLevel      String?
  /// Competition ID used as context when this mapping was created.
  /// Assists traceability — Competition does NOT own the provider mapping.
  mappingCompetitionId String?

  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  team               Team         @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  teamSeason         TeamSeason?  @relation(fields: [teamSeasonId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  /// The Competition used as mapping context (TEAM-PROVIDER-01). Does NOT mean
  /// Competition owns the mapping — it is informational context only.
  mappingCompetition Competition? @relation("TeamExternalMappingCompetition", fields: [mappingCompetitionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  // TEAM-PROVIDER-01-V: partial unique index (teamSeasonId, provider) WHERE teamSeasonId IS NOT NULL
  // enforced via raw migration; Prisma schema documents the intent here.
  // One TeamSeason may have at most one active mapping per provider.

  /// Prevents duplicate mappings for the same external team/season/provider/tenant.
  @@unique([tenantId, provider, externalTeamId, externalSeasonId])
  @@index([tenantId, provider])
  @@index([teamId])
  @@index([teamSeasonId])
  @@index([providerIsActive])
  @@index([mappingSource])
  @@index([mappingCompetitionId])
}

model TeamSeason {
  id                        String            @id @default(cuid())
  teamId                    String
  seasonId                  String
  displayName               String
  shortName                 String?
  status                    TeamSeasonStatus  @default(ACTIVE)
  /// How this TeamSeason participates in the season (TEAM-CREATE-02).
  /// COMPETITION teams require at least one TeamSeasonCompetition entry.
  /// All other types can operate without a competition assignment.
  participationType         ParticipationType @default(TRAINING)
  websiteVisible            Boolean           @default(true)
  infoboardVisible          Boolean           @default(true)
  squadWebsiteVisible       Boolean           @default(true)
  trainerTeamWebsiteVisible Boolean           @default(true)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  team               Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  season             Season                  @relation(fields: [seasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  playerSquadMembers PlayerSquadMember[]
  trainerTeamMembers TrainerTeamMember[]
  // TEAM-CORE-02: canonical many-to-many Organisationseinheit assignment
  orgUnits           TeamSeasonOrgUnit[]
  // TEAM-CORE-02: seasonal link on external provider mappings
  externalMappings   TeamExternalMapping[]
  // COMPETITION-01: optional competitions for this TeamSeason
  competitions       TeamSeasonCompetition[]
  // TRAINING-CORE-01: canonical recurring training series for this TeamSeason
  trainingSeries     TrainingSeries[]
  // TRAININGCENTER-02: canonical generated training sessions for this TeamSeason
  trainingSessions   TrainingSession[]

  @@unique([teamId, seasonId])
  @@index([seasonId])
  @@index([status])
  @@index([participationType])
  @@index([squadWebsiteVisible])
  @@index([trainerTeamWebsiteVisible])
}

// ---------------------------------------------------------------------------
// TeamSeasonOrgUnit — canonical many-to-many join between TeamSeason and OrgUnit
//
// TEAM-CORE-02: replaces the legacy single Team.orgUnitId link.
//
// Architecture invariants:
//   - One TeamSeason may belong to multiple OrgUnits (e.g. Junioren + Aktive).
//   - One OrgUnit may contain multiple TeamSeasons across seasons.
//   - Duplicate (teamSeasonId, orgUnitId) is prevented at DB level.
//   - tenantId must match both the TeamSeason tenant and the OrgUnit tenant.
//   - Archived OrgUnits remain historically linked (no retroactive removal).
//   - Service layer must reject archived OrgUnits for NEW assignments.
//   - onDelete: Restrict on orgUnit prevents silent deletion of historical links.
//     OrgUnit archival is preferred over deletion to preserve history.
//   - onDelete: Cascade on teamSeason cascades with the seasonal record.
//
// Legacy compatibility:
//   - Team.orgUnitId is kept as a deprecated transitional field.
//   - Existing single-OrgUnit data is backfilled into this table on migration.
//
// Eligibility rules (enforced at service layer, not DB):
//   - OrgUnit must belong to the same tenant.
//   - OrgUnit must be ACTIVE (not ARCHIVED or INACTIVE) for new assignments.
// ---------------------------------------------------------------------------
model TeamSeasonOrgUnit {
  id           String   @id @default(cuid())
  tenantId     String
  teamSeasonId String
  orgUnitId    String
  /// When true, this OrgUnit is the primary grouping for display purposes.
  /// At most one row per TeamSeason should have isPrimary = true.
  isPrimary    Boolean  @default(false)
  /// Controls display order when a TeamSeason belongs to multiple OrgUnits.
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  teamSeason TeamSeason @relation(fields: [teamSeasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// Restrict prevents silent deletion of historical TeamSeason→OrgUnit links.
  /// Archive OrgUnits instead of deleting them to preserve history.
  orgUnit    OrgUnit    @relation(fields: [orgUnitId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([teamSeasonId, orgUnitId])
  @@index([tenantId])
  @@index([teamSeasonId])
  @@index([orgUnitId])
  @@index([tenantId, isPrimary])
}

model PlayerSquadMember {
