model Tenant {
  id        String       @id @default(cuid())
  key       String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Config v1 — Slice 10.2
  // String fields are nullable: no opinionated DB default for white-label safety.
  // Seed sets explicit values for fc-allschwil. New tenants start with nulls.
  countryCode           String?
  sportCategory         String?
  locale                String?
  timezone              String?
  currency              String?
  // Season integers have a neutral structural default (August 1st European convention).
  seasonStartMonth      Int     @default(8)
  seasonTransitionDay   Int     @default(1)
  seasonTransitionMonth Int     @default(8)

  // Branding v1 — Slice 10.6
  // All nullable: no DB default for white-label safety.
  // Application code falls back to SportClubEvo defaults when null.
  // primaryColor / secondaryColor: 6-digit hex (#rrggbb); validated at API layer.
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?

  // Website integration flags — Slice 4 (News Detail Endpoint)
  // websiteEnabled: gates all /api/public/v1/website/* endpoints for this tenant.
  // approvedDataOnly: when true, only content that has passed editorial approval
  //   is surfaced on the public website feed. Defaults false for backward-compat.
  websiteEnabled   Boolean @default(true)
  approvedDataOnly Boolean @default(false)

  // Design System — CMS V4
  // Nullable JSON column. Null = use platform defaults from DEFAULT_DESIGN_SYSTEM.
  // All reads go through resolveDesignSystem() in lib/website/design-system-types.ts.
  // Non-destructive: existing tenants receive defaults automatically without migration data.
  websiteDesignSystem Json?

  registrations           Registration[]
  users                   User[]
  events                  Event[]
  teams                   Team[]
  facilities              Facility[]
  facilityResources       FacilityResource[]
  wochenplanPublications  WochenplanPublication[]
  newsArticles            NewsArticle[]
  mediaAssets             MediaAsset[]
  mediaFolders            MediaFolder[]
  mediaTags               MediaTag[]
  mediaAssetTags          MediaAssetTag[]
  mediaAssetUsages        MediaAssetUsage[]
  newsArticleMedia        NewsArticleMedia[]
  websitePages            WebsitePage[]
  websitePageSections     WebsitePageSection[]
  homepageSections        HomepageSection[]
  websiteNavItems         WebsiteNavItem[]
  contentRevisions        ContentRevision[]
  reusableComponents      ReusableComponent[]
  reusableComponentUsages ReusableComponentUsage[]

  // Workspace
  workspaceFolders          WorkspaceFolder[]
  workspaceDocuments        WorkspaceDocument[]
  workspaceDocumentVersions WorkspaceDocumentVersion[]

  // SFV Integration — Slice: Tenant-Scoped SFV Configuration
  // One config per tenant (@@unique on tenantId). Null when not configured.
  sfvConfig                        TenantSfvConfig?
  teamExternalMappings             TeamExternalMapping[]
  matchExternalMappings            MatchExternalMapping[]
  // CLUB-DIRECTORY-01: canonical external club/team directory. Supersedes
  // the earlier "Opponent"/"OpponentExternalMapping" foundation (MC-04B),
  // which was never wired to any write path or UI and had no club/team split.
  externalClubs                    ExternalClub[]
  externalClubProviderLinks        ExternalClubProviderMapping[]
  externalTeams                    ExternalTeam[]
  externalTeamProviderLinks        ExternalTeamProviderMapping[]
  // TEAM-CORE-02: canonical seasonal OrgUnit assignments
  teamSeasonOrgUnits               TeamSeasonOrgUnit[]
  // COMPETITION-01: canonical competition entities
  competitions                     Competition[]
  // TRAINING-CORE-01: canonical recurring training series
  trainingSeries                   TrainingSeries[]
  // TRAINING-PLANS-01: tenant-defined training plans and assignments
  trainingPlans                    TrainingPlan[]
  trainingPlanAssignments          TrainingPlanAssignment[]
  // TRAINING-ALLOCATIONS-01: canonical facility resource allocations
  trainingAllocations              TrainingAllocation[]
  // TRAININGCENTER-02: canonical generated training sessions
  trainingSessions                 TrainingSession[]
  // TRAININGCENTER-02: occurrence-level allocation overrides
  trainingSessionAllocations       TrainingSessionAllocation[]
  // TOURNAMENTCENTER-01B: canonical multi-team tournament participation and
  // tournament-level / per-participant facility allocations
  tournamentParticipants           TournamentParticipant[]
  tournamentResourceAllocations    TournamentResourceAllocation[]
  tournamentParticipantAllocations TournamentParticipantAllocation[]
  // WEEKPLANNER-01B: tenant-defined, week-scoped alternative planning
  // variants + their sparse resource-allocation overrides.
  weekplannerPlans                 WeekplannerPlan[]
  weekplannerPlanAllocations       WeekplannerPlanAllocation[]

  // RPERM-02
  tenantMemberships TenantMembership[]
  roles             Role[]
  userRoles         UserRole[]
  auditLogs         AuditLog[]

  @@index([status])
  @@index([name])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Slice 11.2b: tenantId added so the JWT can carry tenant context.
  // Nullable: legacy users are backfilled in 20260604064000_user_tenant_fk.
  // getDefaultTenant() retained as fallback only for seed/bootstrap paths.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  userRoles                     UserRole[]
  tenantMemberships             TenantMembership[]
  auditLogs                     AuditLog[]           @relation("AuditActor")
  assignedRegistrations         Registration[]       @relation("RegistrationAssignedUser")
  duplicateIgnoredRegistrations Registration[]       @relation("RegistrationDuplicateIgnoredBy")
  orgUnitMemberships            OrgUnitMembership[]
  reviewedHomepageSections      HomepageSection[]    @relation("HomepageSectionReviewer")
  approvedHomepageSections      HomepageSection[]    @relation("HomepageSectionApprovedBy")
  rejectedHomepageSections      HomepageSection[]    @relation("HomepageSectionRejectedBy")
  reviewedPageSections          WebsitePageSection[] @relation("PageSectionReviewer")
  approvedPageSections          WebsitePageSection[] @relation("PageSectionApprovedBy")
  rejectedPageSections          WebsitePageSection[] @relation("PageSectionRejectedBy")
  contentRevisions              ContentRevision[]
  createdReusableComponents     ReusableComponent[]  @relation("ReusableComponentCreatedBy")
  reviewedReusableComponents    ReusableComponent[]  @relation("ReusableComponentReviewer")
  approvedReusableComponents    ReusableComponent[]  @relation("ReusableComponentApprovedBy")
  rejectedReusableComponents    ReusableComponent[]  @relation("ReusableComponentRejectedBy")

  // Workspace
  createdWorkspaceFolders          WorkspaceFolder[]          @relation("WorkspaceFolderCreatedBy")
  updatedWorkspaceFolders          WorkspaceFolder[]          @relation("WorkspaceFolderUpdatedBy")
  createdWorkspaceDocuments        WorkspaceDocument[]        @relation("WorkspaceDocumentCreatedBy")
  updatedWorkspaceDocuments        WorkspaceDocument[]        @relation("WorkspaceDocumentUpdatedBy")
  createdWorkspaceDocumentVersions WorkspaceDocumentVersion[] @relation("WorkspaceDocumentVersionCreatedBy")

  @@index([isActive])
  @@index([tenantId])
}

model Registration {
  id String @id @default(cuid())

  tenantId String

  type   RegistrationType
  status RegistrationStatus @default(NEW)

  firstName String
  lastName  String
  email     String
  phone     String?
  birthDate DateTime?
  birthYear Int?

  message     String?
  payloadJson Json?
  source      String?

  assignedToUserId String?
  targetGroupId    String?

  // REGISTRATION-01F — Goal 2/3: canonical link from a registration to the
  // Person record it represents (existing match OR the Person created from
  // this registration via the "Create Person" workflow action).
  personId String?

  // REGISTRATION-01F — Goal 7: "Ignore duplicate" workflow action. The
  // existing possibleDuplicate/possibleDuplicateOf payloadJson flags (see
  // public-submission.ts) are unchanged; this only records that a
  // coordinator explicitly acknowledged and dismissed the warning.
  duplicateIgnoredAt   DateTime?
  duplicateIgnoredById String?

  // REGISTRATION-01F — Goal 6/8: timestamps for quick-action / timeline
  // derivation ("Contacted", "Archived") without re-deriving them from
  // AuditLog on every read.
  contactedAt DateTime?
  archivedAt  DateTime?

  submittedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignedToUser     User?        @relation("RegistrationAssignedUser", fields: [assignedToUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  targetGroup        TargetGroup? @relation(fields: [targetGroupId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  person             Person?      @relation("RegistrationPerson", fields: [personId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  duplicateIgnoredBy User?        @relation("RegistrationDuplicateIgnoredBy", fields: [duplicateIgnoredById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  // Back-relation for Person.createdRegistrationId — the Person record(s)
  // that were created from this registration (see Goal 3).
  createdPersons     Person[]     @relation("PersonCreatedFromRegistration")

  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@index([assignedToUserId])
  @@index([targetGroupId])
  @@index([tenantId, source])
  @@index([personId])
  @@index([duplicateIgnoredById])
}

model Role {
  id                              String   @id @default(cuid())
  key                             String   @unique
  name                            String
  description                     String?
  canAccessVereinsleitung         Boolean  @default(false)
  canAttendVereinsleitungMeetings Boolean  @default(false)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  // RPERM-02: tenant-aware role foundation
  scope      RoleScope @default(PLATFORM)
  tenantId   String?
  isSystem   Boolean   @default(false)
  isArchived Boolean   @default(false)
  // isTemplate: marks canonical template roles that are never directly assignable.
  // Used by club_admin seed record which serves as template only until RPERM-04.
  isTemplate Boolean   @default(false)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  userRoles                 UserRole[]
  rolePermissions           RolePermission[]
  workflowRules             RoleWorkflowRule[]
  workflowReviewAssignments RoleWorkflowReviewAssignment[] @relation("WorkflowReviewerRole")

  @@index([name])
  @@index([canAccessVereinsleitung])
  @@index([canAttendVereinsleitungMeetings])
  @@index([scope])
  @@index([tenantId])
  @@index([isSystem])
}

model Permission {
  id        String           @id @default(cuid())
  key       String           @unique
  name      String
  module    PermissionModule
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

