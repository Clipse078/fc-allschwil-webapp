generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PermissionModule {
  USERS
  SEASONS
  TEAMS
  PEOPLE
  EVENTS
  FIXTURES
  WOCHENPLAN
  NEWS
  WEBSITE
  INFOBOARD
  FUNCTIONS
  TARGETS
  MEETINGS
  INITIATIVES
  TEMPLATES
}

enum VisibilityScope {
  ORGANISATION
  RESTRICTED
  PRIVATE
}

enum CommunicationTemplateCategory {
  MATCH_INVITATION
  MEETING_FOLLOWUP
  INITIATIVE_UPDATE
  TARGET_PROGRESS
  TOURNAMENT_REMINDER
  GOVERNANCE_FOLLOWUP
  SPONSOR_OUTREACH
  PARENT_COMMUNICATION
  GENERAL
}

enum CommunicationTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MeetingStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum MeetingAgendaItemStatus {
  OPEN
  DISCUSSED
  SKIPPED
}

enum MeetingDecisionStatus {
  DRAFT
  CONFIRMED
  SUPERSEDED
}

enum MeetingActionStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum MeetingParticipantStatus {
  INVITED
  PRESENT
  ABSENT
  EXCUSED
}

enum InitiativeStatus {
  PLANNED
  IN_PROGRESS
  ON_TRACK
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TargetCategory {
  SPORTLICHE_ENTWICKLUNG
  MITGLIEDERWACHSTUM
  FINANZEN
  AUSBILDUNG
  MEDIEN_SOZIALES
  GOVERNANCE
}

enum TargetStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum TargetPeriod {
  SEASON
  QUARTER
  YEAR
  CUSTOM
}

enum TargetMetricType {
  PERCENTAGE
  NUMERIC
  CURRENCY
  BOOLEAN
}

enum TargetDirection {
  INCREASE
  DECREASE
  MAINTAIN
}

enum TeamCategory {
  KINDERFUSSBALL
  JUNIOREN
  AKTIVE
  FRAUEN
  SENIOREN
  TRAININGSGRUPPE
}

enum TeamSeasonStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PlayerSquadStatus {
  ACTIVE
  INACTIVE
  INJURED
  ABSENT
  ARCHIVED
}

enum TrainerTeamStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum EventType {
  MATCH
  TOURNAMENT
  TRAINING
  OTHER
  VACATION_PERIOD
}

enum EventSource {
  CLUBCORNER_FVNWS
  MANUAL
  CSV_EXCEL_IMPORT
  MUNICIPALITY_API
}

enum EventStatus {
  DRAFT
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
  POSTPONED
  ARCHIVED
}

enum EventImportRunStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum ReviewWorkflowStage {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PUBLISHED
}

enum WorkflowDomain {
  EVENTS
  SEASONS
  TEAMS
  PEOPLE
  USERS
  IMPORTS
  WEBSITE
  NEWS
  INFOBOARD
  WOCHENPLAN
  FIXTURES
  FUNCTIONS
  SESSION_SECURITY
  MEETINGS
  INITIATIVES
  TARGETS
}

enum WorkflowAction {
  CREATE
  UPDATE
  DELETE
  REVIEW
  APPROVE
  REJECT
  PUBLISH
  IMPORT
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  userRoles UserRole[]
  auditLogs AuditLog[] @relation("AuditActor")

  @@index([isActive])
}

model Role {
  id                              String   @id @default(cuid())
  key                             String   @unique
  name                            String
  description                     String?
  canAccessVereinsleitung         Boolean  @default(false)
  canAttendVereinsleitungMeetings Boolean  @default(false)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  userRoles                 UserRole[]
  rolePermissions           RolePermission[]
  workflowRules             RoleWorkflowRule[]
  workflowReviewAssignments RoleWorkflowReviewAssignment[] @relation("WorkflowReviewerRole")

  @@index([name])
  @@index([canAccessVereinsleitung])
  @@index([canAttendVereinsleitungMeetings])
}

model Permission {
  id        String           @id @default(cuid())
  key       String           @unique
  name      String
  module    PermissionModule
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  rolePermissions RolePermission[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model RoleWorkflowRule {
  id                 String         @id @default(cuid())
  roleId             String
  domain             WorkflowDomain
  action             WorkflowAction
  requiresReview     Boolean        @default(true)
  allowsDirectManage Boolean        @default(false)
  allowsReview       Boolean        @default(false)
  allowsApprove      Boolean        @default(false)
  allowsPublish      Boolean        @default(false)
  allowsSeriesReview Boolean        @default(false)
  isActive           Boolean        @default(true)
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  role              Role                           @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reviewAssignments RoleWorkflowReviewAssignment[]

  @@unique([roleId, domain, action])
  @@index([domain, action])
  @@index([isActive])
}

model RoleWorkflowReviewAssignment {
  id             String   @id @default(cuid())
  workflowRuleId String
  reviewerRoleId String
  isRequired     Boolean  @default(true)
  sortOrder      Int      @default(0)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workflowRule RoleWorkflowRule @relation(fields: [workflowRuleId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "RoleWorkflowReviewAssignment_workflowRuleId_fkey")
  reviewerRole Role             @relation("WorkflowReviewerRole", fields: [reviewerRoleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([workflowRuleId, reviewerRoleId])
  @@index([reviewerRoleId])
  @@index([sortOrder])
}

model Season {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamSeasons     TeamSeason[]
  events          Event[]
  eventImportRuns EventImportRun[]

  @@index([isActive])
}

model Person {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  displayName String?
  email       String?
  phone       String?
  dateOfBirth DateTime?
  notes       String?
  isActive    Boolean   @default(true)
  isPlayer    Boolean   @default(false)
  isTrainer   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  playerSquadMembers PlayerSquadMember[]
  trainerTeamMembers TrainerTeamMember[]

  @@index([lastName, firstName])
  @@index([email])
  @@index([isActive])
  @@index([isPlayer])
  @@index([isTrainer])
}

model Team {
  id               String       @id @default(cuid())
  name             String
  slug             String       @unique
  category         TeamCategory
  genderGroup      String?
  ageGroup         String?
  sortOrder        Int          @default(0)
  isActive         Boolean      @default(true)
  websiteVisible   Boolean      @default(true)
  infoboardVisible Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  teamSeasons     TeamSeason[]
  events          Event[]
  eventImportRuns EventImportRun[]

  @@index([category, sortOrder])
  @@index([isActive])
}

model TeamSeason {
  id                        String           @id @default(cuid())
  teamId                    String
  seasonId                  String
  displayName               String
  shortName                 String?
  status                    TeamSeasonStatus @default(ACTIVE)
  websiteVisible            Boolean          @default(true)
  infoboardVisible          Boolean          @default(true)
  squadWebsiteVisible       Boolean          @default(true)
  trainerTeamWebsiteVisible Boolean          @default(true)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  team               Team                @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  season             Season              @relation(fields: [seasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  playerSquadMembers PlayerSquadMember[]
  trainerTeamMembers TrainerTeamMember[]

  @@unique([teamId, seasonId])
  @@index([seasonId])
  @@index([status])
  @@index([squadWebsiteVisible])
  @@index([trainerTeamWebsiteVisible])
}

model PlayerSquadMember {
  id               String            @id @default(cuid())
  teamSeasonId     String
  personId         String
  status           PlayerSquadStatus @default(ACTIVE)
  shirtNumber      Int?
  positionLabel    String?
  isCaptain        Boolean           @default(false)
  isViceCaptain    Boolean           @default(false)
  isWebsiteVisible Boolean           @default(true)
  sortOrder        Int               @default(0)
  remarks          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  teamSeason TeamSeason @relation(fields: [teamSeasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  person     Person     @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([teamSeasonId, personId])
  @@index([personId])
  @@index([teamSeasonId, status])
  @@index([teamSeasonId, isWebsiteVisible])
  @@index([teamSeasonId, sortOrder])
}

model TrainerTeamMember {
  id               String            @id @default(cuid())
  teamSeasonId     String
  personId         String
  status           TrainerTeamStatus @default(ACTIVE)
  roleLabel        String?
  isWebsiteVisible Boolean           @default(true)
  sortOrder        Int               @default(0)
  remarks          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  teamSeason TeamSeason @relation(fields: [teamSeasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  person     Person     @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([teamSeasonId, personId])
  @@index([personId])
  @@index([teamSeasonId, status])
  @@index([teamSeasonId, isWebsiteVisible])
  @@index([teamSeasonId, sortOrder])
}

model Event {
  id       String      @id @default(cuid())
  seasonId String
  teamId   String?
  type     EventType
  source   EventSource
  status   EventStatus @default(SCHEDULED)

  reviewStage       ReviewWorkflowStage @default(DRAFT)
  reviewRequestedAt DateTime?
  reviewedAt        DateTime?
  publishedAt       DateTime?
  reviewNotes       String?
  createdByUserId   String?
  reviewedByUserId  String?
  approvedByUserId  String?
  rejectedByUserId  String?
  publishedByUserId String?

  title       String
  description String?
  location    String?

  startAt DateTime
  endAt   DateTime?

  externalSource   String?
  externalSourceId String?
  importBatchKey   String?
  lastSyncedAt     DateTime?

  opponentName     String?
  organizerName    String?
  competitionLabel String?
  homeAway         String?
  resultLabel      String?
  meetingTime      DateTime?

  websiteVisible       Boolean @default(true)
  infoboardVisible     Boolean @default(false)
  homepageVisible      Boolean @default(false)
  wochenplanVisible    Boolean @default(false)
  trainingsplanVisible Boolean @default(false)
  teamPageVisible      Boolean @default(false)

  sortOrder Int     @default(0)
  remarks   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  team   Team?  @relation(fields: [teamId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([seasonId, type])
  @@index([teamId, type])
  @@index([startAt])
  @@index([status])
  @@index([source])
  @@index([reviewStage])
  @@index([reviewRequestedAt])
  @@index([publishedAt])
  @@index([websiteVisible])
  @@index([infoboardVisible])
  @@index([wochenplanVisible])
  @@index([trainingsplanVisible])
  @@index([teamPageVisible])
  @@index([externalSource, externalSourceId])
  @@index([importBatchKey])
}

model EventImportRun {
  id       String               @id @default(cuid())
  source   EventSource
  status   EventImportRunStatus @default(PENDING)
  type     EventType?
  seasonId String?
  teamId   String?

  importBatchKey String    @unique
  fileName       String?
  startedAt      DateTime?
  finishedAt     DateTime?

  rowsDetected Int @default(0)
  rowsCreated  Int @default(0)
  rowsUpdated  Int @default(0)
  rowsSkipped  Int @default(0)
  rowsFailed   Int @default(0)

  summary      String?
  errorMessage String?
  metadataJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([source, status])
  @@index([type])
  @@index([seasonId])
  @@index([teamId])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  moduleKey    String
  entityType   String
  entityId     String
  action       String
  beforeJson   Json?
  afterJson    Json?
  metadataJson Json?
  createdAt    DateTime @default(now())

  actorUser User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([moduleKey])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Visibility/Access Architecture TODO — Initiative
//
// CURRENT STATE: all Initiative records are visible to every authenticated user.
// This is NOT safe for sensitive content (e.g. confidential restructuring plans,
// personnel decisions, financial initiatives).
//
// PHASE 2 — add a VisibilityScope enum and granular allowlist fields:
//
//   enum VisibilityScope { ORGANISATION  RESTRICTED  PRIVATE }
//     ORGANISATION: visible to all authenticated members (current default)
//     RESTRICTED:   visible to users matching at least one of the allow-sets below
//     PRIVATE:      visible only to the creator and explicitly listed persons
//
//   visibilityScope     VisibilityScope @default(ORGANISATION)
//   createdByUserId     String?         // ownership; set at creation time
//   allowedOrgUnitIds   Json?           // [String]  — future OrgUnit model
//   allowedRoleKeys     Json?           // [String]  — Role.key values
//   allowedTeamIds      Json?           // [String]  — Team.id values
//   allowedPersonIds    Json?           // [String]  — Person/User id values
//
// API impact: getMeetings() / getInitiatives() and their PATCH endpoints must
// filter by visibilityScope at query time, injecting the actor's orgUnit/role/team
// context. Detail-page slug lookups must enforce the same check and return 403/404
// for records outside the actor's visibility set.
//
// UX impact: list pages should NOT reveal the existence of PRIVATE or RESTRICTED
// records (no "X hidden items" counter) to users outside the allowlist.
// ---------------------------------------------------------------------------
model Initiative {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  summary     String?
  description String?
  status      InitiativeStatus @default(PLANNED)
  owner       String?
  progress    Int?
  dueDate     DateTime?

  // Governance — consistent with Meeting and Target governance pattern
  reviewStage           ReviewWorkflowStage @default(DRAFT)
  requiresFourEyeReview Boolean             @default(false)
  reviewedByUserId      String?
  reviewedAt            DateTime?

  // Visibility / access control
  visibilityScope    VisibilityScope @default(ORGANISATION)
  createdByUserId    String?
  visibleRoleRefs    Json?
  visibleUserRefs    Json?
  visibleTeamRefs    Json?
  visibleOrgUnitRefs Json?
  visiblePersonRefs  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([reviewStage])
  @@index([dueDate])
  @@index([visibilityScope])
}

// ---------------------------------------------------------------------------
// Visibility/Access Architecture TODO — Meeting
//
// CURRENT STATE: all Meeting records are visible to every authenticated user.
// Board meetings discussing personnel, financials, or disciplinary matters
// MUST eventually support RESTRICTED or PRIVATE scopes so that e.g. the
// president and Kassier can document a confidential topic without it appearing
// in the meeting list of a trainer or website publisher.
//
// Intended design mirrors Confluence-style page restrictions:
//   - Creator sets visibility at creation time (ORGANISATION / RESTRICTED / PRIVATE)
//   - RESTRICTED: explicit allowlist of OrgUnit, Role, Team, or Person
//   - PRIVATE: creator + explicitly named persons only
//
// Schema fields to add in Phase 2 (see Initiative model comment for full spec):
//   visibilityScope     VisibilityScope @default(ORGANISATION)
//   createdByUserId     String?
//   allowedOrgUnitIds   Json?
//   allowedRoleKeys     Json?
//   allowedTeamIds      Json?
//   allowedPersonIds    Json?
//
// Until Phase 2 is implemented: do NOT record sensitive meeting content in the DB.
// ---------------------------------------------------------------------------
model Meeting {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  description   String?
  meetingDate   DateTime
  location      String?
  attendeeCount Int?
  status        MeetingStatus @default(PLANNED)

  // Governance — consistent with Target governance pattern
  reviewStage           ReviewWorkflowStage @default(DRAFT)
  requiresFourEyeReview Boolean             @default(false)
  reviewedByUserId      String?
  reviewedAt            DateTime?

  // Visibility / access control
  visibilityScope    VisibilityScope @default(ORGANISATION)
  createdByUserId    String?
  // String[] stored as JSON — role keys, user IDs, team IDs, org unit IDs, person IDs
  visibleRoleRefs    Json?
  visibleUserRefs    Json?
  visibleTeamRefs    Json?
  visibleOrgUnitRefs Json?
  visiblePersonRefs  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agendaItems  MeetingAgendaItem[]
  decisions    MeetingDecision[]
  actions      MeetingAction[]
  participants MeetingParticipant[]

  @@index([meetingDate])
  @@index([status])
  @@index([reviewStage])
  @@index([visibilityScope])
}

model CommunicationTemplate {
  id           String                        @id @default(cuid())
  slug         String                        @unique
  title        String
  category     CommunicationTemplateCategory @default(GENERAL)
  status       CommunicationTemplateStatus   @default(DRAFT)
  subject      String
  bodyMarkdown String
  moduleKey    String?
  variableRefs Json?

  // Governance
  reviewStage           ReviewWorkflowStage @default(DRAFT)
  requiresFourEyeReview Boolean             @default(false)
  reviewedByUserId      String?
  reviewedAt            DateTime?

  // Visibility
  visibilityScope VisibilityScope @default(ORGANISATION)
  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([moduleKey])
  @@index([reviewStage])
}

model MeetingAgendaItem {
  id              String                  @id @default(cuid())
  meetingId       String
  title           String
  notes           String?
  owner           String?
  durationMin     Int?
  orderIndex      Int                     @default(0)
  status          MeetingAgendaItemStatus @default(OPEN)
  createdByUserId String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([meetingId, orderIndex])
}

model MeetingDecision {
  id              String                @id @default(cuid())
  meetingId       String
  title           String
  description     String?
  status          MeetingDecisionStatus @default(CONFIRMED)
  owner           String?
  orderIndex      Int                   @default(0)
  linkedRefs      Json?
  createdByUserId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([meetingId, orderIndex])
}

model MeetingAction {
  id              String              @id @default(cuid())
  meetingId       String
  title           String
  owner           String?
  dueDate         DateTime?
  status          MeetingActionStatus @default(OPEN)
  linkedRefs      Json?
  createdByUserId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([meetingId])
  @@index([meetingId, status])
}

model MeetingParticipant {
  id        String                   @id @default(cuid())
  meetingId String
  name      String
  role      String?
  status    MeetingParticipantStatus @default(INVITED)
  userId    String?
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([meetingId])
  @@index([meetingId, userId])
}

model Target {
  id            String         @id @default(cuid())
  title         String
  description   String?
  category      TargetCategory @default(SPORTLICHE_ENTWICKLUNG)
  status        TargetStatus   @default(ACTIVE)
  period        TargetPeriod   @default(SEASON)
  periodLabel   String?
  moduleKey     String?
  sportCategory String?
  ageGroupHint  String?
  startsAt      DateTime?
  endsAt        DateTime?
  nudgeJson     Json?

  // Governance foundation — consistent with Event.reviewStage pattern
  reviewStage           ReviewWorkflowStage @default(DRAFT)
  requiresFourEyeReview Boolean             @default(false)
  reviewedByUserId      String?
  reviewedAt            DateTime?

  // Cross-module linking (phase 1: slug/title refs; phase 2: proper FK relations)
  // Stored as [{slug, title, url?}][] — validated by lib/linking/helpers.ts
  linkedInitiativeRefs Json?
  linkedMeetingRefs    Json?

  // Visibility / access control — consistent with Meeting and Initiative pattern
  visibilityScope    VisibilityScope @default(ORGANISATION)
  createdByUserId    String?
  visibleRoleRefs    Json?
  visibleUserRefs    Json?
  visibleTeamRefs    Json?
  visibleOrgUnitRefs Json?
  visiblePersonRefs  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metrics TargetMetric[]

  @@index([category])
  @@index([status])
  @@index([period])
  @@index([reviewStage])
  @@index([visibilityScope])
}

model TargetMetric {
  id           String           @id @default(cuid())
  targetId     String
  label        String
  type         TargetMetricType @default(PERCENTAGE)
  direction    TargetDirection  @default(INCREASE)
  targetValue  Float
  currentValue Float            @default(0)
  unit         String?
  notes        String?
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  target     Target            @relation(fields: [targetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  dataPoints TargetDataPoint[]

  @@index([targetId])
  @@index([targetId, sortOrder])
}

model TargetDataPoint {
  id         String   @id @default(cuid())
  metricId   String
  value      Float
  note       String?
  measuredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  metric TargetMetric @relation(fields: [metricId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([metricId])
  @@index([measuredAt])
}
