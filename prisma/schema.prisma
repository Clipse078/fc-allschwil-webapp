model Event {
  id       String      @id @default(cuid())
  seasonId String
  teamId   String?
  type     EventType
  source   EventSource
  status   EventStatus @default(SCHEDULED)

  reviewStage       ReviewWorkflowStage @default(DRAFT)
  reviewRequestedAt DateTime?
  reviewedAt        DateTime?
  publishedAt       DateTime?
  reviewNotes       String?
  createdByUserId   String?
  reviewedByUserId  String?
  approvedByUserId  String?
  rejectedByUserId  String?
  publishedByUserId String?

  title       String
  description String?
  location    String?

  startAt DateTime
  endAt   DateTime?

  externalSource   String?
  externalSourceId String?
  importBatchKey   String?
  lastSyncedAt     DateTime?

  opponentName            String?
  organizerName           String?
  competitionLabel        String?
  homeAway                String?
  resultLabel             String?
  /// Live or half-time intermediate score label (e.g. "1:0 (HZ)").
  /// Set and updated exclusively by match-detail synchronization (Slice 3C).
  /// Null until a detail sync has been run and an intermediate result is available.
  intermediateResultLabel String?
  meetingTime             DateTime?

  websiteVisible       Boolean @default(true)
  infoboardVisible     Boolean @default(false)
  homepageVisible      Boolean @default(false)
  wochenplanVisible    Boolean @default(false)
  trainingsplanVisible Boolean @default(false)
  teamPageVisible      Boolean @default(false)

  sortOrder Int     @default(0)
  remarks   String?

  // Wochenplan pitch + dressing-room allocation (Week Planner V1)
  pitchCode            String?
  homeDressingRoomCode String?
  awayDressingRoomCode String?

  // Tenant isolation (nullable: backward-compat with seed/legacy events)
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season               Season                @relation(fields: [seasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  team                 Team?                 @relation(fields: [teamId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  matchExternalMapping MatchExternalMapping?

  // TOURNAMENTCENTER-01B: canonical multi-team participation and
  // tournament-level facility allocations for Event rows with
  // type=TOURNAMENT (see lib/tournaments/). Empty for every other Event
  // type — never populated or read outside the TournamentCenter domain.
  tournamentParticipants        TournamentParticipant[]
  tournamentResourceAllocations TournamentResourceAllocation[]

  @@index([seasonId, type])
  @@index([teamId, type])
  @@index([startAt])
  @@index([status])
  @@index([source])
  @@index([reviewStage])
  @@index([reviewRequestedAt])
  @@index([publishedAt])
  @@index([websiteVisible])
  @@index([infoboardVisible])
  @@index([wochenplanVisible])
  @@index([trainingsplanVisible])
  @@index([teamPageVisible])
  @@index([externalSource, externalSourceId])
  @@index([tenantId])
  @@index([importBatchKey])
  @@index([pitchCode])
}

