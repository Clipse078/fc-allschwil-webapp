  websiteVisible   Boolean      @default(true)
  infoboardVisible Boolean      @default(true)
  // @deprecated orgUnitId — legacy single OrgUnit link. Retained for backward
  //   compatibility. New canonical relationship is TeamSeasonOrgUnit (many-to-many).
  //   Do not use for new business logic. Removal planned after full migration.
  orgUnitId        String?

  // Tenant isolation (nullable: backward-compat; backfill in 20260626000000_team_tenant_isolation)
  tenantId         String?
  tenant           Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  teamSeasons             TeamSeason[]
  events                  Event[]
  eventImportRuns         EventImportRun[]
  orgUnit                 OrgUnit?               @relation(fields: [orgUnitId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  externalMappings        TeamExternalMapping[]
  homeMatchMappings       MatchExternalMapping[] @relation("MatchHomeTeam")
  awayMatchMappings       MatchExternalMapping[] @relation("MatchAwayTeam")

  @@unique([tenantId, slug])
  @@index([category, sortOrder])
  @@index([isActive])
  @@index([orgUnitId])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// TeamExternalMapping — external-provider identity for a Team.
//
// Holds the mapping between a canonical SportClubEvo Team and a record in an
// external provider (e.g. SFV / ClubCorner). One mapping row per provider +
// external team + season + tenant combination.
//
// Team remains the canonical entity owned by Organisation Builder.
// SFV is an external provider. This model links the two without coupling Team
// to any provider-specific column.
//
// Future providers (e.g. Fussball.ch, licencing systems) add their own rows
// without schema changes to Team.
// ---------------------------------------------------------------------------

model TeamExternalMapping {
  id                   String   @id @default(cuid())
  /// Owning tenant. Scopes all lookups and mutations to a single tenant.
  tenantId             String
  /// The canonical Team this mapping belongs to.
  teamId               String
  /// External provider identifier, e.g. "SFV".
  provider             String
  /// Provider-assigned team identifier (e.g. SFV teamId integer).
  externalTeamId       Int
  /// Provider-assigned season identifier used at time of sync (e.g. SFV seasonId integer).
  externalSeasonId     Int
  /// Provider-reported team name at time of last sync.
  providerTeamName     String?
  /// Provider-reported league identifier at time of last sync.
  providerLeagueId     Int?
  /// Provider-reported league name at time of last sync.
  providerLeagueName   String?
  /// Provider-reported organisation identifier at time of last sync.
  providerOrganisationId Int?
  /// Whether the provider reports this team as active.
  providerIsActive     Boolean  @default(true)
  /// Timestamp of the last successful sync that touched this mapping.
  lastSyncedAt         DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  /// Preferred seasonal link (TEAM-CORE-02). Nullable during transition.
  /// When set, teamSeason.teamId MUST equal teamId and externalSeasonId MUST
  /// correspond to the TeamSeason's season. Null for historical rows or when
  /// resolution is ambiguous (multiple matching TeamSeasons).
  teamSeasonId         String?

  // ── TEAM-PROVIDER-01: canonical provider mapping workflow ─────────────────
  /// How this mapping was created.
  /// "SYNC" = created automatically by provider sync.
  /// "MANUAL" = created explicitly by an administrator through the mapping workflow.
  mappingSource        String   @default("SYNC")
  /// Suggestion-engine confidence level at the time of creation or last suggestion.
  /// "HIGH" | "MEDIUM" | "LOW" — null for SYNC-created rows and for confirmed
  /// manual mappings where confidence is not applicable.
  confidenceLevel      String?
  /// Competition ID used as context when this mapping was created.
  /// Assists traceability — Competition does NOT own the provider mapping.
  mappingCompetitionId String?

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  team       Team        @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  teamSeason TeamSeason? @relation(fields: [teamSeasonId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  /// The Competition used as mapping context (TEAM-PROVIDER-01). Does NOT mean
  /// Competition owns the mapping — it is informational context only.
  mappingCompetition Competition? @relation("TeamExternalMappingCompetition", fields: [mappingCompetitionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Prevents duplicate mappings for the same external team/season/provider/tenant.
  @@unique([tenantId, provider, externalTeamId, externalSeasonId])
  @@index([tenantId, provider])
  @@index([teamId])
  @@index([teamSeasonId])
  @@index([providerIsActive])
  @@index([mappingSource])
  @@index([mappingCompetitionId])
}

model TeamSeason {
