// ---------------------------------------------------------------------------
// TeamSeasonOrgUnit — canonical many-to-many join between TeamSeason and OrgUnit
//
// TEAM-CORE-02: replaces the legacy single Team.orgUnitId link.
//
// Architecture invariants:
//   - One TeamSeason may belong to multiple OrgUnits (e.g. Junioren + Aktive).
//   - One OrgUnit may contain multiple TeamSeasons across seasons.
//   - Duplicate (teamSeasonId, orgUnitId) is prevented at DB level.
//   - tenantId must match both the TeamSeason tenant and the OrgUnit tenant.
//   - Archived OrgUnits remain historically linked (no retroactive removal).
//   - Service layer must reject archived OrgUnits for NEW assignments.
//   - onDelete: Restrict on orgUnit prevents silent deletion of historical links.
//     OrgUnit archival is preferred over deletion to preserve history.
//   - onDelete: Cascade on teamSeason cascades with the seasonal record.
//
// Legacy compatibility:
//   - Team.orgUnitId is kept as a deprecated transitional field.
//   - Existing single-OrgUnit data is backfilled into this table on migration.
//
// Eligibility rules (enforced at service layer, not DB):
//   - OrgUnit must belong to the same tenant.
//   - OrgUnit must be ACTIVE (not ARCHIVED or INACTIVE) for new assignments.
// ---------------------------------------------------------------------------
model TeamSeasonOrgUnit {
  id           String   @id @default(cuid())
  tenantId     String
  teamSeasonId String
  orgUnitId    String
  /// When true, this OrgUnit is the primary grouping for display purposes.
  /// At most one row per TeamSeason should have isPrimary = true.
  isPrimary    Boolean  @default(false)
  /// Controls display order when a TeamSeason belongs to multiple OrgUnits.
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  teamSeason TeamSeason @relation(fields: [teamSeasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// Restrict prevents silent deletion of historical TeamSeason→OrgUnit links.
  /// Archive OrgUnits instead of deleting them to preserve history.
  orgUnit    OrgUnit    @relation(fields: [orgUnitId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([teamSeasonId, orgUnitId])
  @@index([tenantId])
  @@index([teamSeasonId])
  @@index([orgUnitId])
  @@index([tenantId, isPrimary])
}

