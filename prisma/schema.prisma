generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// Website Management Foundation — publish mode for the tenant's public website.
// DRAFT  = website content is not yet promoted to public.
// STAGED = content is ready for review / QA; not fully live to all visitors.
// LIVE   = website is fully live and public.
enum WebsitePublishMode {
  DRAFT
  STAGED
  LIVE
}

enum NewsArticleStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum WebsitePageStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum MediaAssetType {
  IMAGE
  VIDEO
}

enum MediaAssetStatus {
  ACTIVE
  ARCHIVED
}

enum PermissionModule {
  USERS
  SEASONS
  TEAMS
  PEOPLE
  EVENTS
  FIXTURES
  WOCHENPLAN
  NEWS
  WEBSITE
  INFOBOARD
  FUNCTIONS
  TARGETS
  MEETINGS
  INITIATIVES
  TEMPLATES
  REGISTRATIONS
  TENANTS
  ORG
  FACILITIES
}

enum FacilityType {
  PITCH
  DRESSING_ROOM_BLOCK
  INDOOR_HALL
  OTHER
}

enum FacilityResourceType {
  FULL_PITCH
  HALF_PITCH
  DRESSING_ROOM
  OTHER
}

enum FacilityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum RegistrationType {
  PROBETRAINING
  SPIELERANMELDUNG
  TRAINERANMELDUNG
  SPONSORANFRAGE
  KONTAKTANFRAGE
  OTHER
}

enum RegistrationStatus {
