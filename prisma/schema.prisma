enum WorkflowDomain {
  EVENTS
  SEASONS
  TEAMS
  PEOPLE
  USERS
  IMPORTS
  WEBSITE
  NEWS
  INFOBOARD
  WOCHENPLAN
  FIXTURES
  FUNCTIONS
  SESSION_SECURITY
  MEETINGS
  INITIATIVES
  TARGETS
}

enum WorkflowAction {
  CREATE
  UPDATE
  DELETE
  REVIEW
  APPROVE
  REJECT
  PUBLISH
  IMPORT
}

model Tenant {
  id        String       @id @default(cuid())
  key       String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Config v1 — Slice 10.2
  // String fields are nullable: no opinionated DB default for white-label safety.
  // Seed sets explicit values for fc-allschwil. New tenants start with nulls.
  countryCode           String?
  sportCategory         String?
  locale                String?
  timezone              String?
  currency              String?
  // Season integers have a neutral structural default (August 1st European convention).
  seasonStartMonth      Int    @default(8)
  seasonTransitionDay   Int    @default(1)
  seasonTransitionMonth Int    @default(8)

  // Branding v1 — Slice 10.6
  // All nullable: no DB default for white-label safety.
  // Application code falls back to SportClubEvo defaults when null.
  // primaryColor / secondaryColor: 6-digit hex (#rrggbb); validated at API layer.
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?

  // Website integration flags — Slice 4 (News Detail Endpoint)
  // websiteEnabled: gates all /api/public/v1/website/* endpoints for this tenant.
  // approvedDataOnly: when true, only content that has passed editorial approval
  //   is surfaced on the public website feed. Defaults false for backward-compat.
  websiteEnabled   Boolean @default(true)
  approvedDataOnly Boolean @default(false)

  // Website Management Foundation — extended configuration fields.
  // websiteBaseUrl: public-facing base URL for the tenant's website (e.g. "https://fc-allschwil.ch").
  // websitePrimaryLanguage: BCP 47 language tag for the website default language (e.g. "de", "fr").
  // websitePublishMode: current publish mode — DRAFT / STAGED / LIVE.
  // websiteLastPublishedAt: timestamp of the most recent publish action (any content type).
  // websiteCacheStrategy: hint for cache/revalidation strategy (e.g. "ISR", "on-demand", "disabled").
  //   Placeholder — not enforced at the API layer yet; reserved for Phase 4 cache integration.
  websiteBaseUrl            String?             @db.VarChar(2048)
  websitePrimaryLanguage    String?             @db.VarChar(10)
  websitePublishMode        WebsitePublishMode  @default(DRAFT)
  websiteLastPublishedAt    DateTime?
  websiteCacheStrategy      String?             @db.VarChar(64)

  registrations          Registration[]
  users                  User[]
  events                 Event[]
  facilities             Facility[]
  facilityResources      FacilityResource[]
  wochenplanPublications WochenplanPublication[]
  newsArticles           NewsArticle[]
  mediaAssets            MediaAsset[]
  newsArticleMedia       NewsArticleMedia[]
  websitePages           WebsitePage[]

  @@index([status])
  @@index([name])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Slice 11.2b: tenantId added so the JWT can carry tenant context.
  // Nullable: legacy users are backfilled in 20260604064000_user_tenant_fk.
  // getDefaultTenant() retained as fallback only for seed/bootstrap paths.
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  userRoles             UserRole[]
  auditLogs             AuditLog[]      @relation("AuditActor")
  assignedRegistrations Registration[]  @relation("RegistrationAssignedUser")
  orgUnitMemberships    OrgUnitMembership[]

  @@index([isActive])
  @@index([tenantId])
}

model Registration {
  id String @id @default(cuid())

  tenantId String

  type   RegistrationType
  status RegistrationStatus @default(NEW)

  firstName String
  lastName  String
  email     String
  phone     String?
  birthDate DateTime?
  birthYear Int?

  message     String?
  payloadJson Json?
  source      String?

  assignedToUserId String?
  targetGroupId    String?

  submittedAt DateTime @default(now())

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignedToUser User?        @relation("RegistrationAssignedUser", fields: [assignedToUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  targetGroup    TargetGroup? @relation(fields: [targetGroupId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@index([assignedToUserId])
  @@index([targetGroupId])
}

model Role {
  id                              String   @id @default(cuid())
  key                             String   @unique
  name                            String
  description                     String?
  canAccessVereinsleitung         Boolean  @default(false)
  canAttendVereinsleitungMeetings Boolean  @default(false)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  userRoles                 UserRole[]
  rolePermissions           RolePermission[]
  workflowRules             RoleWorkflowRule[]
  workflowReviewAssignments RoleWorkflowReviewAssignment[] @relation("WorkflowReviewerRole")

  @@index([name])
  @@index([canAccessVereinsleitung])
  @@index([canAttendVereinsleitungMeetings])
}

model Permission {
  id        String           @id @default(cuid())
  key       String           @unique
  name      String
  module    PermissionModule
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  rolePermissions RolePermission[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model RoleWorkflowRule {
  id                 String         @id @default(cuid())
  roleId             String
  domain             WorkflowDomain
  action             WorkflowAction
  requiresReview     Boolean        @default(true)
  allowsDirectManage Boolean        @default(false)
  allowsReview       Boolean        @default(false)
  allowsApprove      Boolean        @default(false)
  allowsPublish      Boolean        @default(false)
  allowsSeriesReview Boolean        @default(false)
  isActive           Boolean        @default(true)
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  role              Role                           @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reviewAssignments RoleWorkflowReviewAssignment[]

  @@unique([roleId, domain, action])
  @@index([domain, action])
  @@index([isActive])
}

model RoleWorkflowReviewAssignment {
  id             String   @id @default(cuid())
  workflowRuleId String
  reviewerRoleId String
  isRequired     Boolean  @default(true)
  sortOrder      Int      @default(0)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workflowRule RoleWorkflowRule @relation(fields: [workflowRuleId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "RoleWorkflowReviewAssignment_workflowRuleId_fkey")
  reviewerRole Role             @relation("WorkflowReviewerRole", fields: [reviewerRoleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([workflowRuleId, reviewerRoleId])
  @@index([reviewerRoleId])
  @@index([sortOrder])
}

model Season {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamSeasons        TeamSeason[]
  events             Event[]
  eventImportRuns    EventImportRun[]
  orgUnitMemberships OrgUnitMembership[]

  @@index([isActive])
}

model Person {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  displayName String?
  email       String?
  phone       String?
  dateOfBirth DateTime?
  notes       String?
  isActive    Boolean   @default(true)
  isPlayer    Boolean   @default(false)
  isTrainer   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  playerSquadMembers   PlayerSquadMember[]
  trainerTeamMembers   TrainerTeamMember[]
  orgUnitMemberships   OrgUnitMembership[]
  authoredNewsArticles NewsArticle[]       @relation("NewsArticleAuthorPerson")
  authoredWebsitePages WebsitePage[]       @relation("WebsitePageAuthorPerson")

  @@index([lastName, firstName])
  @@index([email])
  @@index([isActive])
  @@index([isPlayer])
  @@index([isTrainer])
}

model Team {
  id               String       @id @default(cuid())
  name             String
  slug             String       @unique
  category         TeamCategory
  genderGroup      String?
  ageGroup         String?
  sortOrder        Int          @default(0)
  isActive         Boolean      @default(true)
  websiteVisible   Boolean      @default(true)
  infoboardVisible Boolean      @default(true)
  orgUnitId        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  teamSeasons     TeamSeason[]
  events          Event[]
  eventImportRuns EventImportRun[]
  orgUnit         OrgUnit?     @relation(fields: [orgUnitId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([category, sortOrder])
  @@index([isActive])
  @@index([orgUnitId])
}

model TeamSeason {
  id                        String           @id @default(cuid())
  teamId                    String
  seasonId                  String
  displayName               String
  shortName                 String?
  status                    TeamSeasonStatus @default(ACTIVE)
  websiteVisible            Boolean          @default(true)
  infoboardVisible          Boolean          @default(true)
  squadWebsiteVisible       Boolean          @default(true)
  trainerTeamWebsiteVisible Boolean          @default(true)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  team               Team                @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  season             Season              @relation(fields: [seasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  playerSquadMembers PlayerSquadMember[]
  trainerTeamMembers TrainerTeamMember[]

  @@unique([teamId, seasonId])
  @@index([seasonId])
  @@index([status])
  @@index([squadWebsiteVisible])
  @@index([trainerTeamWebsiteVisible])
}

model PlayerSquadMember {
  id               String            @id @default(cuid())
  teamSeasonId     String
  personId         String
  status           PlayerSquadStatus @default(ACTIVE)
  shirtNumber      Int?
  positionLabel    String?
  isCaptain        Boolean           @default(false)
  isViceCaptain    Boolean           @default(false)
  isWebsiteVisible Boolean           @default(true)
  sortOrder        Int               @default(0)
  remarks          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  teamSeason TeamSeason @relation(fields: [teamSeasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  person     Person     @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([teamSeasonId, personId])
  @@index([personId])
  @@index([teamSeasonId, status])
  @@index([teamSeasonId, isWebsiteVisible])
  @@index([teamSeasonId, sortOrder])
}

model TrainerTeamMember {
  id               String            @id @default(cuid())
  teamSeasonId     String
  personId         String
  status           TrainerTeamStatus @default(ACTIVE)
  roleLabel        String?
  isWebsiteVisible Boolean           @default(true)
  sortOrder        Int               @default(0)
  remarks          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  teamSeason TeamSeason @relation(fields: [teamSeasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  person     Person     @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([teamSeasonId, personId])
  @@index([personId])
  @@index([teamSeasonId, status])
  @@index([teamSeasonId, isWebsiteVisible])
  @@index([teamSeasonId, sortOrder])
}

model Event {
  id       String      @id @default(cuid())
  seasonId String
  teamId   String?
  type     EventType
  source   EventSource
  status   EventStatus @default(SCHEDULED)

  reviewStage       ReviewWorkflowStage @default(DRAFT)
  reviewRequestedAt DateTime?
  reviewedAt        DateTime?
  publishedAt       DateTime?
  reviewNotes       String?
  createdByUserId   String?
  reviewedByUserId  String?
  approvedByUserId  String?
  rejectedByUserId  String?
  publishedByUserId String?

  title       String
  description String?
  location    String?

  startAt DateTime
  endAt   DateTime?

  externalSource   String?
  externalSourceId String?
  importBatchKey   String?
  lastSyncedAt     DateTime?

  opponentName     String?
  organizerName    String?
  competitionLabel String?
  homeAway         String?
  resultLabel      String?
  meetingTime      DateTime?

  websiteVisible       Boolean @default(true)
  infoboardVisible     Boolean @default(false)
  homepageVisible      Boolean @default(false)
  wochenplanVisible    Boolean @default(false)
  trainingsplanVisible Boolean @default(false)
  teamPageVisible      Boolean @default(false)

  sortOrder Int     @default(0)
  remarks   String?

  // Wochenplan pitch + dressing-room allocation (Week Planner V1)
  pitchCode             String?
  homeDressingRoomCode  String?
  awayDressingRoomCode  String?

  // Tenant isolation (nullable: backward-compat with seed/legacy events)
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  team   Team?  @relation(fields: [teamId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([seasonId, type])
  @@index([teamId, type])
  @@index([startAt])
  @@index([status])
  @@index([source])
  @@index([reviewStage])
  @@index([reviewRequestedAt])
  @@index([publishedAt])
  @@index([websiteVisible])
  @@index([infoboardVisible])
  @@index([wochenplanVisible])
  @@index([trainingsplanVisible])
  @@index([teamPageVisible])
  @@index([externalSource, externalSourceId])
  @@index([tenantId])
  @@index([importBatchKey])
  @@index([pitchCode])
}

model EventImportRun {
  id       String               @id @default(cuid())
  source   EventSource
  status   EventImportRunStatus @default(PENDING)
  type     EventType?
  seasonId String?
  teamId   String?

  importBatchKey String    @unique
  fileName       String?
  startedAt      DateTime?
  finishedAt     DateTime?

  rowsDetected Int @default(0)
  rowsCreated  Int @default(0)
  rowsUpdated  Int @default(0)
  rowsSkipped  Int @default(0)
  rowsFailed   Int @default(0)

  summary      String?
  errorMessage String?
  metadataJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([source, status])
  @@index([type])
  @@index([seasonId])
  @@index([teamId])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  moduleKey    String
  entityType   String
  entityId     String
  action       String
  beforeJson   Json?
  afterJson    Json?
  metadataJson Json?
  createdAt    DateTime @default(now())

  actorUser User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([moduleKey])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Initiative — Visibility / Governance
//
// Visibility is implemented: VisibilityScope (ORGANISATION / RESTRICTED / PRIVATE)
// enforced by canSeeEntity() in lib/visibility/visibility-filter.ts.
// ActorContext is hydrated with orgUnitIds via getActorContext().
//
// Roadmap:
//   - visibleTeamRefs / visiblePersonRefs: requires teamIds / personId on ActorContext
//   - PRIVATE non-creator allowlist: DB WHERE needs JSONB @> (Phase 2)
//   - Reviewer role validation via RoleWorkflowReviewAssignment (Phase 2)
// ---------------------------------------------------------------------------
model Initiative {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  summary     String?
  description String?
  status      InitiativeStatus @default(PLANNED)
  owner       String?
  progress    Int?
  dueDate     DateTime?

  // Governance — consistent with Meeting and Target governance pattern
  reviewStage           ReviewWorkflowStage @default(DRAFT)
  requiresFourEyeReview Boolean             @default(false)
  reviewedByUserId      String?
  reviewedAt            DateTime?

  // Visibility / access control
  visibilityScope        VisibilityScope @default(ORGANISATION)
  createdByUserId        String?
  visibleRoleRefs        Json?
  visibleUserRefs        Json?
  visibleTeamRefs        Json?
  visibleOrgUnitRefs     Json?
  visiblePersonRefs      Json?
  // Phase D — TargetGroup visibility: resolved target group members can see this entity.
  visibleTargetGroupRefs Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([reviewStage])
  @@index([dueDate])
  @@index([visibilityScope])
}

// ---------------------------------------------------------------------------
// Meeting — Visibility / Governance
//
// Visibility is implemented: VisibilityScope (ORGANISATION / RESTRICTED / PRIVATE)
// enforced by canSeeEntity() in lib/visibility/visibility-filter.ts.
// RESTRICTED allowlist includes org units, roles, and users.
//
// Roadmap:
//   - visibleTeamRefs / visiblePersonRefs: requires teamIds / personId on ActorContext
//   - PRIVATE non-creator allowlist: DB WHERE needs JSONB @> (Phase 2)
//   - Reviewer role validation via RoleWorkflowReviewAssignment (Phase 2)
// ---------------------------------------------------------------------------
model Meeting {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  description   String?
  meetingDate   DateTime
  location      String?
  attendeeCount Int?
  status        MeetingStatus @default(PLANNED)

  // Governance — consistent with Target governance pattern
  reviewStage           ReviewWorkflowStage @default(DRAFT)
  requiresFourEyeReview Boolean             @default(false)
  reviewedByUserId      String?
  reviewedAt            DateTime?

  // Visibility / access control
  visibilityScope        VisibilityScope @default(ORGANISATION)
  createdByUserId        String?
  // String[] stored as JSON — role keys, user IDs, team IDs, org unit IDs, person IDs, target group IDs
  visibleRoleRefs        Json?
  visibleUserRefs        Json?
  visibleTeamRefs        Json?
  visibleOrgUnitRefs     Json?
  visiblePersonRefs      Json?
  // Phase D — TargetGroup visibility: resolved target group members can see this entity.
  visibleTargetGroupRefs Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agendaItems  MeetingAgendaItem[]
  decisions    MeetingDecision[]
  actions      MeetingAction[]
  participants MeetingParticipant[]

  @@index([meetingDate])
  @@index([status])
  @@index([reviewStage])
  @@index([visibilityScope])
}

model OrgUnit {
  id          String        @id @default(cuid())
  tenantId    String?
  parentId    String?
  type        OrgUnitType   @default(DEPARTMENT)
  status      OrgUnitStatus @default(ACTIVE)
  // key is tenant-scoped unique (@@unique below); no longer globally unique.
  // Slice 11.2: global @unique removed to enable same key across tenants.
  key         String
  name        String
  description String?
  sortOrder   Int           @default(0)
  level       Int           @default(0)
  // Org Builder Foundation v1: archivedAt records when a unit was archived.
  // Null when not archived. Set by the archive action; cleared on restore.
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  parent      OrgUnit?            @relation("OrgUnitHierarchy", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children    OrgUnit[]           @relation("OrgUnitHierarchy")
  memberships OrgUnitMembership[]
  teams       Team[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([parentId])
  @@index([type, status])
}

model OrgUnitMembership {
  id        String                  @id @default(cuid())
  tenantId  String?
  orgUnitId String
  userId    String?
  personId  String?
  roleKey   String?
  status    OrgUnitMembershipStatus @default(ACTIVE)
  isPrimary Boolean                 @default(false)
  startsAt  DateTime?
  endsAt    DateTime?
  // Phase A — season-aware membership: optional season reference for time-bounded memberships.
  // Notes field for contextual information (e.g. reason for joining, handover notes).
  seasonId  String?
  notes     String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  orgUnit OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  person  Person? @relation(fields: [personId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  season  Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([orgUnitId])
  @@index([userId])
  @@index([personId])
  @@index([tenantId, userId])
  @@index([orgUnitId, status])
  @@index([seasonId])
  @@index([tenantId, orgUnitId, status])
}

model TargetGroup {
  id          String        @id @default(cuid())
  tenantId    String?
  // key is tenant-scoped unique (@@unique below); no longer globally unique.
  // Slice 11.6: global @unique removed to enable same key across tenants.
  key         String
  name        String
  description String?
  status      OrgUnitStatus @default(ACTIVE)
  ruleJson    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  registrations Registration[]

  @@unique([tenantId, key])
  @@index([status])
}

model CommunicationTemplate {
  id           String                        @id @default(cuid())
  slug         String                        @unique
  title        String
  category     CommunicationTemplateCategory @default(GENERAL)
  status       CommunicationTemplateStatus   @default(DRAFT)
  subject      String
  bodyMarkdown String
  moduleKey    String?
  variableRefs Json?

  // Governance
  reviewStage           ReviewWorkflowStage @default(DRAFT)
  requiresFourEyeReview Boolean             @default(false)
  reviewedByUserId      String?
  reviewedAt            DateTime?

  // Visibility
  visibilityScope VisibilityScope @default(ORGANISATION)
  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([moduleKey])
  @@index([reviewStage])
}

model MeetingAgendaItem {
  id              String                  @id @default(cuid())
  meetingId       String
  title           String
  notes           String?
  owner           String?
  durationMin     Int?
  orderIndex      Int                     @default(0)
  status          MeetingAgendaItemStatus @default(OPEN)
  createdByUserId String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([meetingId, orderIndex])
}

model MeetingDecision {
  id              String                @id @default(cuid())
  meetingId       String
  title           String
  description     String?
  status          MeetingDecisionStatus @default(CONFIRMED)
  owner           String?
  orderIndex      Int                   @default(0)
  linkedRefs      Json?
  createdByUserId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([meetingId, orderIndex])
}

model MeetingAction {
  id              String              @id @default(cuid())
  meetingId       String
  title           String
  owner           String?
  dueDate         DateTime?
  status          MeetingActionStatus @default(OPEN)
  linkedRefs      Json?
  createdByUserId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([meetingId])
  @@index([meetingId, status])
}

model MeetingParticipant {
  id        String                   @id @default(cuid())
  meetingId String
  name      String
  role      String?
  status    MeetingParticipantStatus @default(INVITED)
  userId    String?
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([meetingId])
  @@index([meetingId, userId])
}

model Target {
  id            String         @id @default(cuid())
  title         String
  description   String?
  category      TargetCategory @default(SPORTLICHE_ENTWICKLUNG)
  status        TargetStatus   @default(ACTIVE)
  period        TargetPeriod   @default(SEASON)
  periodLabel   String?
  moduleKey     String?
  sportCategory String?
  ageGroupHint  String?
  startsAt      DateTime?
  endsAt        DateTime?
  nudgeJson     Json?

  // Governance foundation — consistent with Event.reviewStage pattern
  reviewStage           ReviewWorkflowStage @default(DRAFT)
  requiresFourEyeReview Boolean             @default(false)
  reviewedByUserId      String?
  reviewedAt            DateTime?

  // Cross-module linking (phase 1: slug/title refs; phase 2: proper FK relations)
  // Stored as [{slug, title, url?}][] — validated by lib/linking/helpers.ts
  linkedInitiativeRefs Json?
  linkedMeetingRefs    Json?

  // Visibility / access control — consistent with Meeting and Initiative pattern
  visibilityScope        VisibilityScope @default(ORGANISATION)
  createdByUserId        String?
  visibleRoleRefs        Json?
  visibleUserRefs        Json?
  visibleTeamRefs        Json?
  visibleOrgUnitRefs     Json?
  visiblePersonRefs      Json?
  // Phase D — TargetGroup visibility: resolved target group members can see this entity.
  visibleTargetGroupRefs Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metrics TargetMetric[]

  @@index([category])
  @@index([status])
  @@index([period])
  @@index([reviewStage])
  @@index([visibilityScope])
}

model TargetMetric {
  id           String           @id @default(cuid())
  targetId     String
  label        String
  type         TargetMetricType @default(PERCENTAGE)
  direction    TargetDirection  @default(INCREASE)
  targetValue  Float
  currentValue Float            @default(0)
  unit         String?
  notes        String?
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  target     Target            @relation(fields: [targetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  dataPoints TargetDataPoint[]

  @@index([targetId])
  @@index([targetId, sortOrder])
}

model TargetDataPoint {
  id         String   @id @default(cuid())
  metricId   String
  value      Float
  note       String?
  measuredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  metric TargetMetric @relation(fields: [metricId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([metricId])
  @@index([measuredAt])
}

// ---------------------------------------------------------------------------
// Facilities & Resources — Admin → Facilities & Resources MVP
//
// Tenant-scoped configurable facilities (pitches, dressing room blocks, halls)
// and their allocatable resources (full pitch, half A/B, individual dressing rooms).
//
// Display helpers in lib/facilities/display-helpers.ts resolve allocation codes
// to labels by checking tenant-configured resources first, then falling back to
// the FCA static registries in lib/facilities/pitches.ts and dressing-rooms.ts.
//
// TODO(tenant-isolation/website): Public domain resolution
//   resolveTenantFromRequest(request) → tenant-scoped facility/resource lookup
//   Required before multi-tenant public websites can show per-tenant facility labels.
// ---------------------------------------------------------------------------

model Facility {
  id        String         @id @default(cuid())
  tenantId  String
  name      String
  type      FacilityType   @default(OTHER)
  status    FacilityStatus @default(ACTIVE)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resources FacilityResource[]

  @@index([tenantId])
  @@index([tenantId, sortOrder])
}

model FacilityResource {
  id         String               @id @default(cuid())
  tenantId   String
  facilityId String
  name       String
  code       String
  type       FacilityResourceType @default(OTHER)
  status     FacilityStatus       @default(ACTIVE)
  sortOrder  Int                  @default(0)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([facilityId])
}

// ---------------------------------------------------------------------------
// WochenplanPublication — Week Plan Publishing + Active Variant Display
//
// Tracks the active publication state for a tenant's week plan.
// One record per (tenantId, weekId): upserted each time the admin publishes.
//
// variantLabel — human-readable name of the active plan variant shown on
//   the public website and InfoBoard: e.g. "Standard-Wochenplan",
//   "Schlechtwetter-Wochenplan", "Ferienplan".
// isPublished  — false when saved as draft; true when fully published.
//
// Public display format: "KW 23 | Schlechtwetter-Wochenplan aktiv"
// ---------------------------------------------------------------------------

model WochenplanPublication {
  id                String    @id @default(cuid())
  tenantId          String
  weekId            String    // ISO week identifier, e.g. "2026-W23"
  variantLabel      String    @default("Standard-Wochenplan")
  isPublished       Boolean   @default(false)
  publishedAt       DateTime?
  publishedByUserId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, weekId])
  @@index([tenantId, weekId])
  @@index([tenantId, isPublished])
}

// ---------------------------------------------------------------------------
// MediaAsset — Shared Media Library (News CMS V2)
//
// Tenant-scoped media assets (images and videos) managed via the
// admin media library. Assets are stored on Vercel Blob and referenced
// by news articles as hero images or embedded content.
//
// Provider-agnostic: url stores the CDN-served public URL regardless
// of the underlying storage backend (Vercel Blob today; S3-compatible later).
// ---------------------------------------------------------------------------

model MediaAsset {
  id              String           @id @default(cuid())
  tenantId        String
  type            MediaAssetType   @default(IMAGE)
  status          MediaAssetStatus @default(ACTIVE)
  filename        String
  mimeType        String
  sizeBytes       Int
  url             String
  altText         String?
  caption         String?
  width           Int?
  height          Int?
  durationSec     Int?
  createdByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  newsArticles     NewsArticle[]      @relation("NewsArticleHeroMedia")
  newsArticleMedia NewsArticleMedia[]

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

// ---------------------------------------------------------------------------
// NewsArticle — Public website news feed (News CMS V2)
//
// Tenant-scoped news articles surfaced via the public website API.
// Only PUBLISHED articles are returned by the public endpoints.
//
// V2 extensions (additive, backward-compatible):
//   heroMediaId — FK to MediaAsset for the article hero image.
//     imageUrl is kept for public-API backward-compat and populated
//     automatically from heroMedia.url when heroMediaId is set.
//   channels   — JSON string[] of publication channel keys
//                (e.g. ["website", "newsletter"]).
//   scheduledAt — UTC timestamp for deferred publication (SCHEDULED status).
//   authorName  — display name of the article author.
//   tags        — JSON string[] of tag labels for filtering/search.
//
// Public list endpoint omits content. Detail endpoint includes content.
// Internal fields (tenantId, status, etc.) are never exposed publicly.
// ---------------------------------------------------------------------------

model NewsArticle {
  id           String            @id @default(cuid())
  tenantId     String
  slug         String
  title        String
  excerpt      String?
  content      String
  imageUrl     String?
  status       NewsArticleStatus @default(DRAFT)
  publishedAt  DateTime?

  // V2 extensions
  heroMediaId    String?
  channels       Json?
  scheduledAt    DateTime?
  authorName     String?
  tags           Json?

  // V2.1 extensions
  authorPersonId String?
  reviewNotes    String?

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  heroMedia      MediaAsset?        @relation("NewsArticleHeroMedia", fields: [heroMediaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  authorPerson   Person?            @relation("NewsArticleAuthorPerson", fields: [authorPersonId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  additionalMedia NewsArticleMedia[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, status, publishedAt])
  @@index([tenantId, status, scheduledAt])
  @@index([tenantId, heroMediaId])
  @@index([tenantId, authorPersonId])
  @@index([slug])
}

// ---------------------------------------------------------------------------
// NewsArticleMedia — Additional media attached to a news article (V2.1)
//
// Separate from heroMediaId which is the dedicated header/hero image.
// Supports ordering (sortOrder), optional captions, and optional placement
// hints (e.g. "inline", "gallery") for rendering engines.
// ---------------------------------------------------------------------------

model NewsArticleMedia {
  id           String    @id @default(cuid())
  tenantId     String
  articleId    String
  mediaAssetId String
  sortOrder    Int       @default(0)
  caption      String?
  placement    String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  article    NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  mediaAsset MediaAsset  @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([articleId, mediaAssetId])
  @@index([articleId])
  @@index([tenantId])
  @@index([articleId, sortOrder])
}

// ---------------------------------------------------------------------------
// WebsitePage — Tenant-managed static/semi-static website pages (Slice 1)
//
// Supports the same editorial workflow as NewsArticle:
//   - approvedDataOnly = false → direct publish/unpublish
//   - approvedDataOnly = true  → DRAFT → IN_REVIEW → PUBLISHED (via reviewer)
//
// Public endpoint: GET /api/public/v1/website/pages/[slug]
//   Only PUBLISHED pages are returned. Internal fields are never exposed.
//
// body: raw Markdown or plain-text content. Full page builder comes in later slices.
// seoTitle / seoDescription: optional SEO overrides.
// scheduledAt: UTC timestamp for deferred publication (SCHEDULED status).
// authorPersonId: optional link to a Person record (FK, nullable).
// reviewNotes: reviewer feedback surfaced when status returns to DRAFT.
// ---------------------------------------------------------------------------

model WebsitePage {
  id             String            @id @default(cuid())
  tenantId       String
  slug           String
  title          String
  body           String            @default("")
  status         WebsitePageStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  scheduledAt    DateTime?
  publishedAt    DateTime?
  authorPersonId String?
  reviewNotes    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  authorPerson Person? @relation("WebsitePageAuthorPerson", fields: [authorPersonId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, status, publishedAt])
  @@index([tenantId, status, scheduledAt])
  @@index([tenantId, authorPersonId])
  @@index([slug])
}
