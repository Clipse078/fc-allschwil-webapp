generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum NewsArticleStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum WebsitePageStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum MediaAssetType {
  IMAGE
  VIDEO
}

enum MediaAssetStatus {
  ACTIVE
  ARCHIVED
}

enum PermissionModule {
  USERS
  SEASONS
  TEAMS
  PEOPLE
  EVENTS
  FIXTURES
  WOCHENPLAN
  NEWS
  WEBSITE
  INFOBOARD
  FUNCTIONS
  TARGETS
  MEETINGS
  INITIATIVES
  TEMPLATES
  REGISTRATIONS
  TENANTS
  ORG
  FACILITIES
}

enum FacilityType {
  PITCH
  DRESSING_ROOM_BLOCK
  INDOOR_HALL
  OTHER
}

enum FacilityResourceType {
  FULL_PITCH
  HALF_PITCH
  DRESSING_ROOM
  OTHER
}

enum FacilityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum RegistrationType {
  PROBETRAINING
  SPIELERANMELDUNG
  TRAINERANMELDUNG
  SPONSORANFRAGE
  KONTAKTANFRAGE
  OTHER
}

enum RegistrationStatus {
  NEW
  REVIEWING
  CONTACTED
  ACCEPTED
  REJECTED
  ARCHIVED
}

enum VisibilityScope {
  ORGANISATION
  RESTRICTED
  PRIVATE
}

enum OrgUnitType {
  CLUB
  DIVISION
  DEPARTMENT
  SUB_DEPARTMENT
  TEAM
  COMMITTEE
  PROJECT_GROUP
  CUSTOM
}

enum OrgUnitStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrgUnitMembershipStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum CommunicationTemplateCategory {
  MATCH_INVITATION
  MEETING_FOLLOWUP
  INITIATIVE_UPDATE
  TARGET_PROGRESS
  TOURNAMENT_REMINDER
  GOVERNANCE_FOLLOWUP
  SPONSOR_OUTREACH
  PARENT_COMMUNICATION
  GENERAL
}

enum CommunicationTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MeetingStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum MeetingAgendaItemStatus {
  OPEN
  DISCUSSED
  SKIPPED
}

enum MeetingDecisionStatus {
  DRAFT
  CONFIRMED
  SUPERSEDED
}

enum MeetingActionStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum MeetingParticipantStatus {
  INVITED
  PRESENT
  ABSENT
  EXCUSED
}

enum InitiativeStatus {
  PLANNED
  IN_PROGRESS
  ON_TRACK
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TargetCategory {
  SPORTLICHE_ENTWICKLUNG
  MITGLIEDERWACHSTUM
  FINANZEN
  AUSBILDUNG
  MEDIEN_SOZIALES
  GOVERNANCE
}

enum TargetStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum TargetPeriod {
  SEASON
  QUARTER
  YEAR
  CUSTOM
}

enum TargetMetricType {
  PERCENTAGE
  NUMERIC
  CURRENCY
  BOOLEAN
}

enum TargetDirection {
  INCREASE
  DECREASE
  MAINTAIN
}

enum TeamCategory {
  KINDERFUSSBALL
  JUNIOREN
  AKTIVE
  FRAUEN
  SENIOREN
  TRAININGSGRUPPE
}

enum TeamSeasonStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PlayerSquadStatus {
  ACTIVE
  INACTIVE
  INJURED
  ABSENT
  ARCHIVED
}

enum TrainerTeamStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum EventType {
  MATCH
  TOURNAMENT
  TRAINING
  OTHER
  VACATION_PERIOD
}

enum EventSource {
  CLUBCORNER_FVNWS
  MANUAL
  CSV_EXCEL_IMPORT
  MUNICIPALITY_API
}

enum EventStatus {
  DRAFT
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
  POSTPONED
  ARCHIVED
}

enum EventImportRunStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum ReviewWorkflowStage {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PUBLISHED
}

enum WorkflowDomain {
  EVENTS
  SEASONS
  TEAMS
  PEOPLE
  USERS
  IMPORTS
  WEBSITE
  NEWS
  INFOBOARD
  WOCHENPLAN
  FIXTURES
  FUNCTIONS
  SESSION_SECURITY
  MEETINGS
  INITIATIVES
  TARGETS
}

enum WorkflowAction {
  CREATE
  UPDATE
  DELETE
  REVIEW
  APPROVE
  REJECT
  PUBLISH
  IMPORT
}

model Tenant {
  id        String       @id @default(cuid())
  key       String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Config v1 — Slice 10.2
  // String fields are nullable: no opinionated DB default for white-label safety.
  // Seed sets explicit values for fc-allschwil. New tenants start with nulls.
  countryCode           String?
  sportCategory         String?
  locale                String?
  timezone              String?
  currency              String?
  // Season integers have a neutral structural default (August 1st European convention).
  seasonStartMonth      Int    @default(8)
  seasonTransitionDay   Int    @default(1)
  seasonTransitionMonth Int    @default(8)

  // Branding v1 — Slice 10.6
  // All nullable: no DB default for white-label safety.
  // Application code falls back to SportClubEvo defaults when null.
  // primaryColor / secondaryColor: 6-digit hex (#rrggbb); validated at API layer.
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?

  // Website integration flags — Slice 4 (News Detail Endpoint)
  // websiteEnabled: gates all /api/public/v1/website/* endpoints for this tenant.
  // approvedDataOnly: when true, only content that has passed editorial approval
  //   is surfaced on the public website feed. Defaults false for backward-compat.
  websiteEnabled   Boolean @default(true)
  approvedDataOnly Boolean @default(false)

  registrations          Registration[]
  users                  User[]
  events                 Event[]
  teams                  Team[]
  facilities             Facility[]
  facilityResources      FacilityResource[]
  wochenplanPublications WochenplanPublication[]
  newsArticles           NewsArticle[]
  mediaAssets            MediaAsset[]
  mediaFolders           MediaFolder[]
  mediaTags              MediaTag[]
  mediaAssetTags         MediaAssetTag[]
  mediaAssetUsages       MediaAssetUsage[]
  newsArticleMedia       NewsArticleMedia[]
  websitePages           WebsitePage[]
  websitePageSections    WebsitePageSection[]
  homepageSections       HomepageSection[]
  websiteNavItems        WebsiteNavItem[]
  contentRevisions       ContentRevision[]

  @@index([status])
  @@index([name])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Slice 11.2b: tenantId added so the JWT can carry tenant context.
  // Nullable: legacy users are backfilled in 20260604064000_user_tenant_fk.
  // getDefaultTenant() retained as fallback only for seed/bootstrap paths.
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  userRoles             UserRole[]
  auditLogs             AuditLog[]      @relation("AuditActor")
  assignedRegistrations Registration[]  @relation("RegistrationAssignedUser")
  orgUnitMemberships    OrgUnitMembership[]
  reviewedHomepageSections  HomepageSection[] @relation("HomepageSectionReviewer")
  approvedHomepageSections  HomepageSection[] @relation("HomepageSectionApprovedBy")
  rejectedHomepageSections  HomepageSection[] @relation("HomepageSectionRejectedBy")
  reviewedPageSections  WebsitePageSection[] @relation("PageSectionReviewer")
  approvedPageSections  WebsitePageSection[] @relation("PageSectionApprovedBy")
  rejectedPageSections  WebsitePageSection[] @relation("PageSectionRejectedBy")
  contentRevisions      ContentRevision[]

  @@index([isActive])
  @@index([tenantId])
}

model Registration {
  id String @id @default(cuid())

  tenantId String

  type   RegistrationType
  status RegistrationStatus @default(NEW)

  firstName String
  lastName  String
  email     String
  phone     String?
  birthDate DateTime?
  birthYear Int?

  message     String?
  payloadJson Json?
  source      String?

  assignedToUserId String?
  targetGroupId    String?

  submittedAt DateTime @default(now())

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignedToUser User?        @relation("RegistrationAssignedUser", fields: [assignedToUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  targetGroup    TargetGroup? @relation(fields: [targetGroupId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@index([assignedToUserId])
  @@index([targetGroupId])
}

model Role {
  id                              String   @id @default(cuid())
  key                             String   @unique
  name                            String
  description                     String?
  canAccessVereinsleitung         Boolean  @default(false)
  canAttendVereinsleitungMeetings Boolean  @default(false)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  userRoles                 UserRole[]
  rolePermissions           RolePermission[]
  workflowRules             RoleWorkflowRule[]
  workflowReviewAssignments RoleWorkflowReviewAssignment[] @relation("WorkflowReviewerRole")

  @@index([name])
  @@index([canAccessVereinsleitung])
  @@index([canAttendVereinsleitungMeetings])
}

model Permission {
  id        String           @id @default(cuid())
  key       String           @unique
  name      String
  module    PermissionModule
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  rolePermissions RolePermission[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model RoleWorkflowRule {
  id                 String         @id @default(cuid())
  roleId             String
  domain             WorkflowDomain
  action             WorkflowAction
  requiresReview     Boolean        @default(true)
  allowsDirectManage Boolean        @default(false)
  allowsReview       Boolean        @default(false)
  allowsApprove      Boolean        @default(false)
  allowsPublish      Boolean        @default(false)
  allowsSeriesReview Boolean        @default(false)
  isActive           Boolean        @default(true)
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  role              Role                           @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reviewAssignments RoleWorkflowReviewAssignment[]

  @@unique([roleId, domain, action])
  @@index([domain, action])
  @@index([isActive])
}

model RoleWorkflowReviewAssignment {
  id             String   @id @default(cuid())
  workflowRuleId String
  reviewerRoleId String
  isRequired     Boolean  @default(true)
  sortOrder      Int      @default(0)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workflowRule RoleWorkflowRule @relation(fields: [workflowRuleId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "RoleWorkflowReviewAssignment_workflowRuleId_fkey")
  reviewerRole Role             @relation("WorkflowReviewerRole", fields: [reviewerRoleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([workflowRuleId, reviewerRoleId])
  @@index([reviewerRoleId])
  @@index([sortOrder])
}

model Season {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamSeasons        TeamSeason[]
  events             Event[]
  eventImportRuns    EventImportRun[]
  orgUnitMemberships OrgUnitMembership[]

  @@index([isActive])
}

model Person {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  displayName String?
  email       String?
  phone       String?
  dateOfBirth DateTime?
  notes       String?
  isActive    Boolean   @default(true)
  isPlayer    Boolean   @default(false)
  isTrainer   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  playerSquadMembers   PlayerSquadMember[]
  trainerTeamMembers   TrainerTeamMember[]
  orgUnitMemberships   OrgUnitMembership[]
  authoredNewsArticles NewsArticle[]       @relation("NewsArticleAuthorPerson")
  authoredWebsitePages WebsitePage[]       @relation("WebsitePageAuthorPerson")

  @@index([lastName, firstName])
  @@index([email])
  @@index([isActive])
  @@index([isPlayer])
  @@index([isTrainer])
}

model Team {
  id               String       @id @default(cuid())
  name             String
  slug             String       @unique
  category         TeamCategory
  genderGroup      String?
  ageGroup         String?
  sortOrder        Int          @default(0)
  isActive         Boolean      @default(true)
  websiteVisible   Boolean      @default(true)
  infoboardVisible Boolean      @default(true)
  orgUnitId        String?

  // Tenant isolation (nullable: backward-compat; backfill in 20260626000000_team_tenant_isolation)
  tenantId         String?
  tenant           Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  teamSeasons     TeamSeason[]
  events          Event[]
  eventImportRuns EventImportRun[]
  orgUnit         OrgUnit?     @relation(fields: [orgUnitId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([category, sortOrder])
  @@index([isActive])
  @@index([orgUnitId])
  @@index([tenantId])
}

model TeamSeason {
  id                        String           @id @default(cuid())
  teamId                    String
  seasonId                  String
  displayName               String
  shortName                 String?
  status                    TeamSeasonStatus @default(ACTIVE)
  websiteVisible            Boolean          @default(true)
  infoboardVisible          Boolean          @default(true)
  squadWebsiteVisible       Boolean          @default(true)
  trainerTeamWebsiteVisible Boolean          @default(true)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  team               Team                @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  season             Season              @relation(fields: [seasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  playerSquadMembers PlayerSquadMember[]
  trainerTeamMembers TrainerTeamMember[]

  @@unique([teamId, seasonId])
  @@index([seasonId])
  @@index([status])
  @@index([squadWebsiteVisible])
  @@index([trainerTeamWebsiteVisible])
}

model PlayerSquadMember {
  id               String            @id @default(cuid())
  teamSeasonId     String
  personId         String
  status           PlayerSquadStatus @default(ACTIVE)
  shirtNumber      Int?
  positionLabel    String?
  isCaptain        Boolean           @default(false)
  isViceCaptain    Boolean           @default(false)
  isWebsiteVisible Boolean           @default(true)
  sortOrder        Int               @default(0)
  remarks          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  teamSeason TeamSeason @relation(fields: [teamSeasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  person     Person     @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([teamSeasonId, personId])
  @@index([personId])
  @@index([teamSeasonId, status])
  @@index([teamSeasonId, isWebsiteVisible])
  @@index([teamSeasonId, sortOrder])
}

model TrainerTeamMember {
  id               String            @id @default(cuid())
  teamSeasonId     String
  personId         String
  status           TrainerTeamStatus @default(ACTIVE)
  roleLabel        String?
  isWebsiteVisible Boolean           @default(true)
  sortOrder        Int               @default(0)
  remarks          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  teamSeason TeamSeason @relation(fields: [teamSeasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  person     Person     @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([teamSeasonId, personId])
  @@index([personId])
  @@index([teamSeasonId, status])
  @@index([teamSeasonId, isWebsiteVisible])
  @@index([teamSeasonId, sortOrder])
}

model Event {
  id       String      @id @default(cuid())
  seasonId String
  teamId   String?
  type     EventType
  source   EventSource
  status   EventStatus @default(SCHEDULED)

  reviewStage       ReviewWorkflowStage @default(DRAFT)
  reviewRequestedAt DateTime?
  reviewedAt        DateTime?
  publishedAt       DateTime?
  reviewNotes       String?
  createdByUserId   String?
  reviewedByUserId  String?
  approvedByUserId  String?
  rejectedByUserId  String?
  publishedByUserId String?

  title       String
  description String?
  location    String?

  startAt DateTime
  endAt   DateTime?

  externalSource   String?
  externalSourceId String?
  importBatchKey   String?
  lastSyncedAt     DateTime?

  opponentName     String?
  organizerName    String?
  competitionLabel String?
  homeAway         String?
  resultLabel      String?
  meetingTime      DateTime?

  websiteVisible       Boolean @default(true)
  infoboardVisible     Boolean @default(false)
  homepageVisible      Boolean @default(false)
  wochenplanVisible    Boolean @default(false)
  trainingsplanVisible Boolean @default(false)
  teamPageVisible      Boolean @default(false)

  sortOrder Int     @default(0)
  remarks   String?

  // Wochenplan pitch + dressing-room allocation (Week Planner V1)
  pitchCode             String?
  homeDressingRoomCode  String?
  awayDressingRoomCode  String?

  // Tenant isolation (nullable: backward-compat with seed/legacy events)
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  team   Team?  @relation(fields: [teamId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([seasonId, type])
  @@index([teamId, type])
  @@index([startAt])
  @@index([status])
  @@index([source])
  @@index([reviewStage])
  @@index([reviewRequestedAt])
  @@index([publishedAt])
  @@index([websiteVisible])
  @@index([infoboardVisible])
  @@index([wochenplanVisible])
  @@index([trainingsplanVisible])
  @@index([teamPageVisible])
  @@index([externalSource, externalSourceId])
  @@index([tenantId])
  @@index([importBatchKey])
  @@index([pitchCode])
}

model EventImportRun {
  id       String               @id @default(cuid())
  source   EventSource
  status   EventImportRunStatus @default(PENDING)
  type     EventType?
  seasonId String?
  teamId   String?

  importBatchKey String    @unique
  fileName       String?
  startedAt      DateTime?
  finishedAt     DateTime?

  rowsDetected Int @default(0)
  rowsCreated  Int @default(0)
  rowsUpdated  Int @default(0)
  rowsSkipped  Int @default(0)
  rowsFailed   Int @default(0)

  summary      String?
  errorMessage String?
  metadataJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([source, status])
  @@index([type])
  @@index([seasonId])
  @@index([teamId])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  moduleKey    String
  entityType   String
  entityId     String
  action       String
  beforeJson   Json?
  afterJson    Json?
  metadataJson Json?
  createdAt    DateTime @default(now())

  actorUser User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([moduleKey])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Initiative — Visibility / Governance
//
// Visibility is implemented: VisibilityScope (ORGANISATION / RESTRICTED / PRIVATE)
// enforced by canSeeEntity() in lib/visibility/visibility-filter.ts.
// ActorContext is hydrated with orgUnitIds via getActorContext().
//
// Roadmap:
//   - visibleTeamRefs / visiblePersonRefs: requires teamIds / personId on ActorContext
//   - PRIVATE non-creator allowlist: DB WHERE needs JSONB @> (Phase 2)
//   - Reviewer role validation via RoleWorkflowReviewAssignment (Phase 2)
// ---------------------------------------------------------------------------
model Initiative {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  summary     String?
  description String?
  status      InitiativeStatus @default(PLANNED)
  owner       String?
  progress    Int?
  dueDate     DateTime?

  // Governance — consistent with Meeting and Target governance pattern
  reviewStage           ReviewWorkflowStage @default(DRAFT)
  requiresFourEyeReview Boolean             @default(false)
  reviewedByUserId      String?
  reviewedAt            DateTime?

  // Visibility / access control
  visibilityScope        VisibilityScope @default(ORGANISATION)
  createdByUserId        String?
  visibleRoleRefs        Json?
  visibleUserRefs        Json?
  visibleTeamRefs        Json?
  visibleOrgUnitRefs     Json?
  visiblePersonRefs      Json?
  // Phase D — TargetGroup visibility: resolved target group members can see this entity.
  visibleTargetGroupRefs Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([reviewStage])
  @@index([dueDate])
  @@index([visibilityScope])
}

// ---------------------------------------------------------------------------
// Meeting — Visibility / Governance
//
// Visibility is implemented: VisibilityScope (ORGANISATION / RESTRICTED / PRIVATE)
// enforced by canSeeEntity() in lib/visibility/visibility-filter.ts.
// RESTRICTED allowlist includes org units, roles, and users.
//
// Roadmap:
//   - visibleTeamRefs / visiblePersonRefs: requires teamIds / personId on ActorContext
//   - PRIVATE non-creator allowlist: DB WHERE needs JSONB @> (Phase 2)
//   - Reviewer role validation via RoleWorkflowReviewAssignment (Phase 2)
// ---------------------------------------------------------------------------
model Meeting {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  description   String?
  meetingDate   DateTime
  location      String?
  attendeeCount Int?
  status        MeetingStatus @default(PLANNED)

  // Governance — consistent with Target governance pattern
  reviewStage           ReviewWorkflowStage @default(DRAFT)
  requiresFourEyeReview Boolean             @default(false)
  reviewedByUserId      String?
  reviewedAt            DateTime?

  // Visibility / access control
  visibilityScope        VisibilityScope @default(ORGANISATION)
  createdByUserId        String?
  // String[] stored as JSON — role keys, user IDs, team IDs, org unit IDs, person IDs, target group IDs
  visibleRoleRefs        Json?
  visibleUserRefs        Json?
  visibleTeamRefs        Json?
  visibleOrgUnitRefs     Json?
  visiblePersonRefs      Json?
  // Phase D — TargetGroup visibility: resolved target group members can see this entity.
  visibleTargetGroupRefs Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agendaItems  MeetingAgendaItem[]
  decisions    MeetingDecision[]
  actions      MeetingAction[]
  participants MeetingParticipant[]

  @@index([meetingDate])
  @@index([status])
  @@index([reviewStage])
  @@index([visibilityScope])
}

model OrgUnit {
  id          String        @id @default(cuid())
  tenantId    String?
  parentId    String?
  type        OrgUnitType   @default(DEPARTMENT)
  status      OrgUnitStatus @default(ACTIVE)
  // key is tenant-scoped unique (@@unique below); no longer globally unique.
  // Slice 11.2: global @unique removed to enable same key across tenants.
  key         String
  name        String
  description String?
  sortOrder   Int           @default(0)
  level       Int           @default(0)
  // Org Builder Foundation v1: archivedAt records when a unit was archived.
  // Null when not archived. Set by the archive action; cleared on restore.
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  parent      OrgUnit?            @relation("OrgUnitHierarchy", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children    OrgUnit[]           @relation("OrgUnitHierarchy")
  memberships OrgUnitMembership[]
  teams       Team[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([parentId])
  @@index([type, status])
}

