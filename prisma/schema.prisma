// ---------------------------------------------------------------------------
// MediaAsset — Shared Media Library (News CMS V2)
//
// Tenant-scoped media assets (images and videos) managed via the
// admin media library. Assets are stored on Vercel Blob and referenced
// by news articles as hero images or embedded content.
//
// Provider-agnostic: url stores the CDN-served public URL regardless
// of the underlying storage backend (Vercel Blob today; S3-compatible later).
// ---------------------------------------------------------------------------

model MediaAsset {
  id              String           @id @default(cuid())
  tenantId        String
  type            MediaAssetType   @default(IMAGE)
  status          MediaAssetStatus @default(ACTIVE)
  filename        String
  mimeType        String
  sizeBytes       Int
  url             String
  altText         String?
  caption         String?
  width           Int?
  height          Int?
  durationSec     Int?
  createdByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // DAM V1 extensions — additive, all nullable for backward compatibility
  description  String? // Long description / notes
  copyright    String? // © copyright / rights information
  photographer String? // Photographer / creator name
  folderId     String? // Optional folder placement
  archivedAt   DateTime? // Set when status → ARCHIVED; null when active
  storageKey   String? // Blob storage key for lifecycle management

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  folder           MediaFolder?       @relation(fields: [folderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  newsArticles     NewsArticle[]      @relation("NewsArticleHeroMedia")
  newsArticleMedia NewsArticleMedia[]
  tags             MediaAssetTag[]
  usages           MediaAssetUsage[]

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, folderId])
}

// ---------------------------------------------------------------------------
// NewsArticle — Public website news feed (News CMS V2)
//
// Tenant-scoped news articles surfaced via the public website API.
// Only PUBLISHED articles are returned by the public endpoints.
//
// V2 extensions (additive, backward-compatible):
//   heroMediaId — FK to MediaAsset for the article hero image.
//     imageUrl is kept for public-API backward-compat and populated
//     automatically from heroMedia.url when heroMediaId is set.
//   channels   — JSON string[] of publication channel keys
//                (e.g. ["website", "newsletter"]).
//   scheduledAt — UTC timestamp for deferred publication (SCHEDULED status).
//   authorName  — display name of the article author.
//   tags        — JSON string[] of tag labels for filtering/search.
//
// Public list endpoint omits content. Detail endpoint includes content.
// Internal fields (tenantId, status, etc.) are never exposed publicly.
// ---------------------------------------------------------------------------

model NewsArticle {
  id          String            @id @default(cuid())
  tenantId    String
  slug        String
  title       String
  excerpt     String?
  content     String
  imageUrl    String?
  status      NewsArticleStatus @default(DRAFT)
  publishedAt DateTime?

  // V2 extensions
  heroMediaId String?
  channels    Json?
  scheduledAt DateTime?
  authorName  String?
  tags        Json?

  // V2.1 extensions
  authorPersonId String?
  reviewNotes    String?

  // V4.2 extensions — rich text foundation
  contentJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  heroMedia       MediaAsset?        @relation("NewsArticleHeroMedia", fields: [heroMediaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  authorPerson    Person?            @relation("NewsArticleAuthorPerson", fields: [authorPersonId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  additionalMedia NewsArticleMedia[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, status, publishedAt])
  @@index([tenantId, status, scheduledAt])
  @@index([tenantId, heroMediaId])
  @@index([tenantId, authorPersonId])
  @@index([slug])
}

// ---------------------------------------------------------------------------
// NewsArticleMedia — Additional media attached to a news article (V2.1)
//
// Separate from heroMediaId which is the dedicated header/hero image.
// Supports ordering (sortOrder), optional captions, and optional placement
// hints (e.g. "inline", "gallery") for rendering engines.
// ---------------------------------------------------------------------------

model NewsArticleMedia {
  id           String  @id @default(cuid())
  tenantId     String
  articleId    String
  mediaAssetId String
  sortOrder    Int     @default(0)
  caption      String?
  placement    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  article    NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  mediaAsset MediaAsset  @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([articleId, mediaAssetId])
  @@index([articleId])
  @@index([tenantId])
  @@index([articleId, sortOrder])
}

// ---------------------------------------------------------------------------
// WebsitePage — Tenant-managed static/semi-static website pages (Slice 1)
//
// Supports the same editorial workflow as NewsArticle:
//   - approvedDataOnly = false → direct publish/unpublish
//   - approvedDataOnly = true  → DRAFT → IN_REVIEW → PUBLISHED (via reviewer)
//
// Public endpoint: GET /api/public/v1/website/pages/[slug]
//   Only PUBLISHED pages are returned. Internal fields are never exposed.
//
// body: raw Markdown or plain-text content. Full page builder comes in later slices.
// seoTitle / seoDescription: optional SEO overrides.
// scheduledAt: UTC timestamp for deferred publication (SCHEDULED status).
// authorPersonId: optional link to a Person record (FK, nullable).
// reviewNotes: reviewer feedback surfaced when status returns to DRAFT.
// ---------------------------------------------------------------------------

model WebsitePage {
  id             String            @id @default(cuid())
  tenantId       String
  slug           String
  title          String
  body           String            @default("")
  status         WebsitePageStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  scheduledAt    DateTime?
  publishedAt    DateTime?
  authorPersonId String?
  reviewNotes    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  authorPerson Person?              @relation("WebsitePageAuthorPerson", fields: [authorPersonId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sections     WebsitePageSection[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, status, publishedAt])
  @@index([tenantId, status, scheduledAt])
  @@index([tenantId, authorPersonId])
  @@index([slug])
}

// ---------------------------------------------------------------------------
// WebsitePageSection — Block-based page layout sections (CMS V2 Slice 8)
//
// Each WebsitePage can have an ordered set of typed content sections that
// define its block-based layout. This mirrors the HomepageSection model but
// is scoped to a specific page via pageId.
//
// Design invariants:
//   - One WebsitePageSection row per logical page block.
//   - sortOrder controls display order (ascending, 0-based).
//   - isEnabled gates public visibility: only enabled sections appear in the
//     public layout API when the parent page is PUBLISHED.
//   - config is free-form JSON; validated by the shared block registry helpers.
//   - type must match a key in the shared block registry (lib/homepage/block-registry.ts).
//
// Publishing strategy (CMS V2 Slice 8 — foundation):
//   Section visibility on the public API requires BOTH:
//     1. isEnabled = true (section gate)
//     2. parent WebsitePage.status = "PUBLISHED" AND publishedAt <= now() (page gate)
//   Full section-level publish/approval workflow is deferred to a future slice.
//   Sections do not carry their own publishStatus; they inherit the page's status.
//
// CMS V2 Slice 9 — Section Lifecycle:
//   Full section-level publish/approval workflow implemented.
//   Mirrors HomepageSection workflow pattern for architectural consistency.
//   Reusable publishing engine in lib/cms/section-publishing.ts.
// ---------------------------------------------------------------------------

model WebsitePageSection {
  id                 String    @id @default(cuid())
  tenantId           String
  pageId             String
  /// Section type key — must match a key in the shared block registry.
  type               String
  /// Human-readable admin label (editable by the tenant admin).
  label              String
  /// Display order (ascending). Lower values render first.
  sortOrder          Int       @default(0)
  /// When false the section is hidden from the public layout API.
  isEnabled          Boolean   @default(true)
  /// Type-specific configuration stored as a JSON object.
  /// Validated at the application layer via the shared block registry helpers.
  config             Json      @default("{}")
  // ── Publishing workflow fields (CMS V2 Slice 9) ──────────────────────────
  /// Publish status gate — "DRAFT" | "PUBLISHED".
  /// Default "PUBLISHED" preserves backwards compatibility for all pre-Slice-9 rows.
  publishStatus      String    @default("PUBLISHED")
  /// Timestamp of the most recent publish action.
  publishedAt        DateTime?
  /// Timestamp of the most recent unpublish action.
  unpublishedAt      DateTime?
  /// Retained after unpublish for audit trail.
  lastPublishedAt    DateTime?
  /// Optional future publish date. If set and <= now(), treated as published.
  scheduledPublishAt DateTime?
  /// Optional expiry date. If set and <= now(), section is hidden from public API.
  publishUntil       DateTime?
  // ── Approval workflow fields (CMS V2 Slice 9) ──────────────────────────
  /// Approval status — "NOT_REQUIRED" | "DRAFT" | "IN_REVIEW" | "APPROVED" | "CHANGES_REQUESTED".
  /// Default "NOT_REQUIRED" preserves backwards compatibility for all pre-Slice-9 rows.
  approvalStatus     String    @default("NOT_REQUIRED")
  reviewerUserId     String?
  reviewRequestedAt  DateTime?
  reviewedAt         DateTime?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  approvalNote       String?
  approvedByUserId   String?
  rejectedByUserId   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  page           WebsitePage @relation(fields: [pageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reviewerUser   User?       @relation("PageSectionReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approvedByUser User?       @relation("PageSectionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  rejectedByUser User?       @relation("PageSectionRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([tenantId])
  @@index([tenantId, pageId])
  @@index([tenantId, pageId, sortOrder])
  @@index([tenantId, pageId, isEnabled])
  @@index([tenantId, publishStatus])
  @@index([tenantId, approvalStatus])
  @@index([scheduledPublishAt])
}

// ---------------------------------------------------------------------------
// HomepageSection — Configurable homepage layout sections (CMS V2 Slices 2–6)
//
// Each tenant has an ordered set of named sections that define the layout of
// their public homepage. Sections are typed (see HomepageSectionType enum-like
// registry in lib/homepage/section-types.ts) and carry a JSON config blob for
// type-specific parameters (e.g. item count, label overrides).
//
// Design invariants:
//   - One HomepageSection row per logical homepage block.
//   - sortOrder controls display order (ascending, 0-based).
//   - isEnabled gates visibility gate 1: only enabled sections appear in public API.
//   - publishStatus gates visibility gate 2: only PUBLISHED sections appear in public API.
//   - scheduledPublishAt: if set and <= now(), the section is treated as published.
//   - config is free-form JSON; validated by section-type-specific helpers.
//
// Publishing workflow (CMS V2 Slice 5):
//   - publishStatus: "DRAFT" | "PUBLISHED"
//     Default "PUBLISHED" ensures all sections created before Slice 5 remain public.
//   - publishedAt: when the section was last published (nullable).
//   - unpublishedAt: when the section was last unpublished (nullable).
//   - lastPublishedAt: most recent publish timestamp for audit trail (nullable).
//   - scheduledPublishAt: if not null and <= now(), treated as published (nullable).
//
// Editorial approval workflow (CMS V2 Slice 6):
//   - approvalStatus: NOT_REQUIRED | DRAFT | IN_REVIEW | APPROVED | CHANGES_REQUESTED
//     Default "NOT_REQUIRED" preserves backwards compatibility for all pre-Slice-6 rows.
//     Sections with NOT_REQUIRED or APPROVED may be published/scheduled.
//     Sections with DRAFT, IN_REVIEW, or CHANGES_REQUESTED are blocked from publishing.
//   - reviewerUserId: nullable FK to User assigned as reviewer (foundation-level).
//   - reviewRequestedAt: when review was last requested.
//   - reviewedAt: when the most recent review action was taken (approve or reject).
//   - approvedAt: when the section was most recently approved.
//   - rejectedAt: when the section was most recently rejected.
//   - approvalNote: reviewer's note from the most recent approve/reject action.
//   - approvedByUserId: nullable FK to User who approved.
//   - rejectedByUserId: nullable FK to User who rejected.
//   Audit trail: all approval state transitions are recorded in AuditLog
//   (moduleKey="homepage", entityType="HomepageSection") via logAction().
//
// Public endpoint: GET /api/public/[tenant]/website/homepage
//   Returns only sections where isEnabled=true AND publishStatus=PUBLISHED AND
//   (scheduledPublishAt IS NULL OR scheduledPublishAt <= now()).
//   Internal admin fields (createdAt, updatedAt, tenantId) are never exposed.
//   Approval fields are NEVER exposed on the public endpoint.
//
// Future deferred work (document-only):
//   - Full four-eyes policy engine
//   - Email/push notification system
//   - Full reviewer assignment workflow (role-based)
//   - Drag-and-drop reordering
//   - Sponsor section backed by a real Sponsor model
//   - Background scheduler worker for scheduled publishing
// ---------------------------------------------------------------------------

model HomepageSection {
  id                 String    @id @default(cuid())
  tenantId           String
  /// Section type key — must match a key in HOMEPAGE_SECTION_TYPES registry.
  type               String
  /// Human-readable admin label (editable by the tenant admin).
  label              String
  /// Display order (ascending). Lower values render first.
  sortOrder          Int       @default(0)
  /// When false the section is hidden from the public API (gate 1).
  isEnabled          Boolean   @default(true)
  /// Type-specific configuration stored as a JSON object.
  /// Validated at the application layer via section-type helpers.
  config             Json      @default("{}")
  // ── Publishing workflow fields (CMS V2 Slice 5) ──────────────────────────
  /// Publish status gate 2 — "DRAFT" | "PUBLISHED".
  /// Default "PUBLISHED" preserves backwards compatibility for all pre-Slice-5 rows.
  publishStatus      String    @default("PUBLISHED")
  /// Timestamp of the most recent publish action.
  publishedAt        DateTime?
  /// Timestamp of the most recent unpublish action.
  unpublishedAt      DateTime?
  /// Timestamp of the most recent publish action (audit trail duplicate of publishedAt,
  /// retained so unpublish does not erase the last-known publish time).
  lastPublishedAt    DateTime?
  /// Optional future publish date. If set and <= now(), section is treated as published.
  /// Null means no scheduled publication.
  scheduledPublishAt DateTime?
  // ── Editorial approval workflow fields (CMS V2 Slice 6) ──────────────────
  /// Approval status — "NOT_REQUIRED" | "DRAFT" | "IN_REVIEW" | "APPROVED" | "CHANGES_REQUESTED".
  /// Default "NOT_REQUIRED" preserves backwards compatibility for all pre-Slice-6 rows.
  /// Only APPROVED and NOT_REQUIRED sections may be published or scheduled.
  approvalStatus     String    @default("NOT_REQUIRED")
  /// Nullable FK to the User assigned as reviewer (foundation-level assignment).
  reviewerUserId     String?
  /// When review was most recently requested (set by request-review action).
  reviewRequestedAt  DateTime?
  /// When the most recent review action was taken (approve or reject).
  reviewedAt         DateTime?
  /// When the section was most recently approved.
  approvedAt         DateTime?
  /// When the section was most recently rejected.
  rejectedAt         DateTime?
  /// Note left by the reviewer during approve or reject (most recent action).
  approvalNote       String?
  /// Nullable FK to the User who most recently approved this section.
  approvedByUserId   String?
  /// Nullable FK to the User who most recently rejected this section.
  rejectedByUserId   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reviewerUser   User?  @relation("HomepageSectionReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approvedByUser User?  @relation("HomepageSectionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  rejectedByUser User?  @relation("HomepageSectionRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([tenantId])
  @@index([tenantId, isEnabled])
  @@index([tenantId, sortOrder])
  @@index([tenantId, isEnabled, sortOrder])
  @@index([tenantId, publishStatus])
  @@index([tenantId, isEnabled, publishStatus])
  @@index([scheduledPublishAt])
  @@index([tenantId, approvalStatus])
}

// ---------------------------------------------------------------------------
// WebsiteNavItem — Tenant-managed website navigation items (CMS V2 Slice 7)
//
// Each tenant owns an ordered set of navigation items that define the structure
// of their website menus. Items are organised by:
//   - area:     HEADER | FOOTER | UTILITY — which menu area the item belongs to
//   - parentId: nullable self-reference for multi-level hierarchy
//   - sortOrder: display position within the same parent/area
//
// Link types:
//   - INTERNAL  — WebApp-relative path (e.g. /news)
//   - EXTERNAL  — Fully-qualified URL (https://...)
//   - CUSTOM    — Arbitrary string (anchor, fragment, etc.)
//
// Visibility:
//   - isVisible: primary gate — false means hidden from public API
//   - visibilityMode: ALWAYS | AUTHENTICATED | ANONYMOUS
//     Default ALWAYS. AUTHENTICATED/ANONYMOUS modes are foundation-level;
//     the public API currently respects only isVisible=true.
//
// Circular reference prevention and cross-tenant parent checks are enforced
// at the application layer (admin-queries.ts), not the DB layer.
//
// Public endpoint: GET /api/public/[tenant]/website/navigation
//   Returns only items where isVisible=true, ordered by area + parent + sortOrder.
//   Admin fields (createdAt, updatedAt, tenantId, visibilityMode) are never exposed.
//
// Future deferred work:
//   - ROLE_BASED visibility with requiredPermission
//   - pageId FK to WebsitePage
//   - Drag-and-drop reordering
//   - Mega menu / visual menu builder
// ---------------------------------------------------------------------------

model WebsiteNavItem {
  id             String   @id @default(cuid())
  tenantId       String
  /// Nullable self-reference: null = top-level item in its area.
  parentId       String?
  /// Menu area. One of: "HEADER" | "FOOTER" | "UTILITY"
  area           String
  /// Display label for this navigation item.
  label          String
  /// Link type. One of: "INTERNAL" | "EXTERNAL" | "CUSTOM"
  linkType       String   @default("INTERNAL")
  /// URL or path for this item. Null for non-linking parent items.
  href           String?
  /// Link target. One of: "SELF" | "BLANK". Default SELF.
  target         String   @default("SELF")
  /// Display order within the same parent/area (ascending, 0-based).
  sortOrder      Int      @default(0)
  /// Primary visibility gate. false = hidden from public API.
  isVisible      Boolean  @default(true)
  /// Visibility mode. One of: "ALWAYS" | "AUTHENTICATED" | "ANONYMOUS".
  /// Foundation-level: public API currently only filters by isVisible.
  visibilityMode String   @default("ALWAYS")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parent   WebsiteNavItem?  @relation("NavItemChildren", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children WebsiteNavItem[] @relation("NavItemChildren")

  @@index([tenantId])
  @@index([tenantId, area])
  @@index([tenantId, area, parentId])
  @@index([tenantId, area, parentId, sortOrder])
  @@index([tenantId, isVisible])
  @@index([parentId])
}

// ---------------------------------------------------------------------------
// ContentRevision — Append-only version history for CMS content (CMS V2 Slice 9)
//
// Every significant edit to a CMS entity (WebsitePageSection, WebsitePage,
// HomepageSection) creates an immutable revision record capturing the full
// entity state at that point in time.
//
// Design invariants:
//   - Append-only: revisions are never updated or deleted.
//   - versionNumber: auto-incremented per (entityType, entityId) pair.
//   - snapshot: full JSON representation of the entity at save time.
//   - Restoring a revision creates a NEW revision (never overwrites history).
//
// Audit trail: every revision records who made the change (createdByUserId)
// and optionally what changed (changeNote). Future compliance features
// can query this table for a complete history of any CMS entity.
// ---------------------------------------------------------------------------

model ContentRevision {
  id               String   @id @default(cuid())
  tenantId         String
  /// Entity type key: "WebsitePageSection" | "WebsitePage" | "HomepageSection"
  /// Future: "NewsArticle" | "Event" | "LandingPage" — no schema change needed.
  entityType       String
  /// ID of the entity this revision belongs to.
  entityId         String
  /// Monotonically increasing version number per (entityType, entityId).
  versionNumber    Int
  /// User who created this revision (nullable for system-generated revisions).
  createdByUserId  String?
  /// Optional human-readable note describing what changed.
  changeNote       String?
  /// Full JSON snapshot of the entity at this revision.
  snapshot         Json
  /// When true, this revision was created by a restore action.
  /// Makes restored revisions easy to identify for diffing and rollback chains.
  isRestore        Boolean  @default(false)
  /// FK to the source revision this was restored from (nullable).
  /// Enables: visual diffing, rollback chains, branching, merge history.
  /// Set when isRestore = true; null for normal edits.
  parentRevisionId String?
  createdAt        DateTime @default(now())

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdByUser  User?             @relation(fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  parentRevision ContentRevision?  @relation("RevisionParent", fields: [parentRevisionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  childRevisions ContentRevision[] @relation("RevisionParent")

  @@unique([entityType, entityId, versionNumber])
  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([tenantId, entityType])
  @@index([createdAt])
  @@index([isRestore])
}

// ---------------------------------------------------------------------------
// MediaFolder — DAM folder hierarchy (CMS V2 Slice 11)
//
// Tenant-scoped folder tree for organising MediaAssets.
// Nested folders are supported via self-referencing parentId.
// Folder names are unique within the same parent scope (enforced at app layer).
//
// Deletion policy: prefer archive via archivedAt; hard-delete only when
// the folder has no children and no assigned assets.
// ---------------------------------------------------------------------------

model MediaFolder {
  id         String    @id @default(cuid())
  tenantId   String
  parentId   String?
  name       String
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parent   MediaFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children MediaFolder[] @relation("FolderHierarchy")
  assets   MediaAsset[]

  @@index([tenantId])
  @@index([tenantId, parentId])
  @@index([tenantId, sortOrder])
}

// ---------------------------------------------------------------------------
// WorkspaceFolder — Internal Workspace Folder Hierarchy
//
// Tenant-scoped folder hierarchy used by the internal Workspace module.
// Supports unlimited nesting through a self-referencing parent/child relation.
//
// This model only represents folders.
// Files, documents, permissions and versioning are introduced in later slices.
// ---------------------------------------------------------------------------

model WorkspaceFolder {
  id String @id @default(cuid())

  tenantId String
  parentId String?

  name        String
  description String?

  displayOrder Int @default(0)

  createdByUserId String?
  updatedByUserId String?

  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  parent    WorkspaceFolder?    @relation("WorkspaceFolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children  WorkspaceFolder[]   @relation("WorkspaceFolderHierarchy")
  documents WorkspaceDocument[]

  createdByUser User? @relation("WorkspaceFolderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  updatedByUser User? @relation("WorkspaceFolderUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([tenantId])
  @@index([tenantId, parentId])
  @@index([tenantId, displayOrder])
  @@index([createdByUserId])
  @@index([updatedByUserId])
}

// ---------------------------------------------------------------------------
// WorkspaceDocument — Stable logical document identity
// ---------------------------------------------------------------------------

model WorkspaceDocument {
  id String @id @default(cuid())

  tenantId String
  folderId String?

  name   String
  status WorkspaceDocumentStatus @default(ACTIVE)

  currentVersionId String? @unique

  createdByUserId String?
  updatedByUserId String?

  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  folder WorkspaceFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  currentVersion WorkspaceDocumentVersion?  @relation("WorkspaceDocumentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  versions       WorkspaceDocumentVersion[] @relation("WorkspaceDocumentVersions")

  createdByUser User? @relation("WorkspaceDocumentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  updatedByUser User? @relation("WorkspaceDocumentUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([tenantId])
  @@index([tenantId, folderId])
  @@index([tenantId, status])
  @@index([tenantId, archivedAt])
  @@index([createdByUserId])
  @@index([updatedByUserId])
}

// ---------------------------------------------------------------------------
// WorkspaceDocumentVersion — Immutable stored file version
// ---------------------------------------------------------------------------

model WorkspaceDocumentVersion {
  id String @id @default(cuid())

  tenantId   String
  documentId String

  versionNumber Int
  status        WorkspaceDocumentVersionStatus @default(CURRENT)

  filename  String
  mimeType  String
  sizeBytes Int

  storageKey String
  storageUrl String?
  checksum   String?
  changeNote String?

  createdByUserId String?
  createdAt       DateTime @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  document WorkspaceDocument @relation("WorkspaceDocumentVersions", fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  currentForDocument WorkspaceDocument? @relation("WorkspaceDocumentCurrentVersion")

  createdByUser User? @relation("WorkspaceDocumentVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([documentId, versionNumber])
  @@index([tenantId])
  @@index([tenantId, documentId])
  @@index([tenantId, status])
  @@index([createdByUserId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// MediaTag — Reusable DAM tags (CMS V2 Slice 11)
//
// Tenant-scoped controlled tag vocabulary. Tag names are unique per tenant.
// Tags can be attached to any number of MediaAssets via MediaAssetTag.
// ---------------------------------------------------------------------------

model MediaTag {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assets MediaAssetTag[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// MediaAssetTag — Asset ↔ Tag join (CMS V2 Slice 11)
// ---------------------------------------------------------------------------

model MediaAssetTag {
  id           String   @id @default(cuid())
  tenantId     String
  mediaAssetId String
  tagId        String
  createdAt    DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tag        MediaTag   @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([mediaAssetId, tagId])
  @@index([tagId])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// MediaAssetUsage — Generic cross-module usage tracking (CMS V2 Slice 11)
//
// Tracks where each MediaAsset is referenced, across any entity type.
// Records are upserted when an entity is saved and removed when the
// reference is removed.
//
// entityType: "NewsArticle" | "HomepageSection" | "WebsitePageSection" | …
// fieldPath:  dot-path to the field holding the asset ID, e.g. "heroMediaId"
//             or "config.imageUrl". Null for join-table relationships.
//
// Future entity types can plug in without schema changes.
// ---------------------------------------------------------------------------

model MediaAssetUsage {
  id           String   @id @default(cuid())
  tenantId     String
  mediaAssetId String
  entityType   String
  entityId     String
  fieldPath    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([mediaAssetId, entityType, entityId, fieldPath])
  @@index([tenantId])
  @@index([mediaAssetId])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// ReusableComponent — Centralised reusable content library (CMS V2 Slice 12)
//
// One generic model for all reusable content types:
//   CTA | SPONSOR_BANNER | CONTACT_CARD | FAQ | QUOTE | STATISTICS |
//   ANNOUNCEMENT | RICH_TEXT
//
// The `config` JSON field holds the type-specific payload.
// No separate tables per type — all types share this model.
//
// Publishing mirrors HomepageSection / WebsitePageSection patterns.
// Revisions are tracked via ContentRevision (entityType = "ReusableComponent").
// Usage is tracked via ReusableComponentUsage.
// Audit events use moduleKey = "reusable-components".
// ---------------------------------------------------------------------------

model ReusableComponent {
  id          String  @id @default(cuid())
  tenantId    String
  /// Component type key — one of the REUSABLE_COMPONENT_TYPES registry keys.
  type        String
  /// Human-readable admin title.
  title       String
  /// URL-safe unique identifier within the tenant (auto-generated from title).
  slug        String
  /// Optional description shown in the picker and library view.
  description String?
  /// Type-specific configuration stored as a JSON object.
  config      Json    @default("{}")

  // ── Publishing workflow (mirrors HomepageSection / WebsitePageSection) ──────
  /// Publish status — "DRAFT" | "PUBLISHED".
  publishStatus      String    @default("DRAFT")
  publishedAt        DateTime?
  unpublishedAt      DateTime?
  lastPublishedAt    DateTime?
  scheduledPublishAt DateTime?

  // ── Editorial approval workflow ─────────────────────────────────────────────
  /// Approval status — "NOT_REQUIRED" | "DRAFT" | "IN_REVIEW" | "APPROVED" | "CHANGES_REQUESTED".
  approvalStatus    String    @default("NOT_REQUIRED")
  reviewerUserId    String?
  reviewRequestedAt DateTime?
  reviewedAt        DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  approvalNote      String?
  approvedByUserId  String?
  rejectedByUserId  String?

  // ── Lifecycle ──────────────────────────────────────────────────────────────
  createdByUserId String?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdByUser  User?  @relation("ReusableComponentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reviewerUser   User?  @relation("ReusableComponentReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  approvedByUser User?  @relation("ReusableComponentApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  rejectedByUser User?  @relation("ReusableComponentRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  usages ReusableComponentUsage[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, publishStatus])
  @@index([tenantId, archivedAt])
  @@index([tenantId, updatedAt])
}

// ---------------------------------------------------------------------------
// ReusableComponentUsage — Cross-module usage tracking (CMS V2 Slice 12)
//
// Records where each ReusableComponent is referenced.
// Mirrors the MediaAssetUsage pattern — future entity types can plug in
// without schema changes.
//
// entityType: "HomepageSection" | "WebsitePageSection" | "NewsArticle" | …
// fieldPath:  dot-path within the entity, e.g. "config.componentId"
// ---------------------------------------------------------------------------

model ReusableComponentUsage {
  id          String   @id @default(cuid())
  tenantId    String
  componentId String
  entityType  String
  entityId    String
  fieldPath   String   @default("config")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  component ReusableComponent @relation(fields: [componentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([componentId, entityType, entityId, fieldPath])
  @@index([tenantId])
  @@index([componentId])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// TenantSfvConfig — Tenant-scoped SFV / ClubCorner integration configuration
//
// Slice: Tenant-Scoped SFV Integration Configuration
//
// One record per tenant (@@unique on tenantId). The Tenant.sfvConfig relation
// is nullable — tenants without SFV integration have no row here.
//
// Design invariants:
//   - Exactly one config per tenant (1:1 via @unique).
//   - clubId: positive integer SFV club identifier (e.g. 483 for FC Allschwil).
//   - defaultSeasonId: positive integer SFV season identifier used when no
//     explicit seasonId is provided by the caller (e.g. 2027 for 2026/2027).
//   - organisationId: optional SFV organisation identifier. Null when not
//     assigned by SFV or not required by the integration.
//   - enabled: when false the integration is administratively disabled and
//     must be treated as "not configured" by all consumers.
//   - createdAt / updatedAt: standard lifecycle timestamps.
//
// Security invariant:
//   Future services resolve clubId from this config (via tenantId from session)
//   instead of accepting caller-supplied clubId values. Tenant A cannot access
//   Tenant B configuration because all lookups go through tenantId.
//
// NOT included (explicit exclusions):
//   - cached SFV data
//   - sync state or run history
//   - player or match data
//   - picture or media blobs
//   - diagnostics snapshots
//   - season-level metadata
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// MatchExternalMapping — external-provider identity for a match/fixture.
//
// Holds the mapping between a canonical SportClubEvo Event (type=MATCH) and
// a match record in an external provider (e.g. SFV / ClubCorner). One row
// per provider + externalMatchId + tenant combination.
//
// SFV matchId is the canonical external identifier (externalMatchId). It is
// the only programmatic integration key. matchNumber is display-only.
//
// Field ownership:
//   - SFV-owned (updated every sync): everything in this model.
//   - Locally managed (on Event, never overwritten by sync):
//       pitchCode, homeDressingRoomCode, awayDressingRoomCode, remarks,
//       websiteVisible, infoboardVisible, wochenplanVisible, reviewStage,
//       sortOrder, description, internal assignment fields.
//
// Opponent strategy:
//   - homeTeamId / awayTeamId: nullable FKs to canonical Team records.
//     Set when the team is a tenant-owned Team resolved via TeamExternalMapping.
//     Null when the team is an external opponent not in the canonical Team table.
//   - Provider team names (providerHomeTeamName / providerAwayTeamName) are
//     always stored for display fallback.
//   - External opponents are NEVER created as tenant-owned Teams during match sync.
//
// The unique constraint prevents duplicate SFV match mappings per tenant.
// ---------------------------------------------------------------------------

model MatchExternalMapping {
  id                     String    @id @default(cuid())
  /// Owning tenant. Scopes all lookups and mutations to a single tenant.
  tenantId               String
  /// The canonical Event (type=MATCH) this mapping belongs to.
  eventId                String    @unique
  /// External provider identifier, e.g. "SFV".
  provider               String
  /// SFV matchId — the canonical external identity. Never use matchNumber for identity.
  externalMatchId        Int
  /// SFV seasonId at time of sync.
  externalSeasonId       Int
  /// Display-only SFV match number. Never used as identity or integration key.
  matchNumber            Int?
  /// SFV teamId for the home team (teamAId in ClubScheduleEntry).
  providerHomeTeamId     Int
  /// SFV teamId for the away team (teamBId in ClubScheduleEntry).
  providerAwayTeamId     Int
  /// Provider home team display name for fallback rendering.
  providerHomeTeamName   String?
  /// Provider away team display name for fallback rendering.
  providerAwayTeamName   String?
  /// Canonical local Team for home side. Null when external opponent.
  homeTeamId             String?
  /// Canonical local Team for away side. Null when external opponent.
  awayTeamId             String?
  /// CLUB-DIRECTORY-02: canonical ExternalClub-Directory ExternalTeam for the
  /// home side, when that side is an external opponent (i.e. homeTeamId is
  /// null). Resolved/created by the discovery flow in
  /// lib/club-directory/discovery-service.ts during schedule sync — never a
  /// second/parallel opponent representation. Null until discovery has run
  /// for this side, or when the side is a club-owned team.
  homeExternalTeamId     String?
  /// See homeExternalTeamId — away-side equivalent.
  awayExternalTeamId     String?
  /// Raw SFV matchState integer, preserved exactly as received. Never interpreted.
  providerMatchState     Int?
  /// Human-readable match state name from provider, for admin reference.
  providerMatchStateName String?
  /// Home team score (teamA score in SFV terms). Null when not yet played.
  scoreHome              Int?
  /// Away team score (teamB score in SFV terms). Null when not yet played.
  scoreAway              Int?
  /// Provider league identifier.
  providerLeagueId       Int?
  /// Provider league name.
  providerLeagueName     String?
  /// Provider division identifier.
  providerDivisionId     Int?
  /// Provider division name.
  providerDivisionName   String?
  /// Provider round number.
  providerRoundNbr       Int?
  /// Provider organisation identifier.
  providerOrganisationId Int?
  /// Provider playground/venue identifier.
  providerPlaygroundId   Int?
  /// Provider venue/playground name for display.
  providerVenueName      String?
  /// Provider season name.
  providerSeasonName     String?
  /// Timestamp of the last successful sync that touched this mapping.
  lastSyncedAt           DateTime
  /// Timestamp of the last successful match-detail sync for this mapping.
  /// Null until the first match-detail synchronization run has been executed.
  detailSyncedAt         DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  event            Event         @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  homeTeam         Team?         @relation("MatchHomeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  awayTeam         Team?         @relation("MatchAwayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  /// CLUB-DIRECTORY-02: canonical Club Directory identity for external sides.
  homeExternalTeam ExternalTeam? @relation("MatchHomeExternalTeam", fields: [homeExternalTeamId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  awayExternalTeam ExternalTeam? @relation("MatchAwayExternalTeam", fields: [awayExternalTeamId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  /// Prevents duplicate SFV match mappings within the same tenant.
  @@unique([tenantId, provider, externalMatchId])
  @@index([tenantId, provider])
  @@index([tenantId, provider, externalSeasonId])
  @@index([eventId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([homeExternalTeamId])
  @@index([awayExternalTeamId])
}

model TenantSfvConfig {
  id                     String    @id @default(cuid())
  tenantId               String    @unique
  /// Positive integer SFV club identifier (e.g. 483 for FC Allschwil).
  /// Must be a numeric identifier as returned by the SFV API.
  clubId                 Int
  /// Positive integer SFV season identifier used as the default when no
  /// explicit seasonId is provided (e.g. 2027 for the 2026/2027 season).
  defaultSeasonId        Int
  /// Optional SFV organisation identifier. Null when not assigned or not required.
  organisationId         Int?
  /// When false, the SFV integration is administratively disabled.
  /// Consumers must treat disabled configs as "not configured".
  enabled                Boolean   @default(true)
  /// Completion time of the most recent fully successful tenant-level team synchronization.
  lastTeamSyncAt         DateTime?
  /// Completion time of the most recent fully successful tenant-level schedule synchronization.
  lastScheduleSyncAt     DateTime?
  /// Completion time of the most recent fully successful tenant-level match-detail synchronization.
  lastMatchDetailSyncAt  DateTime?
  /// Completion time of the most recent fully successful tenant-level competition synchronization.
  lastCompetitionSyncAt  DateTime?
  /// CLUB-DIRECTORY-05: completion time of the most recent fully successful
  /// tenant-level SFV club master import (see
  /// lib/integrations/sfv/sync/club-master-import.ts). Null until the first
  /// run. Distinct from lastScheduleSyncAt — this tracks the broadest-
  /// reliable-coverage club pre-population run, not schedule/match sync.
  lastClubMasterImportAt DateTime?
  /// SFV-MATCH-SYNC-HOTFIX-01: set while an automatic (cron-triggered) schedule
  /// sync is in progress for this tenant; null when idle. Used as an atomic,
  /// TTL-based overlap guard — see claimSfvScheduleSyncLock() in
  /// tenant-config-repository.ts. Never read/written by manual admin-triggered
  /// syncs, which remain unaffected by this lock.
  syncLockedAt           DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([enabled])
}

// ═════════════════════════════════════════════════════════════════════════════
// CLUB-DIRECTORY-01 — Canonical external club/team directory
//
// Supersedes the earlier "Opponent" foundation (MC-04B, migration
// 20260722233000_opponent_domain_foundation). That foundation modeled a flat,
// team-level-only "Opponent" with no club/team split, had no write path, and
// was never wired into Matchcenter's actual home/away rendering (which reads
// MatchExternalMapping.providerHomeTeamName / providerAwayTeamName directly).
// It is removed by this migration and replaced by the model below.
//
// Rationale ("opponent" is contextual — the same club/team can be an opponent
// in Matchcenter, a participant in a friendly, a TournamentCenter participant,
// or shown on Infoboard/Website):
//   - ExternalClub  — canonical external club identity (e.g. "SV Muttenz").
//   - ExternalTeam  — canonical external team identity, always scoped to one
//                      ExternalClub (e.g. "SV Muttenz B1").
//
// Identity rule: names are never identity keys.
//   - Provider-linked records are identified by provider + provider-assigned
//     numeric id (ExternalClubProviderMapping / ExternalTeamProviderMapping).
//   - Manually-created records use the SportClubEvo canonical cuid — no
//     auto-merge by name, ever. A manual record may later be linked to a
//     provider identity by creating a mapping row.
//
// Both models are tenant-scoped (tenant isolation first; no shared global
// directory introduced by this slice).
// ═════════════════════════════════════════════════════════════════════════════

model ExternalClub {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Canonical long/official name (e.g. "SV Muttenz"). Tenant-managed —
  /// provider sync (see ExternalClubProviderMapping) never overwrites this.
  name            String
  /// Optional compact name for constrained UI contexts. Tenant-managed.
  shortName       String?
  /// Optional alternative/legacy name. Tenant-managed.
  alternativeName String?
  /// Optional website URL. Tenant-managed.
  website         String?
  /// Optional free-form location/address. Tenant-managed.
  location        String?
  /// Persisted crest/logo URL (e.g. Vercel Blob CDN URL). Cached once at
  /// club level so Matchcenter, TournamentCenter, Infoboard, and Website can
  /// all reuse it without re-fetching from any provider. Tenant-managed once
  /// set manually; may also be populated from a provider sync (see
  /// ExternalClubProviderMapping.providerLogoUrl) when no tenant override exists.
  logoUrl         String?
  /// Free-form provenance note (e.g. "Erstellt via SFV-Sync", "Manuell erfasst").
  notes           String?
  /// How this record originated. "MANUAL" (Club Admin) or "SFV" (first seen via
  /// provider sync). Informational only — never gates identity or behaviour.
  source          String    @default("MANUAL")
  /// Null = active. Set = archived (soft-delete pattern used across this codebase).
  archivedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providerMappings ExternalClubProviderMapping[]
  externalTeams    ExternalTeam[]

  @@index([tenantId])
  @@index([tenantId, archivedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// ExternalClubProviderMapping — provider identity for an ExternalClub.
//
// Field ownership:
//   - Provider-owned (refreshed on sync): providerClubName, providerLogoUrl,
//     providerWebsite, providerIsActive, lastSyncedAt.
//   - Never overwrites ExternalClub.name / shortName / alternativeName /
//     website / logoUrl / location / notes — those stay tenant-managed once set.
// ─────────────────────────────────────────────────────────────────────────────

model ExternalClubProviderMapping {
  id       String @id @default(cuid())
  tenantId String

  externalClubId String
  externalClub   ExternalClub @relation(fields: [externalClubId], references: [id], onDelete: Cascade)

  /// External provider identifier, e.g. "SFV".
  provider         String
  /// Provider-assigned numeric club identifier (SFV: TeamDetail.clubNumber).
  providerClubId   Int
  /// Provider-reported club name at time of last sync.
  providerClubName String?
  /// Provider-reported club logo/crest URL at time of last sync, if the
  /// provider exposes one. Copied into ExternalClub.logoUrl only when no
  /// tenant-managed logo is already set (see lib/club-directory/logo.ts).
  providerLogoUrl  String?
  /// Provider-reported website, if any.
  providerWebsite  String?
  /// Whether the provider currently reports this club as active.
  providerIsActive Boolean   @default(true)
  /// Timestamp of the last successful sync that touched this mapping. Null
  /// until the first sync/refresh runs (e.g. immediately after manual linking).
  lastSyncedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, providerClubId])
  @@index([tenantId, provider])
  @@index([externalClubId])
}

model ExternalTeam {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// The ExternalClub this team belongs to. Every ExternalTeam belongs to
  /// exactly one ExternalClub — club/team split is structural, not inferred.
  externalClubId String
  externalClub   ExternalClub @relation(fields: [externalClubId], references: [id], onDelete: Cascade)

  /// Canonical long/display name (e.g. "SV Muttenz B1"). Tenant-managed.
  name            String
  /// Optional compact name. Tenant-managed.
  shortName       String?
  /// Optional alternative name. Tenant-managed.
  alternativeName String?
  /// Optional free-form age/category label (e.g. "B1", "Herren 1").
  /// Deliberately a free-form string, not the tenant TeamCategory enum —
  /// external teams are not tenant-owned Teams and must not be coerced into
  /// tenant category semantics.
  categoryLabel   String?
  /// Optional team-level logo override. When null, consumers fall back to
  /// externalClub.logoUrl (see lib/club-directory/logo.ts) — SFV evidence
  /// shows provider team pictures are actually club-level crests, so a
  /// per-team override is the exception, not the default.
  logoUrl         String?
  source          String    @default("MANUAL")
  archivedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providerMappings ExternalTeamProviderMapping[]

  // CLUB-DIRECTORY-02: reverse relations for the canonical opponent identity
  // consumed directly by Matchcenter (see MatchExternalMapping.homeExternalTeamId
  // / awayExternalTeamId below) — never a second/parallel opponent model.
  matchMappingsAsHome MatchExternalMapping[] @relation("MatchHomeExternalTeam")
  matchMappingsAsAway MatchExternalMapping[] @relation("MatchAwayExternalTeam")

  // TOURNAMENTCENTER-01B: canonical multi-team tournament participation —
  // an ExternalTeam (e.g. a guest club's team from the Club Directory) may
  // participate in many tournaments alongside tenant-owned Teams.
  tournamentParticipations TournamentParticipant[]

  @@index([tenantId])
  @@index([tenantId, archivedAt])
  @@index([externalClubId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ExternalTeamProviderMapping — provider identity for an ExternalTeam.
//
// providerSeasonId uses 0 as the explicit seasonless sentinel (PostgreSQL
// unique constraints allow multiple NULL values, so a nullable season
// identifier would not safely prevent duplicate seasonless provider identities
// — same rationale as the superseded OpponentExternalMapping).
// ─────────────────────────────────────────────────────────────────────────────

model ExternalTeamProviderMapping {
  id       String @id @default(cuid())
  tenantId String

  externalTeamId String
  externalTeam   ExternalTeam @relation(fields: [externalTeamId], references: [id], onDelete: Cascade)

  /// External provider identifier, e.g. "SFV".
  provider               String
  /// Provider-assigned numeric team identifier (SFV: TeamDetail.teamId /
  /// ClubScheduleEntry.teamAId/teamBId / ClubRankingEntry.teamId).
  providerTeamId         Int
  providerSeasonId       Int       @default(0)
  /// Provider-reported team name at time of last sync.
  providerTeamName       String?
  /// Provider-reported club identifier at time of sync, for traceability only
  /// (e.g. SFV clubNumber seen alongside this team). Not used for identity —
  /// club membership is the structural ExternalTeam.externalClubId link, set
  /// by the Club Admin, never inferred from this field.
  providerClubId         Int?
  /// Provider-reported organisation identifier.
  providerOrganisationId Int?
  /// Provider-reported team picture URL/reference at time of last sync.
  /// SFV fetchTeamPicture() returns club-level imagery keyed by teamId — see
  /// lib/club-directory/logo.ts for how this feeds ExternalClub.logoUrl.
  providerLogoUrl        String?
  /// CLUB-DIRECTORY-04: provider-reported league/competition name at time of
  /// last sync (e.g. "3. Liga", "Senioren 30+"). SFV source: ClubRankingEntry
  /// .leagueName (GET /api/club/ranking), which reports this PER TEAM for
  /// every team appearing in the tenant's current standings — own teams and
  /// opponents alike (see lib/integrations/sfv/sync/team-competition-context.ts).
  /// Provider-owned — refreshed on every sync, never a substitute for
  /// ExternalTeam.name/categoryLabel and never displayed as editable
  /// canonical identity. Null when the provider does not currently report
  /// standings coverage for this team.
  providerLeagueName     String?
  /// CLUB-DIRECTORY-04: provider-reported competition group name at time of
  /// last sync (e.g. "Gruppe 1", "Promotion"). SFV source: ClubRankingEntry
  /// .groupName. Provider-owned, same refresh/ownership rules as
  /// providerLeagueName above.
  providerGroupName      String?
  providerIsActive       Boolean   @default(true)
  lastSyncedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, providerTeamId, providerSeasonId])
  @@index([tenantId, provider])
  @@index([externalTeamId])
}

// =============================================================================
// TRAINING-CORE-01: Canonical Training Foundation
//
// Introduces TrainingSeries — the canonical recurring training identity used
// by every SportClubEvo training-related module.
//
// Architecture:
//   Organisation → Team → TeamSeason → TrainingSeries
//
// Canonical principles:
//   - One TrainingSeries = one recurring training identity (e.g. "E1 Tuesday Training").
//   - A TrainingSeries is NEVER duplicated for different weekplans / pitches / rooms.
//   - Alternative weekplans configure the same TrainingSeries.
//   - Every TrainingSeries belongs to exactly one TeamSeason (never directly to Team).
//   - No resource allocation, no weekplans, no publishing at this layer.
//
// Future consumers:
//   Training Planner, Website Weekplanner, Team Pages, Infoboards,
//   Resource Planning, Calendar, Mobile App.
// =============================================================================

// ---------------------------------------------------------------------------
// TrainingSeriesStatus — lifecycle status of a TrainingSeries.
//
// ACTIVE   — Series is live and generates occurrences.
// INACTIVE — Series is paused; no occurrences generated. Can be reactivated.
// ARCHIVED — Series is closed. archivedAt is set. Restore sets it back to INACTIVE.
// ---------------------------------------------------------------------------
enum TrainingSeriesStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Weekday — ISO-aligned weekday enum for training recurrence rules.
// ---------------------------------------------------------------------------
enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// ---------------------------------------------------------------------------
// TrainingSeries — canonical recurring training identity.
//
// Represents a single, stable recurring training slot for a TeamSeason.
// Examples: "E1 Tuesday Training", "FF17 Thursday Training".
//
// Architecture invariants:
//   - tenantId always comes from a trusted session context.
//   - Belongs to exactly one TeamSeason (TeamSeason owns it via teamSeasonId).
//   - Soft-archive: archivedAt is set on archive; no hard delete.
//   - startsAt / endsAt are time-of-day strings ("HH:mm") in the given timezone.
//   - validFrom / validUntil define the calendar span of the series.
//   - Recurrence is represented by TrainingSeriesRecurrenceDay rows.
//
// Title uniqueness: TRAINING-PLANS-01 corrective — the strict @@unique([teamSeasonId, title])
// constraint introduced by TRAINING-CORE-01 was removed because it blocks valid operational
// scenarios (e.g. two parallel training groups sharing the same display title within a
// TeamSeason, such as "Goalkeeping Training" on both Monday and Wednesday). Title validation
// (non-empty, trimmed, reasonable length) is retained at the service layer. True duplicate
// identity prevention relies on plan assignments rather than title uniqueness alone.
//
// Security invariants:
//   - All queries scope by tenantId (via team.tenantId join).
//   - Tenant A cannot read or modify Tenant B's training series.
// ---------------------------------------------------------------------------
model TrainingSeries {
  id           String               @id @default(cuid())
  /// Owning tenant. All queries must be scoped by tenantId.
  tenantId     String
  /// Owning TeamSeason. One series belongs to exactly one TeamSeason.
  teamSeasonId String
  /// Human-readable training identity. Non-empty, trimmed; validated at service layer.
  title        String
  description  String?
  /// Lifecycle status of this series.
  status       TrainingSeriesStatus @default(ACTIVE)
  /// Time-of-day the training starts ("HH:mm"), interpreted in `timezone`.
  startsAt     String
  /// Time-of-day the training ends ("HH:mm"), interpreted in `timezone`.
  endsAt       String
  /// IANA timezone identifier (e.g. "Europe/Zurich"). Defaults to UTC.
  timezone     String               @default("UTC")
  /// Optional calendar start of this series. Null means no lower bound.
  validFrom    DateTime?
  /// Optional calendar end of this series. Null means no upper bound.
  validUntil   DateTime?
  /// Set when the series is archived. Null when not archived.
  archivedAt   DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  tenant          Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  teamSeason      TeamSeason                    @relation(fields: [teamSeasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  recurrenceDays  TrainingSeriesRecurrenceDay[]
  planAssignments TrainingPlanAssignment[]
  allocations     TrainingAllocation[]
  // TRAININGCENTER-02: canonical generated occurrences of this series
  sessions        TrainingSession[]

  @@index([tenantId])
  @@index([teamSeasonId])
  @@index([tenantId, status])
  @@index([teamSeasonId, status])
}

// ---------------------------------------------------------------------------
// TrainingSeriesRecurrenceDay — weekly recurrence days for a TrainingSeries.
//
// A TrainingSeries may recur on one or more weekdays per week.
// Each row represents one active weekday in the series' recurrence pattern.
//
// TRAININGCENTER-03A: startsAt/endsAt — optional per-weekday time override.
//   A recurring series can meet at different times on different weekdays
//   (e.g. Monday 17:00–18:00, Wednesday 16:00–17:00). When both are set,
//   they take precedence over the parent TrainingSeries.startsAt/endsAt for
//   occurrences generated on this weekday. When either is null, generation
//   falls back to the parent series' startsAt/endsAt for this weekday.
//   Additive/nullable by design — existing rows (uniform time across all
//   weekdays) continue to resolve exactly as before.
//
// Architecture invariants:
//   - Duplicate (trainingSeriesId, weekday) is prevented at DB level.
//   - Cascade-delete with the parent TrainingSeries.
//   - Extensible: future recurrence types (bi-weekly, monthly) would add
//     new fields or sibling models without changing this table.
// ---------------------------------------------------------------------------
model TrainingSeriesRecurrenceDay {
  id               String   @id @default(cuid())
  trainingSeriesId String
  weekday          Weekday
  /// Per-weekday override of the start time ("HH:mm"). Null = fall back to TrainingSeries.startsAt.
  startsAt         String?
  /// Per-weekday override of the end time ("HH:mm"). Null = fall back to TrainingSeries.endsAt.
  endsAt           String?
  createdAt        DateTime @default(now())

  trainingSeries TrainingSeries @relation(fields: [trainingSeriesId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([trainingSeriesId, weekday])
  @@index([trainingSeriesId])
}

// =============================================================================
// TRAINING-PLANS-01: Tenant-Defined Training Plans
//
// Introduces TrainingPlan — a tenant-defined operational configuration
// container that configures existing canonical TrainingSeries records.
//
// Architecture:
//   TeamSeason → TrainingSeries → TrainingPlanAssignment → TrainingPlan
//
// Canonical principles:
//   - A TrainingPlan NEVER duplicates TrainingSeries — it configures them.
//   - One TrainingSeries may appear in multiple plans with different schedules.
//   - Tenants freely name plans ("Standard-Wochenplan", "Ferienplan", etc.).
//   - No plan names or plan types are hard-coded.
//   - At most one non-archived default plan per (tenantId, seasonId).
//   - No activation, resource allocation, or dated occurrence resolution here.
// =============================================================================

// ---------------------------------------------------------------------------
// TrainingPlanStatus — administrative lifecycle status of a TrainingPlan.
//
// ACTIVE   — Plan is administratively available for use.
// INACTIVE — Plan is paused / draft. Can be reactivated.
// ARCHIVED — Plan is closed. archivedAt is set. Cannot be the default plan.
//
// Note: ACTIVE/INACTIVE/ARCHIVED describe administrative availability.
//       They do NOT indicate operational activation (which is TRAINING-ACTIVATION-01).
// ---------------------------------------------------------------------------
enum TrainingPlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// ---------------------------------------------------------------------------
// MissingAssignmentBehavior — fallback strategy when a TrainingSeries has no
// TrainingPlanAssignment in a given plan.
//
// FALLBACK_TO_DEFAULT — Future resolution may use the assignment from the
//                        season's default plan (relevant for non-default plans).
// NOT_SCHEDULED       — The training is not scheduled under this plan.
// ---------------------------------------------------------------------------
enum MissingAssignmentBehavior {
  FALLBACK_TO_DEFAULT
  NOT_SCHEDULED
}

// ---------------------------------------------------------------------------
// TrainingPlanAssignmentStatus — whether a specific series is scheduled
// within a given plan assignment.
//
// SCHEDULED     — The series is scheduled (possibly with time overrides).
// NOT_SCHEDULED — The series is explicitly excluded in this plan.
// ---------------------------------------------------------------------------
enum TrainingPlanAssignmentStatus {
  SCHEDULED
  NOT_SCHEDULED
}

// ---------------------------------------------------------------------------
// TrainingPlan — tenant-defined operational configuration for a season.
//
// Each plan configures the same canonical TrainingSeries records with
// potentially different times or scheduled/not-scheduled status.
//
// Architecture invariants:
//   - Belongs to exactly one tenant and one season.
//   - isDefault: at most one non-archived default per (tenantId, seasonId).
//     Enforced via a partial unique index (archivedAt IS NULL AND isDefault = true).
//   - Name uniqueness: unique among non-archived plans within (tenantId, seasonId).
//     Enforced via a partial unique index (archivedAt IS NULL).
//   - Archiving the current default plan is rejected at the service layer.
//   - displayOrder: tenant-controlled display sequence.
//   - missingAssignmentBehavior: what to do when a TrainingSeries has no
//     assignment in this plan.
//
// Security invariants:
//   - All queries must scope by tenantId.
//   - Tenant A cannot read or modify Tenant B's plans.
// ---------------------------------------------------------------------------
model TrainingPlan {
  id                        String                    @id @default(cuid())
  /// Owning tenant. All queries must be scoped by tenantId.
  tenantId                  String
  /// Owning season. A plan is always season-specific.
  seasonId                  String
  /// Tenant-defined plan name (e.g. "Standard-Wochenplan", "Ferienplan").
  name                      String
  description               String?
  /// Administrative lifecycle status. Not equivalent to operational activation.
  status                    TrainingPlanStatus        @default(ACTIVE)
  /// True for at most one non-archived plan per (tenantId, seasonId).
  isDefault                 Boolean                   @default(false)
  /// Tenant-controlled display sequence.
  displayOrder              Int                       @default(0)
  /// Fallback strategy when a TrainingSeries has no assignment in this plan.
  missingAssignmentBehavior MissingAssignmentBehavior @default(FALLBACK_TO_DEFAULT)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  /// Set when the plan is archived. Null when not archived.
  archivedAt                DateTime?

  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  season      Season                   @relation(fields: [seasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignments TrainingPlanAssignment[]

  @@index([tenantId])
  @@index([tenantId, seasonId])
  @@index([tenantId, seasonId, status])
  @@index([tenantId, isDefault])
}

// ---------------------------------------------------------------------------
// TrainingPlanAssignment — connects one TrainingSeries to one TrainingPlan.
//
// Provides plan-specific configuration (time overrides, scheduled status)
// for a canonical TrainingSeries within a given plan.
//
// Time overrides:
//   - startTimeOverride / endTimeOverride: "HH:mm" strings (same format as
//     TrainingSeries.startsAt / endsAt). Null means inherit from series.
//   - timezoneOverride: IANA timezone. Null means inherit from series.
//   - Effective values = override ?? trainingSeries.canonical value.
//
// Architecture invariants:
//   - At most one assignment per (trainingPlanId, trainingSeriesId).
//   - tenantId must match both TrainingPlan.tenantId and TrainingSeries.tenantId.
//   - Season consistency: TrainingPlan.seasonId must match the season context
//     of the TrainingSeries' TeamSeason.
//   - No resource allocation fields (pitches, halls, coaches) — those are
//     TRAINING-ALLOCATIONS-01.
// ---------------------------------------------------------------------------
model TrainingPlanAssignment {
  id                String                       @id @default(cuid())
  /// Owning tenant. Must match both TrainingPlan and TrainingSeries tenantId.
  tenantId          String
  trainingPlanId    String
  trainingSeriesId  String
  /// Override the canonical startTime for this series within this plan.
  startTimeOverride String?
  /// Override the canonical endTime for this series within this plan.
  endTimeOverride   String?
  /// Override the canonical timezone for this series within this plan.
  timezoneOverride  String?
  /// Whether the series is scheduled within this plan.
  status            TrainingPlanAssignmentStatus @default(SCHEDULED)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  trainingPlan   TrainingPlan   @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  trainingSeries TrainingSeries @relation(fields: [trainingSeriesId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// At most one assignment per plan+series combination.
  @@unique([trainingPlanId, trainingSeriesId])
  @@index([tenantId])
  @@index([trainingPlanId])
  @@index([trainingSeriesId])
  @@index([tenantId, trainingPlanId])
}

// =============================================================================
// TRAINING-ALLOCATIONS-01: Canonical Training Resource Allocation
//
// Introduces TrainingAllocation — the single source of truth for which
// FacilityResources are allocated to a canonical TrainingSeries.
//
// Architecture:
//   TrainingSeries → TrainingAllocation → FacilityResource
//
// Canonical principles:
//   - One TrainingSeries may hold many TrainingAllocation rows (one per
//     FacilityResource used: full pitch, half-pitch pairs, dressing room, etc.).
//   - Duplicate allocation of the same resource to the same series is prevented
//     at DB level via @@unique([trainingSeriesId, facilityResourceId]).
//   - All queries must be scoped by tenantId.
//   - Archived FacilityResources (status = ARCHIVED) cannot receive new
//     allocations; existing historical rows are preserved.
//   - No resource-type-specific code — everything works through FacilityResource.
//   - No weekplanner, infoboard, or website publication at this layer.
// =============================================================================

// ---------------------------------------------------------------------------
// TrainingAllocation — connects one TrainingSeries to one FacilityResource.
//
// Each row represents a single resource allocation for a recurring training:
//   e.g. "E1 Tuesday Training uses Half Pitch A West"
//
// Architecture invariants:
//   - tenantId must match both TrainingSeries.tenantId and FacilityResource.tenantId.
//   - @@unique([trainingSeriesId, facilityResourceId]) prevents duplicates.
//   - displayOrder controls the UI presentation sequence.
//   - notes is optional free text (e.g. "shared with another team").
//   - Cascade-delete when the parent TrainingSeries is deleted.
//   - Cascade-delete when the parent FacilityResource is deleted.
//
// Security invariants:
//   - All queries must scope by tenantId.
//   - Tenant A cannot read or modify Tenant B's allocations.
// ---------------------------------------------------------------------------
model TrainingAllocation {
  id                 String   @id @default(cuid())
  /// Owning tenant. All queries must be scoped by tenantId.
  tenantId           String
  /// The canonical training series this allocation belongs to.
  trainingSeriesId   String
  /// The facility resource allocated to this training series.
  facilityResourceId String
  /// Optional free-text note for this allocation.
  notes              String?
  /// Display position within the allocations for this training series.
  displayOrder       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  trainingSeries   TrainingSeries   @relation(fields: [trainingSeriesId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  facilityResource FacilityResource @relation(fields: [facilityResourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Prevent duplicate allocation of the same resource to the same training series.
  @@unique([trainingSeriesId, facilityResourceId])
  @@index([tenantId])
  @@index([trainingSeriesId])
  @@index([facilityResourceId])
  @@index([tenantId, trainingSeriesId])
}

// =============================================================================
// TRAININGCENTER-02: Canonical Training Session Engine (Foundation)
//
// Introduces TrainingSession — the canonical, dated occurrence generated
// from a recurring TrainingSeries. This is the single row that every
// downstream consumer (Weekplanner, Dayplanner, Website, Infoboard,
// Attendance, Weather, Communication) reads from. None of those consumers
// generate their own occurrences — they all resolve against this table.
//
// Architecture:
//   TrainingSeries → TrainingSession (generated) → many consumers
//
// Canonical principle — "one generated session, many consumers":
//   - Each (trainingSeriesId, date) pair produces exactly one TrainingSession
//     row, enforced by @@unique([trainingSeriesId, date]).
//   - Generation (lib/training/session-generation-service.ts) is idempotent:
//     re-running it for the same series/window never creates duplicates and
//     only touches rows whose derived schedule actually changed.
//   - Consumers never write their own copies of a session; they either read
//     TrainingSession directly or (in the future) attach override/annotation
//     rows that point back at a TrainingSession by id.
//
// Future compatibility (explicitly NOT implemented in this PR):
//   - `status` already models CANCELLED / POSTPONED / MOVED so those lifecycle
//     states can be introduced later without a breaking schema change.
//     Generation today only ever writes/reads SCHEDULED occurrences.
//   - Holidays / skipped dates / one-off exceptions: future exception rows
//     (e.g. a `TrainingSeriesException` table keyed by trainingSeriesId+date)
//     can be consulted by the generator to skip or move a date without any
//     change to this model.
//   - Weekplanner overrides (pitch, resource, dressing room, trainer, time,
//     cancellation) belong in a future `TrainingSessionWeekplanOverride`
//     model that references `TrainingSession.id` + a Weekplan id. Multiple
//     weekplans (Standard/Bad Weather/Winter/Summer) each attach their own
//     override rows to the SAME TrainingSession — the session itself is never
//     duplicated per plan.
//   - Attendance, weather snapshots, and notes are future models that hang
//     off `TrainingSession.id` via a foreign key; none of them require
//     changes to this table.
//
// Denormalisation:
//   - `teamSeasonId` is copied from the parent TrainingSeries at generation
//     time so every consumer can filter by team/season without an extra join.
//     TrainingSeries.teamSeasonId is not mutable via the service layer today,
//     so this copy cannot drift.
//   - `weekday`, `timezone`, `startAt`, `endAt` are the resolved, generated
//     values for this specific date. They are recomputed (and only updated
//     when they actually change) on every regeneration run, so they always
//     reflect the series' current recurrence configuration.
// =============================================================================

// ---------------------------------------------------------------------------
// TrainingSessionStatus — lifecycle status of a generated TrainingSession.
//
// SCHEDULED  — Normal, generated occurrence. The only status the generator
//              writes today.
// CANCELLED  — Reserved for future exception handling (holidays, ad-hoc
//              cancellations). Not set by any code in this PR.
// POSTPONED  — Reserved for future exception handling (session pushed to a
//              later date without changing its canonical identity). Not set
//              by any code in this PR.
// MOVED      — Reserved for future exception handling (session moved to a
//              different date/time/resource while keeping its identity). Not
//              set by any code in this PR.
// ---------------------------------------------------------------------------
enum TrainingSessionStatus {
  SCHEDULED
  CANCELLED
  POSTPONED
  MOVED
  /// TRAININGCENTER-03A-FIX: this generated occurrence's date no longer
  /// satisfies its TrainingSeries' recurrence rule (weekday removed,
  /// validFrom/validUntil narrowed, ...). Distinct from CANCELLED, which
  /// means "this actual scheduled training was cancelled" — RECURRENCE_REMOVED
  /// means "this occurrence is no longer part of the series definition".
  /// Reconciliation (see session-generation-service.ts) is the only writer
  /// of this status; it never overwrites CANCELLED/POSTPONED/MOVED rows, and
  /// it clears RECURRENCE_REMOVED back to SCHEDULED if the date matches the
  /// recurrence again (e.g. a removed weekday is re-added).
  RECURRENCE_REMOVED
}

// ---------------------------------------------------------------------------
// TrainingSession — canonical generated occurrence of a TrainingSeries.
//
// One row per (trainingSeriesId, date). Represents a single, concrete
// training happening on a specific calendar date, with a resolved start/end
// instant derived from the series' recurrence rule at generation time.
//
// Architecture invariants:
//   - tenantId always comes from a trusted session context (copied from the
//     parent TrainingSeries at generation time — never accepted as input).
//   - Belongs to exactly one TrainingSeries (the canonical source) and,
//     transitively, exactly one TeamSeason (denormalised as teamSeasonId).
//   - `date` is the calendar date of the occurrence, stored at UTC midnight
//     (same convention as Season.startDate/endDate) — it is a date key, not
//     a zoned instant.
//   - `startAt` / `endAt` are the resolved UTC instants for this occurrence,
//     computed from the series' "HH:mm" time-of-day + `timezone` for `date`.
//     They correctly account for DST transitions in the given timezone.
//   - `timezone` is a per-occurrence snapshot of the series' timezone at
//     generation time, so historical sessions remain accurate even if a
//     series' timezone is changed later.
//   - Never duplicated: @@unique([trainingSeriesId, date]) is the sole
//     source of truth for occurrence identity and backs idempotent
//     generation.
//
// Security invariants:
//   - All queries must scope by tenantId.
//   - Tenant A cannot read or modify Tenant B's training sessions.
// ---------------------------------------------------------------------------
model TrainingSession {
  id               String                @id @default(cuid())
  /// Owning tenant. All queries must be scoped by tenantId.
  tenantId         String
  /// The canonical TrainingSeries this occurrence was generated from.
  trainingSeriesId String
  /// Denormalised from TrainingSeries.teamSeasonId for join-free filtering.
  teamSeasonId     String
  /// Calendar date of this occurrence, stored at UTC midnight (date key).
  /// This is the CANONICAL recurrence-slot identity — @@unique([trainingSeriesId, date])
  /// keys off this field, and session-generation-service.ts's reconciliation
  /// diffing depends on it never being mutated by an occurrence-level
  /// exception. A rescheduled occurrence's *effective* date lives in
  /// `overrideDate` instead (see TRAININGCENTER-02 doc comment below).
  date             DateTime
  /// Weekday of `date`, denormalised for display/filtering without recompute.
  weekday          Weekday
  /// Resolved UTC instant the session starts (derived from series startsAt + timezone).
  /// Canonical/regeneration-owned — see `date` doc comment above.
  startAt          DateTime
  /// Resolved UTC instant the session ends (derived from series endsAt + timezone).
  /// Canonical/regeneration-owned — see `date` doc comment above.
  endAt            DateTime
  /// IANA timezone snapshot used to resolve startAt/endAt for this occurrence.
  timezone         String
  /// Lifecycle status. Generation writes SCHEDULED rows and reconciles
  /// RECURRENCE_REMOVED <-> SCHEDULED transitions when the parent series'
  /// recurrence rule changes; it never writes/overwrites CANCELLED,
  /// POSTPONED, or MOVED (see session-generation-service.ts).
  status           TrainingSessionStatus @default(SCHEDULED)
  /// TRAININGCENTER-02 (occurrence exceptions): explicit occurrence-level
  /// override of the calendar date this session actually happens on, set by
  /// session-reschedule-service.ts. Null means "no date override — use
  /// `date`". Never written by generation/reconciliation. Public DTOs
  /// resolve the *effective* date as `overrideDate ?? date` while exposing
  /// the canonical `date` separately as `originalDate`, so downstream
  /// consumers (Month/Week/Day views) bucket the occurrence under the date
  /// it actually happens on without ever mutating the recurrence identity.
  overrideDate     DateTime?
  /// TRAININGCENTER-02: explicit occurrence-level override of the resolved
  /// UTC start instant. Null means "no override — use `startAt`". Set/cleared
  /// together with `overrideEndAt` by session-reschedule-service.ts.
  overrideStartAt  DateTime?
  /// TRAININGCENTER-02: explicit occurrence-level override of the resolved
  /// UTC end instant. Null means "no override — use `endAt`".
  overrideEndAt    DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  tenant             Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  trainingSeries     TrainingSeries              @relation(fields: [trainingSeriesId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  teamSeason         TeamSeason                  @relation(fields: [teamSeasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// TRAININGCENTER-02: occurrence-level resource allocation overrides.
  /// Presence of any row here for a given allocation group (Spielfeld/Halle
  /// or Garderobe — see lib/training/allocation-groups.ts) overrides that
  /// group's series-level TrainingAllocation rows for this occurrence only.
  /// Removing every override row for a group reverts that group back to
  /// the TrainingSeries default. See lib/training/session-allocation-service.ts.
  sessionAllocations TrainingSessionAllocation[]

  /// Canonical rule: one generated session per series per date. Never duplicated.
  @@unique([trainingSeriesId, date])
  @@index([tenantId])
  @@index([trainingSeriesId])
  @@index([teamSeasonId])
  @@index([tenantId, date])
  @@index([teamSeasonId, date])
  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// TrainingSessionAllocation — occurrence-level resource allocation override.
//
// Mirrors TrainingAllocation exactly, but scoped to a single canonical
// TrainingSession occurrence instead of the recurring TrainingSeries. Used
// only when one specific occurrence needs a different Spielfeld/Halle or
// Garderobe than its series' default (e.g. a one-off room conflict) —
// TRAININGCENTER-02.
//
// Architecture invariants:
//   - tenantId must match both TrainingSession.tenantId and FacilityResource.tenantId.
//   - @@unique([trainingSessionId, facilityResourceId]) prevents duplicates.
//   - Archived FacilityResources cannot receive new allocations (same rule
//     as TrainingAllocation).
//   - Cascade-delete when the parent TrainingSession or FacilityResource is deleted.
//   - Never touched by session-generation-service.ts regeneration/reconciliation.
//
// Security invariants:
//   - All queries must scope by tenantId.
//   - Tenant A cannot read or modify Tenant B's session allocation overrides.
// ---------------------------------------------------------------------------
model TrainingSessionAllocation {
  id                 String   @id @default(cuid())
  /// Owning tenant. All queries must be scoped by tenantId.
  tenantId           String
  /// The canonical TrainingSession occurrence this override belongs to.
  trainingSessionId  String
  /// The facility resource allocated to this occurrence.
  facilityResourceId String
  /// Optional free-text note for this override.
  notes              String?
  /// Display position within the override allocations for this occurrence.
  displayOrder       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  trainingSession  TrainingSession  @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  facilityResource FacilityResource @relation(fields: [facilityResourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Prevent duplicate allocation of the same resource to the same occurrence.
  @@unique([trainingSessionId, facilityResourceId])
  @@index([tenantId])
  @@index([trainingSessionId])
  @@index([facilityResourceId])
  @@index([tenantId, trainingSessionId])
}

// =============================================================================
// TOURNAMENTCENTER-01B: Multi-Team Participation + Team Dressing-Room
// Allocations
//
// TOURNAMENTCENTER-01 modelled a Tournament as the canonical Event
// (type=TOURNAMENT) with AT MOST one Team and tournament-level
// pitchCode/homeDressingRoomCode/awayDressingRoomCode string fields —
// sufficient only for a two-side MatchCenter-shaped fixture, not for a
// genuine multi-team tournament (typically 4+ participating teams, often
// mixing tenant-owned Teams and Club-Directory ExternalTeams).
//
// This slice keeps Event(type=TOURNAMENT) as the single canonical
// tournament entity (no new top-level "Tournament" model) and adds exactly
// the three join/allocation tables needed to represent:
//
//   Event (TOURNAMENT) ─┬─< TournamentParticipant >─ Team | ExternalTeam
//                       │         └─< TournamentParticipantAllocation >─ FacilityResource (Garderobe)
//                       └─< TournamentResourceAllocation >─ FacilityResource (Spielfeld/Halle)
//
// Home/away follows the existing MatchCenter convention verbatim: the
// existing Event.homeAway field ("HOME" | "AWAY" | null, null treated as
// HOME — see lib/matchcenter/operational-state.ts) — no new field. Only HOME
// tournaments require FCA pitch/hall + dressing-room allocation; AWAY
// tournaments are NOT_APPLICABLE for all facility-related open actions (see
// lib/tournaments/operational-state.ts).
//
// The legacy Event.pitchCode/homeDressingRoomCode/awayDressingRoomCode
// fields are left untouched (still the canonical allocation model for
// type=MATCH) and are no longer written for new/edited tournaments; a
// one-time additive migration backfills pre-existing TOURNAMENT rows into
// this model (see prisma/migrations/…_tournamentcenter_01b_multi_team_participation).
// =============================================================================

model TournamentParticipant {
  id       String @id @default(cuid())
  /// Owning tenant. All queries must be scoped by tenantId.
  tenantId String
  /// The canonical tournament (Event, type=TOURNAMENT) this participant belongs to.
  eventId  String

  /// Canonical tenant-owned Team participant. Mutually exclusive with
  /// externalTeamId/manualLabel — enforced by the service layer (see
  /// lib/tournaments/participant-service.ts), not a DB constraint, mirroring
  /// the existing MatchExternalMapping home/away-side pattern.
  teamId         String?
  /// Canonical Club-Directory ExternalTeam participant (guest club).
  externalTeamId String?
  /// Smallest clean fallback for a genuinely unknown/free-text participant
  /// when no canonical Team or ExternalTeam exists yet for that club/team.
  /// Only ever set when teamId AND externalTeamId are both null. Tenants are
  /// expected to create a canonical ExternalTeam via the Club Directory as
  /// soon as the participant's identity is known — this field exists only
  /// so tournament creation is never blocked on that step, never as a
  /// second/parallel team identity model.
  manualLabel    String?

  /// Display position within the tournament's participant list.
  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  team         Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  externalTeam ExternalTeam? @relation(fields: [externalTeamId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  dressingRoomAllocations TournamentParticipantAllocation[]

  /// Prevent the same canonical Team from being added twice to the same tournament.
  /// (Postgres unique indexes never compare NULLs as equal, so this is inert
  /// for manual/external-only rows — duplicate ExternalTeam/manual guards
  /// live below / in the service layer respectively.)
  @@unique([eventId, teamId])
  /// Prevent the same canonical ExternalTeam from being added twice to the same tournament.
  @@unique([eventId, externalTeamId])
  @@index([tenantId])
  @@index([eventId])
  @@index([teamId])
  @@index([externalTeamId])
  @@index([tenantId, eventId])
}

model TournamentResourceAllocation {
  id                 String  @id @default(cuid())
  /// Owning tenant. All queries must be scoped by tenantId.
  tenantId           String
  /// The canonical tournament (Event, type=TOURNAMENT) this allocation belongs to.
  eventId            String
  /// The Spielfeld/Halle (or other) facility resource allocated to this tournament.
  facilityResourceId String
  /// Optional free-text note for this allocation.
  notes              String?
  /// Display position within the tournament's resource allocations.
  displayOrder       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  event            Event            @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  facilityResource FacilityResource @relation(fields: [facilityResourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Prevent duplicate allocation of the same resource to the same tournament.
  @@unique([eventId, facilityResourceId])
  @@index([tenantId])
  @@index([eventId])
  @@index([facilityResourceId])
  @@index([tenantId, eventId])
}

model TournamentParticipantAllocation {
  id                      String  @id @default(cuid())
  /// Owning tenant. All queries must be scoped by tenantId.
  tenantId                String
  /// The tournament participant (Team/ExternalTeam/manual entry) this
  /// dressing-room allocation belongs to.
  tournamentParticipantId String
  /// The Garderobe (or other) facility resource allocated to this participant.
  facilityResourceId      String
  /// Optional free-text note for this allocation.
  notes                   String?
  /// Display position within the participant's dressing-room allocations.
  displayOrder            Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tournamentParticipant TournamentParticipant @relation(fields: [tournamentParticipantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  facilityResource      FacilityResource      @relation(fields: [facilityResourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Prevent duplicate allocation of the same resource to the same participant.
  /// Deliberately NOT unique on facilityResourceId alone — multiple
  /// participants (teams) MAY share the same dressing room when facility
  /// rules allow it (see PRODUCT REQUIREMENT: "Multiple teams may share a
  /// dressing room").
  @@unique([tournamentParticipantId, facilityResourceId])
  @@index([tenantId])
  @@index([tournamentParticipantId])
  @@index([facilityResourceId])
  @@index([tenantId, tournamentParticipantId])
}

// =============================================================================
// WEEKPLANNER-01B: Multiple Planning Variants
//
// Adds the smallest safe foundation for MULTIPLE named, tenant-defined
// alternative Weekplanner variants per week (e.g. "Schlechtwetterplan",
// "Winterplan", "Ferienbetrieb") on top of the read-only WEEKPLANNER-01A
// aggregation (see lib/weekplanner/).
//
// CORE DOMAIN RULE — this layer NEVER duplicates a canonical activity:
//   there remains exactly one TrainingSession, one Event(type=MATCH), one
//   Event(type=TOURNAMENT) per real-world occurrence. A WeekplannerPlan
//   only stores SPARSE resource-allocation OVERRIDES for those same
//   canonical activities — never a copy of the activity itself.
//
// "Standardplan" is NOT a WeekplannerPlan row. It is exactly the existing
// canonical allocations already resolved by WEEKPLANNER-01A (TrainingAllocation
// / TrainingSessionAllocation, legacy Event.pitchCode/*DressingRoomCode,
// TournamentResourceAllocation / TournamentParticipantAllocation) — "no
// alternative plan selected" == Standardplan == unchanged 01A behaviour.
// Copying those rows into this table merely to represent the Standardplan
// is deliberately out of scope.
//
// Architecture:
//   Tenant → WeekplannerPlan → WeekplannerPlanAllocation → FacilityResource
//
// WeekplannerPlanAllocation deliberately does NOT hold a DB relation to
// TrainingSession/Event — `activityId` is a plain tenant-validated
// reference (mirrors the existing legacy Event.pitchCode-by-code
// resolution technique already used by lib/weekplanner/queries.ts) so this
// slice never has to modify the TrainingSession/Event models. It DOES hold
// a real relation to FacilityResource — "Use canonical FacilityResource
// references" is an explicit product requirement.
//
// "Override by presence, per allocation group" (same principle already
// used by TrainingSessionAllocation — see lib/training/session-allocation-
// service.ts): a plan has NO override rows for an (activity, group) by
// default, in which case it fully inherits the Standardplan's effective
// allocation for that group. The moment ANY override row exists for that
// (activityId, allocationGroup[, participantId]) combination, it fully
// REPLACES the Standardplan default for that group in that plan only —
// every other plan (including Standardplan) is completely unaffected.
// =============================================================================

enum WeekplannerActivityType {
  TRAINING
  MATCH
  TOURNAMENT
}

/// Deliberately only the two allocation groups the product spec calls out
/// ("at minimum: Spielfeld/Halle, Garderobe") — see
/// lib/training/allocation-groups.ts#TrainingAllocationGroupKey for the
/// (currently TrainingCenter-only) three-way UI split this is a subset of.
enum WeekplannerAllocationGroup {
  PITCH_HALL
  DRESSING_ROOM
}

// ---------------------------------------------------------------------------
// WeekplannerPlan — a tenant-defined, week-scoped, NAMED alternative
// operational resource-allocation plan.
//
// Scope:
//   - tenant scoped (tenantId).
//   - week scoped (weekId — the Monday "YYYY-MM-DD" Europe/Zurich calendar
//     date identifying the week; the same value already used as
//     lib/weekplanner's WeekplannerWindow.param / lib/training/date-
//     range.ts's TrainingWeekWindow.param).
//   - named — tenant-chosen, generic. No plan name or behaviour is ever
//     hardcoded in application code; "Schlechtwetterplan" is merely the
//     product spec's example name.
//
// Lifecycle: ACTIVE -> ARCHIVED (archivedAt set) is a soft delete that
// preserves the plan's overrides for history while hiding it from the plan
// selector. A hard DELETE is only permitted while the plan has zero
// WeekplannerPlanAllocation rows — see lib/weekplanner/plan-service.ts.
//
// Name uniqueness: unique (case-insensitive) among non-archived plans
// within (tenantId, weekId) — enforced via a partial unique index in the
// migration SQL (Prisma cannot express a partial/conditional @@unique
// natively; mirrors the identical TrainingPlan.name technique).
//
// Security invariants:
//   - All queries must scope by tenantId.
//   - Tenant A cannot read or modify Tenant B's plans.
// ---------------------------------------------------------------------------
model WeekplannerPlan {
  id              String    @id @default(cuid())
  tenantId        String
  /// Monday "YYYY-MM-DD" (Europe/Zurich) identifying the scoped week.
  weekId          String
  /// Tenant-chosen, generic plan name (e.g. "Schlechtwetterplan").
  name            String
  /// Best-effort audit trail of who created the plan. Not an authorization input.
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /// Set when archived (soft delete). Null while active.
  archivedAt      DateTime?

  tenant      Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  allocations WeekplannerPlanAllocation[]

  @@index([tenantId])
  @@index([tenantId, weekId])
  @@index([tenantId, weekId, archivedAt])
}

// ---------------------------------------------------------------------------
// WeekplannerPlanAllocation — one SPARSE resource-allocation override row
// within a WeekplannerPlan, for exactly one canonical activity's one
// allocation group.
//
// `activityType` + `activityId` identify the canonical activity being
// overridden (TrainingSession.id for TRAINING; Event.id for MATCH/
// TOURNAMENT — both already tenant-scoped and validated at the service
// layer, never a DB relation — see the module doc comment above).
//
// `participantId` is only meaningful for TOURNAMENT + DRESSING_ROOM
// overrides (one canonical TournamentParticipant's Garderobe override);
// it is the empty string sentinel `""` for every other (activityType,
// allocationGroup) combination. A plain empty-string sentinel (rather than
// SQL NULL) is used deliberately so the uniqueness constraint below behaves
// predictably — Postgres treats every NULL as distinct, which would silently
// allow duplicate non-participant override rows.
//
// Architecture invariants:
//   - tenantId must match the parent WeekplannerPlan's tenantId (enforced
//     at the service layer) and FacilityResource.tenantId.
//   - @@unique(...) prevents a duplicate override for the same activity +
//     group + participant + resource within one plan.
//   - Cascade-delete when the parent WeekplannerPlan is deleted.
//   - Cascade-delete when the parent FacilityResource is deleted.
//
// Security invariants:
//   - All queries must scope by tenantId.
//   - Tenant A cannot read or modify Tenant B's plan allocations.
// ---------------------------------------------------------------------------
model WeekplannerPlanAllocation {
  id                 String                     @id @default(cuid())
  tenantId           String
  weekplannerPlanId  String
  activityType       WeekplannerActivityType
  /// TrainingSession.id (TRAINING) or Event.id (MATCH/TOURNAMENT) — tenant-
  /// validated at the service layer, deliberately not a DB relation.
  activityId         String
  allocationGroup    WeekplannerAllocationGroup
  /// TournamentParticipant.id for TOURNAMENT+DRESSING_ROOM overrides; `""`
  /// (empty-string sentinel) for every other combination — see doc comment.
  participantId      String                     @default("")
  facilityResourceId String
  /// Optional free-text note for this override.
  notes              String?
  /// Display position within this override group.
  displayOrder       Int                        @default(0)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  weekplannerPlan  WeekplannerPlan  @relation(fields: [weekplannerPlanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  facilityResource FacilityResource @relation(fields: [facilityResourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Prevent a duplicate override of the same resource for the same
  /// activity + group + participant within one plan.
  @@unique([weekplannerPlanId, activityType, activityId, allocationGroup, participantId, facilityResourceId])
  @@index([tenantId])
  @@index([weekplannerPlanId])
  @@index([weekplannerPlanId, activityType, activityId])
  @@index([facilityResourceId])
}
